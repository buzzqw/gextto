# Copy to .env and edit. docker compose reads this file automatically when the
# compose file lives in docker-full/.
TZ=Europe/Rome
PUID=1000
PGID=1000

# Clear password for aMule's External Connections (EC). Gextto stores the same
# value under Configuration -> eD2k and Kad -> aMule password; aMule hashes it.
AMULE_EC_PASSWORD=change-me
# Password of aMule's optional web UI (not used by Gextto).
AMULE_WEBUI_PASSWORD=change-me

# Optional explicit version stamp. scripts/docker-full-build.sh fills these
# from version_series + build_number and gx_torrent.version_series +
# gx-torrent.build_number; the defaults are only for a manual compose build.
GEXTTO_SERIES=1.1
GEXTTO_BUILD=0
GX_SERIES=1.1
GX_BUILD=0

# indexarr is built from its own checkout. The path is relative to docker-full/
# (the default is a checkout next to this repository) or absolute.
INDEXARR_SRC=../../indexarr
# Port of the indexarr web UI and Torznab API on the host (host networking).
INDEXARR_PORT=8788
# Optional version stamp; scripts/docker-full-build.sh reads it from git.
INDEXARR_VERSION=dev

# debug, info, warn or error.
GEXTTO_LOG=info
FLARESOLVERR_LOG_LEVEL=info
