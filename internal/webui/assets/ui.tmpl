var lastSearchResults=[];
function searchAge(iso){
  if(!iso)return '';
  var t=Date.parse(iso);if(isNaN(t))return '';
  var s=Math.max(0,(Date.now()-t)/1000);
  if(s<3600)return Math.max(1,Math.round(s/60))+'m';
  if(s<86400)return Math.round(s/3600)+'h';
  return Math.round(s/86400)+'d';
}
function renderSearchResults(){
  var box=$('#searchresults'),info=$('#searchinfo');if(!box)return;
  box.textContent='';
  var sort=($('#search-sort')&&$('#search-sort').value)||'seeders';
  var list=lastSearchResults.slice();
  list.sort(function(a,b){
    if(sort==='size')return (b.size||0)-(a.size||0);
    if(sort==='name')return String(a.title||'').localeCompare(String(b.title||''));
    if(sort==='date')return Date.parse(b.published||0)-Date.parse(a.published||0);
    return (b.seeders||0)-(a.seeders||0);
  });
  info.textContent=list.length?list.length+' '+t('results'):t('No results');
  list.forEach(function(it){
    var row=document.createElement('div');row.className='r';
    var name=document.createElement('span');name.className='t';name.textContent=it.title;name.title=it.title;
    var meta=document.createElement('span');meta.className='m';
    var parts=[fmtBytes(it.size),'S '+it.seeders,'P '+it.leechers];
    var age=searchAge(it.published);if(age)parts.push(age);
    if(it.indexer)parts.push(it.indexer);
    meta.textContent=parts.join(' · ');meta.title=meta.textContent;
    var add=document.createElement('button');add.type='button';add.className='primary sm';add.textContent=t('Add');add.dataset.add=it.magnet||it.link||'';
    var opt=document.createElement('button');opt.type='button';opt.className='ghost sm';opt.textContent=t('Options');opt.title=t('Add with destination, category and tags');opt.dataset.addOptions=it.magnet||it.link||'';
    row.appendChild(name);row.appendChild(meta);row.appendChild(add);row.appendChild(opt);
    box.appendChild(row);
  });
}
function runSearch(){
