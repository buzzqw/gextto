{{end}}{{define "live"}}
  {{if .Rows}}
  <table class="tbl t" id="torrents" role="grid" aria-multiselectable="true" aria-label="Torrents">
    <thead><tr>
      <th class="sel" scope="col"><input type="checkbox" id="selall" aria-label="Select all" title="Select all"></th>
      <th scope="col" class="c-name" data-col="name" data-sort="name" aria-sort="none"><button type="button" class="sort" title="Sort by name">Name<span class="arrow" aria-hidden="true"></span></button></th>
