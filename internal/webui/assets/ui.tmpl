<a class="sr-only" href="#torrent-list">Skip to the torrent list</a>
<header class="topbar">
  <button type="button" class="ghost icon menu-side" id="side-toggle" aria-controls="side" aria-expanded="false" aria-label="Show filters" title="Show filters"><svg class="i"><use href="#i-menu"/></svg></button>
  <a class="brand" href="/" title="gx-torrent"><img src="/favicon.ico" alt=""><span>gx-torrent</span> <small>{{.Version}}</small></a>
  {{if .Standalone}}
  <nav class="nav" aria-label="Sections">
    <a class="on" href="/" aria-current="page" title="Torrents list and transfer status">Torrents</a>
    <a href="/ui/wanted" title="TV shows and movies wanted list">Wanted</a>
    <a href="/ui/rss" title="RSS feeds, indexers and rules">RSS &amp; indexers</a>
    <a href="/ui/archive" title="Everything the feeds found, searchable">Archive</a>
    <a href="/ui/stats" title="Transfer, disk and network statistics">Statistics</a>
    <a href="/ui/settings" title="Daemon configuration and options">Settings</a>
  </nav>
  {{end}}
  <span class="spacer"></span>
  <div class="search" role="search">
    <svg class="i"><use href="#i-search"/></svg>
    <input type="search" id="filter" placeholder="Filter torrents…" autocomplete="off" aria-label="Filter torrents by name" title="Filter displayed torrents by name, category or tag">
    <kbd aria-hidden="true">/</kbd>
  </div>
  <div class="speeds" id="top-speeds" aria-live="off">{{template "speeds" .}}</div>
  <div class="tools">
    <button type="button" class="ghost icon" data-theme-switch data-label-auto="Theme: automatic (follows the system)" data-label-light="Theme: light" data-label-dark="Theme: dark" aria-label="Theme: automatic (follows the system)" title="Switch theme (automatic, light, dark)">
      <svg class="i" data-theme-icon="auto"><use href="#i-auto"/></svg><svg class="i" data-theme-icon="light" hidden><use href="#i-sun"/></svg><svg class="i" data-theme-icon="dark" hidden><use href="#i-moon"/></svg>
    </button>
  </div>
</header>

{{if .Notice}}<div class="notice{{if .Error}} err{{end}}" data-toast>{{.Notice}}</div>{{end}}

<div class="shell">
  <aside class="side" id="side" aria-label="Filters">
    <div id="side-live">{{template "side" .}}</div>
    <section aria-labelledby="h-transfer">
      <h2 id="h-transfer"><button type="button" aria-expanded="true" aria-controls="sec-transfer" data-sec="transfer"><svg class="i"><use href="#i-chev"/></svg><span>Transfer</span></button></h2>
      <div class="graph flist" id="sec-transfer">
        <svg viewBox="0 0 120 40" preserveAspectRatio="none" role="img" aria-label="Download and upload speed over the last two minutes"><path class="da" id="g-da"/><path class="d" id="g-d"/><path class="u" id="g-u"/></svg>
        <div class="legend"><span class="d" id="g-dl">↓ {{.DownloadRate}}</span><span class="u" id="g-ul">↑ {{.UploadRate}}</span></div>
      </div>
    </section>
  </aside>

  <main class="work" id="main">
    <div class="toolbar" role="toolbar" aria-label="Torrent actions" id="toolbar">
      <button type="button" class="primary" id="btn-add" title="Add torrents: magnet links, .torrent URLs or files (shortcut N)"><svg class="i"><use href="#i-plus"/></svg><span class="lbl">Add</span></button>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" class="ghost" data-bulk="resume" title="Resume the selected torrents"><svg class="i"><use href="#i-play"/></svg><span class="lbl">Resume</span></button>
      <button type="button" class="ghost" data-bulk="pause" title="Pause the selected torrents (P)"><svg class="i"><use href="#i-pause"/></svg><span class="lbl">Pause</span></button>
      <button type="button" class="ghost danger" data-bulk="remove-ask" title="Remove the selected torrents (Delete)"><svg class="i"><use href="#i-trash"/></svg><span class="lbl">Remove</span></button>
      <span class="sep hide-m" aria-hidden="true"></span>
      <button type="button" class="ghost icon hide-m" data-bulk="top" aria-label="Move to the top of the queue" title="Move the selected torrents to the top of the queue"><svg class="i"><use href="#i-top"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="up" aria-label="Move up in the queue" title="Move the selected torrents up in the queue"><svg class="i"><use href="#i-up"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="down" aria-label="Move down in the queue" title="Move the selected torrents down in the queue"><svg class="i"><use href="#i-down"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="bottom" aria-label="Move to the bottom of the queue" title="Move the selected torrents to the bottom of the queue"><svg class="i"><use href="#i-bottom"/></svg></button>
      <span class="selinfo" id="selinfo" aria-live="polite"></span>
      <div class="right">
        <button type="button" class="ghost hide-m" id="btn-cols" aria-haspopup="menu" aria-expanded="false" aria-controls="cols-menu" title="Choose the columns of the list (also with a right click on the header)"><svg class="i"><use href="#i-columns"/></svg><span class="lbl">Columns</span></button>
        {{if .SearchEnabled}}<button type="button" class="ghost" id="btn-search" title="Search configured Torznab indexers for releases"><svg class="i"><use href="#i-search"/></svg><span class="lbl">Search indexers</span></button>{{end}}
        {{if or .Standalone .GexttoLog}}<button type="button" class="ghost" id="btn-log" aria-pressed="false" data-log-url="{{if .Standalone}}/ui/log{{else}}/ui/gextto-log{{end}}" title="Switch to live server log view"><svg class="i"><use href="#i-log"/></svg><span class="lbl">{{if .Standalone}}Log{{else if .GexttoLog}}Gextto log{{end}}</span></button>{{end}}
        <button type="button" class="ghost" id="btn-tools" aria-haspopup="menu" aria-expanded="false" aria-controls="tools-menu" title="IP filter, create a .torrent, feeds"><svg class="i"><use href="#i-tools"/></svg><span class="lbl">Tools</span></button>
      </div>
    </div>

    <div class="torrentpane" id="pane-torrents">
      <div class="listwrap" id="torrent-list" tabindex="-1">
        <div id="live">{{template "live" .}}</div>
      </div>
      <aside class="drawer" id="drawer" hidden aria-labelledby="drawer-title">
        <div class="dsplit" id="dsplit" role="separator" aria-orientation="horizontal" aria-valuemin="120" aria-valuemax="800" aria-valuenow="320" tabindex="0" aria-label="Resize the details panel" title="Drag, or use the up and down arrows, to resize the details panel"></div>
        <div id="drawer-body"></div>
      </aside>
    </div>
    {{if or .Standalone .GexttoLog}}
    <div id="pane-log" class="logpane" hidden>
      <div class="logbar">
        <label class="chk">Lines <select id="log-lines" title="Number of recent log lines to display"><option>200</option><option selected>500</option><option>1000</option><option>2000</option></select></label>
        <input type="search" id="log-filter" placeholder="Filter lines…" autocomplete="off" aria-label="Filter lines…" title="Filter log lines by keyword or severity level">
        <label class="chk"><input type="checkbox" id="log-nodebug" checked title="Hide low-level debug messages and show only informational and warning logs"> hide DEBUG</label>
        <button type="button" class="sm" id="log-reload" title="Reload latest logs from server">Reload</button>
        <span class="muted" id="log-info"></span>
      </div>
      <pre class="logview" id="log-view" tabindex="0" role="region" aria-label="Log">Loading…</pre>
    </div>
    {{end}}

    <footer class="statusbar" id="statusbar">{{template "status" .}}</footer>
  </main>
</div>
<div class="sbmore" id="sb-more" role="region" aria-labelledby="sb-more-title" hidden>{{template "sbmore" .}}</div>

<div class="menu" id="row-menu" role="menu" aria-label="Torrent actions" hidden>
  <button type="button" role="menuitem" data-act="details" title="Details: files, peers, trackers"><svg class="i"><use href="#i-info"/></svg>Details<kbd>Enter</kbd></button>
  <hr>
  <button type="button" role="menuitem" data-act="resume" title="Resume the selected torrents"><svg class="i"><use href="#i-play"/></svg>Resume</button>
  <button type="button" role="menuitem" data-act="pause" title="Pause the selected torrents"><svg class="i"><use href="#i-pause"/></svg>Pause</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="force" title="Force start: run now, outside the queue limits"><svg class="i"><use href="#i-bolt"/></svg>Force start</button>
  <hr>
  <button type="button" role="menuitem" class="danger" data-act="remove" title="Remove from the session (you choose whether the files stay)"><svg class="i"><use href="#i-trash"/></svg>Remove…<kbd>Del</kbd></button>
  <hr>
  <button type="button" role="menuitem" data-act="location" title="Move the downloaded data to another folder"><svg class="i"><use href="#i-move"/></svg>Set location…</button>
  {{if .Standalone}}<button type="button" role="menuitem" data-act="rename" title="Rename this torrent's name and content folder"><svg class="i"><use href="#i-edit"/></svg>Rename…</button>
  <button type="button" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub="#cat-menu" title="Assign a category to the selected torrents"><svg class="i"><use href="#i-folder"/></svg>Category</button>
  <button type="button" role="menuitem" data-act="category" title="Category assigned to this torrent for organization and filtering"><svg class="i"><use href="#i-tag"/></svg>Category and tags…</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="tmm" title="Let the category decide the save path: assigning a category moves the torrent to its folder (qBittorrent automatic torrent management)"><svg class="i"><use href="#i-folder"/></svg>Automatic management</button>{{end}}
  <hr>
  <button type="button" role="menuitem" data-act="limits" title="Download and upload speed limits of the selected torrents"><svg class="i"><use href="#i-gauge"/></svg>Limit speed…</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="superseed" title="BEP 16 super-seeding: advertise one piece at a time so the swarm spreads the data. For initial seeding only; it reduces the seed's upload throughput"><svg class="i"><use href="#i-seed"/></svg>Super-seeding</button>
  <hr>
  <button type="button" role="menuitem" data-act="verify" title="Recheck data on disk"><svg class="i"><use href="#i-check"/></svg>Force recheck</button>
  <button type="button" role="menuitem" data-act="reannounce" title="Reannounce to trackers"><svg class="i"><use href="#i-signal"/></svg>Force reannounce</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="sequential" title="Download pieces in order (streaming); slower overall"><svg class="i"><use href="#i-list"/></svg>Sequential download</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="firstlast" title="Download the ends of every file first"><svg class="i"><use href="#i-list"/></svg>First and last pieces first</button>
  <button type="button" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub="#queue-menu" title="Position of the selected torrents in the download queue"><svg class="i"><use href="#i-top"/></svg>Queue</button>
  <hr>
  <button type="button" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub="#copy-menu" title="Copy the name, the info hash or the magnet link"><svg class="i"><use href="#i-copy"/></svg>Copy</button>
  <button type="button" role="menuitem" data-act="export" title="Export and download the .torrent metainfo file"><svg class="i"><use href="#i-file"/></svg>Export .torrent</button>
</div>

<div class="menu" id="queue-menu" role="menu" aria-label="Queue" hidden>
  <button type="button" role="menuitem" data-act="top" title="Move to the top of the queue"><svg class="i"><use href="#i-top"/></svg>Move to top</button>
  <button type="button" role="menuitem" data-act="up" title="Move up in the queue"><svg class="i"><use href="#i-up"/></svg>Move up</button>
  <button type="button" role="menuitem" data-act="down" title="Move down in the queue"><svg class="i"><use href="#i-down"/></svg>Move down</button>
  <button type="button" role="menuitem" data-act="bottom" title="Move to the bottom of the queue"><svg class="i"><use href="#i-bottom"/></svg>Move to bottom</button>
</div>

<div class="menu" id="copy-menu" role="menu" aria-label="Copy" hidden>
  <button type="button" role="menuitem" data-act="copy-name" title="Copy the names of the selected torrents"><svg class="i"><use href="#i-copy"/></svg>Name</button>
  <button type="button" role="menuitem" data-act="copy-hash" title="Copy the info hashes of the selected torrents"><svg class="i"><use href="#i-copy"/></svg>Info hash</button>
  <button type="button" role="menuitem" data-act="magnet" title="Copy magnet URI with info hash and trackers to clipboard"><svg class="i"><use href="#i-copy"/></svg>Magnet link</button>
</div>

{{if .Standalone}}
<div class="menu" id="cat-menu" role="menu" aria-label="Category" hidden>
  <button type="button" role="menuitemradio" aria-checked="false" data-setcat="" title="Remove the category from the selected torrents"><svg class="i"><use href="#i-x"/></svg>No category</button>
  <div id="cat-menu-list"></div>
  <hr>
  <button type="button" role="menuitem" data-act="category" title="Type a new category, or edit the tags"><svg class="i"><use href="#i-plus"/></svg>New category…</button>
</div>
{{end}}

<div class="menu cols" id="cols-menu" role="menu" aria-label="Columns" hidden>
  <div class="mhead" aria-hidden="true">Columns</div>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="size" title="Show or hide this column">Size</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="progress" title="Show or hide this column">Progress</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="state" title="Show or hide this column">Status</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="seeds" title="Show or hide this column">Seeds</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="peers" title="Show or hide this column">Peers</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="down" title="Show or hide this column">Down speed</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="up" title="Show or hide this column">Up speed</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="eta" title="Show or hide this column">ETA</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="ratio" title="Show or hide this column">Ratio</button>
  <button type="button" role="menuitemcheckbox" aria-checked="true" data-col="category" title="Show or hide this column">Category</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="tags" title="Show or hide this column">Tags</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="added" title="Show or hide this column">Added on</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="completed" title="Show or hide this column">Completed on</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="downloaded" title="Show or hide this column">Downloaded</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="uploaded" title="Show or hide this column">Uploaded</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="remaining" title="Show or hide this column">Remaining</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="queue" title="Show or hide this column">Queue position</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="tracker" title="Show or hide this column">Tracker</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-col="path" title="Show or hide this column">Save path</button>
  <hr>
  <button type="button" role="menuitem" data-col-reset title="Show the default columns with their default widths">Reset columns</button>
</div>

<div class="menu" id="tools-menu" role="menu" aria-label="Tools" hidden>
  <button type="button" role="menuitem" data-tool="ipfilter" title="IP filter blocklist file path or URL (eMule, DAT, P2P or CIDR format)"><svg class="i"><use href="#i-xc"/></svg>IP filter…</button>
  <button type="button" role="menuitem" data-tool="create" title="Create .torrent file from the specified path and start seeding"><svg class="i"><use href="#i-file"/></svg>Create .torrent…</button>
  {{if .FeedsEnabled}}<button type="button" role="menuitem" data-tool="feeds" title="Fetch new items from configured RSS feeds now"><svg class="i"><use href="#i-rss"/></svg>Check feeds</button>{{end}}
  <button type="button" role="menuitem" data-tool="ports" title="Check that the peer port is listening and forwarded by the router"><svg class="i"><use href="#i-signal"/></svg>Test ports</button>
</div>

<div hidden data-update-notes-slot></div>
<dialog id="dlg-add" aria-labelledby="dlg-add-title">
  <form method="post" action="/ui/add" enctype="multipart/form-data" id="form-add">
    <div class="dlg-head"><h2 id="dlg-add-title">Add torrents</h2><button type="button" class="ghost icon" data-close aria-label="Close" title="Close"><svg class="i"><use href="#i-x"/></svg></button></div>
    <div class="dlg-body">
      <label class="field">Magnet links or .torrent URLs, one per line
        <textarea name="source" rows="3" placeholder="magnet:?xt=…" autocomplete="off" title="Magnet link (magnet:?) or HTTP URL of a .torrent file to download"></textarea>
      </label>
      <div class="filepick" id="filepick">
        <span id="filepick-text">Drop .torrent files anywhere on the page, or</span>
        <input type="file" name="torrent" id="add-files" multiple accept=".torrent,application/x-bittorrent" aria-label="Choose .torrent files" title="Select a local .torrent file to upload and start downloading">
      </div>
      <label class="field">Save to
        <span class="field-row"><input type="text" id="add-destination" name="destination" list="savepaths" placeholder="destination (empty = default)" autocomplete="off" title="Destination directory for download files (empty uses default download folder)">{{if .Standalone}}<button type="button" class="browse" data-target="add-destination" title="Choose an existing folder on the server">Browse…</button>{{end}}</span>
      </label>
      {{if .Standalone}}
      <label class="field">Category
        <input type="text" name="category" list="catlist-all" autocomplete="off" title="Category assigned to the added torrents for organization and filtering">
      </label>
      {{end}}
      {{template "addopts"}}
    </div>
    <div class="dlg-foot">
      <button type="button" data-close title="Close without adding">Cancel</button>
      <button type="submit" class="primary" title="Add this torrent to the download queue">Add</button>
    </div>
  </form>
</dialog>

<dialog id="dlg-remove" aria-labelledby="dlg-remove-title">
  <form method="post" action="/ui/remove" id="form-remove">
    <div class="dlg-head"><h2 id="dlg-remove-title">Remove torrents</h2></div>
    <div class="dlg-body">
      <p id="remove-what" style="margin:0"></p>
      <label class="chk"><input type="checkbox" name="delete_files" value="1" id="remove-files" title="Also permanently delete the downloaded files from disk"> Also delete the files from disk</label>
