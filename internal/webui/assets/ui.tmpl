<a class="sr-only" href="#torrent-list">{{tr "Skip to the torrent list"}}</a>
<header class="topbar">
  <button type="button" class="ghost icon menu-side" id="side-toggle" aria-controls="side" aria-expanded="false" aria-label="{{tr "Show filters"}}" title="{{tr "Show filters"}}"><svg class="i"><use href="#i-menu"/></svg></button>
  <a class="brand" href="/" title="gx-torrent"><img src="/favicon.ico" alt=""><span>gx-torrent</span> <small>{{.Version}}</small></a>
  {{if .Standalone}}
  <nav class="nav" aria-label="{{tr "Sections"}}">
    <a class="on" href="/" aria-current="page" title="{{tr "Torrents list and transfer status"}}">{{tr "Torrents"}}</a>
    <a href="/ui/wanted" title="{{tr "TV series and movies you follow"}}">{{tr "Series & movies"}}</a>
    <a href="/ui/rss" title="{{tr "RSS feeds, indexers and rules"}}">{{tr "RSS & indexers"}}</a>
    <a href="/ui/archive" title="{{tr "Everything the feeds found, searchable"}}">{{tr "Archive"}}</a>
    <a href="/ui/stats" title="{{tr "Transfer, disk and network statistics"}}">{{tr "Statistics"}}</a>
    <a href="/ui/settings" title="{{tr "Daemon configuration and options"}}">{{tr "Settings"}}</a>
    <div class="navmenu">
      <button type="button" id="nav-more" aria-haspopup="menu" aria-expanded="false" aria-controls="nav-menu" title="{{tr "Log, tools and indexer search"}}">{{tr "More"}} <span class="caret" aria-hidden="true">▾</span></button>
      <div class="menu" id="nav-menu" role="menu" aria-label="{{tr "More"}}" hidden>
        <button type="button" role="menuitem" data-navshow="log" title="{{tr "Switch to live server log view"}}"><svg class="i"><use href="#i-log"/></svg>{{tr "Log"}}</button>
        <button type="button" role="menuitem" data-navshow="tools" title="{{tr "IP filter, create a .torrent, feeds"}}"><svg class="i"><use href="#i-tools"/></svg>{{tr "Tools"}}</button>
        <button type="button" role="menuitem" data-navshow="search" title="{{tr "Search configured Torznab indexers for releases"}}"><svg class="i"><use href="#i-search"/></svg>{{tr "Search indexers"}}</button>
      </div>
    </div>
  </nav>
  {{end}}
  <span class="spacer"></span>
  <div class="search" role="search">
    <svg class="i"><use href="#i-search"/></svg>
    <input type="search" id="filter" placeholder="{{tr "Filter torrents…"}}" autocomplete="off" aria-label="{{tr "Filter torrents by name, hash, tracker, category or tag"}}" title="{{tr "Filter displayed torrents by name, info hash, tracker, category or tag"}}">
    <kbd aria-hidden="true">/</kbd>
  </div>
  <div class="speeds" id="top-speeds" aria-live="off">{{template "speeds" .}}</div>
  <div class="tools">
    <button type="button" class="ghost icon" data-theme-switch data-label-auto="{{tr "Theme: automatic (follows the system)"}}" data-label-light="{{tr "Theme: light"}}" data-label-dark="{{tr "Theme: dark"}}" aria-label="{{tr "Theme: automatic (follows the system)"}}" title="{{tr "Switch theme (automatic, light, dark)"}}">
      <svg class="i" data-theme-icon="auto"><use href="#i-auto"/></svg><svg class="i" data-theme-icon="light" hidden><use href="#i-sun"/></svg><svg class="i" data-theme-icon="dark" hidden><use href="#i-moon"/></svg>
    </button>
    {{if .LoginEnabled}}<form method="post" action="/ui/logout" class="logout-form"><button type="submit" class="ghost icon" aria-label="{{tr "Sign out"}}" title="{{tr "Sign out of the web interface"}}"><svg class="i"><use href="#i-exit"/></svg></button></form>{{end}}
  </div>
</header>

{{if .Notice}}<div class="notice{{if .Error}} err{{end}}" data-toast>{{.Notice}}</div>{{end}}

<div class="shell">
  <aside class="side" id="side" aria-label="{{tr "Filters"}}">
    <div class="side-scroll">
      <div id="side-live">{{template "side" .}}</div>
      <section aria-labelledby="h-transfer">
        <h2 id="h-transfer"><button type="button" aria-expanded="true" aria-controls="sec-transfer" data-sec="transfer"><svg class="i"><use href="#i-chev"/></svg><span>{{tr "Transfer"}}</span></button></h2>
        <div class="graph flist" id="sec-transfer">
          <svg viewBox="0 0 120 40" preserveAspectRatio="none" role="img" aria-label="{{tr "Download and upload speed over the last two minutes"}}"><path class="da" id="g-da"/><path class="d" id="g-d"/><path class="u" id="g-u"/></svg>
          <div class="legend"><span class="d" id="g-dl">↓ {{.DownloadRate}}</span><span class="u" id="g-ul">↑ {{.UploadRate}}</span></div>
        </div>
      </section>
    </div>
    {{if .Standalone}}
    <section class="langpick" aria-labelledby="h-lang">
      <h2 id="h-lang"><svg class="i" aria-hidden="true"><use href="#i-globe"/></svg><span>{{tr "Language"}}</span></h2>
      <form method="post" action="/ui/lang">
        <select name="lang" aria-label="{{tr "Language"}}" title="{{tr "Web interface language"}}" onchange="this.form.requestSubmit()">{{range .LangOptions}}<option value="{{.Code}}"{{if .Selected}} selected{{end}}>{{.Name}}</option>{{end}}</select>
        <button type="submit" class="sm" title="{{tr "Apply the language"}}">{{tr "Apply"}}</button>
      </form>
    </section>
    {{end}}
  </aside>

  <main class="work" id="main">
    <div class="toolbar" role="toolbar" aria-label="{{tr "Torrent actions"}}" id="toolbar">
      <button type="button" class="primary" id="btn-add" title="{{tr "Add torrents: magnet links, .torrent URLs or files (shortcut N)"}}"><svg class="i"><use href="#i-plus"/></svg><span class="lbl">{{tr "Add"}}</span></button>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" class="ghost" id="btn-resume-all" title="{{tr "Resume every torrent in the session"}}"><svg class="i"><use href="#i-play"/></svg><span class="lbl">{{tr "Resume all"}}</span></button>
      <button type="button" class="ghost" id="btn-pause-all" title="{{tr "Pause every torrent in the session"}}"><svg class="i"><use href="#i-pause"/></svg><span class="lbl">{{tr "Pause all"}}</span></button>
      <span class="sep" aria-hidden="true"></span>
      <!-- Without their label the two "selected" buttons look exactly like
           "Resume all" and "Pause all": on a phone only the all ones stay, the
           per-torrent actions are in the row menu. -->
      <button type="button" class="ghost hide-m" data-bulk="resume" title="{{tr "Start the selected torrents (Resume; qBittorrent Start)"}}"><svg class="i"><use href="#i-play"/></svg><span class="lbl">{{tr "Resume"}}</span></button>
      <button type="button" class="ghost hide-m" data-bulk="pause" title="{{tr "Stop the selected torrents (Pause; qBittorrent Stop) (P)"}}"><svg class="i"><use href="#i-pause"/></svg><span class="lbl">{{tr "Pause"}}</span></button>
      <button type="button" class="ghost hide-m" data-bulk="force-start" aria-label="{{tr "Force start the selected torrents"}}" title="{{tr "Force start: run now, outside the queue limits"}}"><svg class="i"><use href="#i-bolt"/></svg></button>
      <button type="button" class="ghost danger" data-bulk="remove-ask" title="{{tr "Remove the selected torrents (Delete)"}}"><svg class="i"><use href="#i-trash"/></svg><span class="lbl">{{tr "Remove"}}</span></button>
      <span class="sep hide-m" aria-hidden="true"></span>
      <button type="button" class="ghost icon hide-m" data-bulk="top" aria-label="{{tr "Move to the top of the queue"}}" title="{{tr "Move the selected torrents to the top of the queue"}}"><svg class="i"><use href="#i-top"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="up" aria-label="{{tr "Move up in the queue"}}" title="{{tr "Move the selected torrents up in the queue"}}"><svg class="i"><use href="#i-up"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="down" aria-label="{{tr "Move down in the queue"}}" title="{{tr "Move the selected torrents down in the queue"}}"><svg class="i"><use href="#i-down"/></svg></button>
      <button type="button" class="ghost icon hide-m" data-bulk="bottom" aria-label="{{tr "Move to the bottom of the queue"}}" title="{{tr "Move the selected torrents to the bottom of the queue"}}"><svg class="i"><use href="#i-bottom"/></svg></button>
      <span class="selinfo" id="selinfo" aria-live="polite"></span>
      <div class="right">
        <button type="button" class="ghost hide-m" id="btn-cols" aria-haspopup="menu" aria-expanded="false" aria-controls="cols-menu" title="{{tr "Choose the columns of the list (also with a right click on the header)"}}"><svg class="i"><use href="#i-columns"/></svg><span class="lbl">{{tr "Columns"}}</span></button>
        {{if .SearchEnabled}}<button type="button" class="ghost" id="btn-search" title="{{tr "Search configured Torznab indexers for releases"}}"><svg class="i"><use href="#i-search"/></svg><span class="lbl">{{tr "Search indexers"}}</span></button>{{end}}
        {{if or .Standalone .GexttoLog}}<button type="button" class="ghost" id="btn-log" aria-pressed="false" data-log-url="{{if .Standalone}}/ui/log{{else}}/ui/gextto-log{{end}}" title="{{tr "Switch to live server log view"}}"><svg class="i"><use href="#i-log"/></svg><span class="lbl">{{if .Standalone}}{{tr "Log"}}{{else if .GexttoLog}}{{tr "Gextto log"}}{{end}}</span></button>{{end}}
        <button type="button" class="ghost" id="btn-tools" aria-haspopup="menu" aria-expanded="false" aria-controls="tools-menu" title="{{tr "IP filter, create a .torrent, feeds"}}"><svg class="i"><use href="#i-tools"/></svg><span class="lbl">{{tr "Tools"}}</span></button>
      </div>
    </div>

    <div class="torrentpane" id="pane-torrents">
      <div class="listwrap" id="torrent-list" tabindex="-1">
        <div id="live">{{template "live" .}}</div>
      </div>
      <aside class="drawer" id="drawer" hidden aria-labelledby="drawer-title">
        <div class="dsplit" id="dsplit" role="separator" aria-orientation="horizontal" aria-valuemin="120" aria-valuemax="800" aria-valuenow="320" tabindex="0" aria-label="{{tr "Resize the details panel"}}" title="{{tr "Drag, or use the up and down arrows, to resize the details panel"}}"></div>
        <div id="drawer-body"></div>
      </aside>
    </div>
    {{if or .Standalone .GexttoLog}}
    <div id="pane-log" class="logpane" hidden>
      <div class="logbar">
        <label class="chk">{{tr "Lines"}} <select id="log-lines" title="{{tr "Number of recent log lines to display"}}"><option>200</option><option selected>500</option><option>1000</option><option>2000</option></select></label>
        <input type="search" id="log-filter" placeholder="{{tr "Filter lines…"}}" autocomplete="off" aria-label="{{tr "Filter lines…"}}" title="{{tr "Filter log lines by keyword or severity level"}}">
        <span class="lvl" role="group" aria-label="{{tr "Log levels"}}" title="{{tr "Show only the selected severity levels"}}">
          <label class="chk"><input type="checkbox" id="log-debug" title="{{tr "Show low-level debug messages"}}"> {{tr "DEBUG"}}</label>
          <label class="chk"><input type="checkbox" id="log-info" checked title="{{tr "Show informational messages"}}"> {{tr "INFO"}}</label>
          <label class="chk"><input type="checkbox" id="log-warn" checked title="{{tr "Show warnings"}}"> {{tr "WARN"}}</label>
          <label class="chk"><input type="checkbox" id="log-error" checked title="{{tr "Show errors"}}"> {{tr "ERROR"}}</label>
        </span>
        <button type="button" class="sm" id="log-reload" title="{{tr "Reload latest logs from server"}}">{{tr "Reload"}}</button>
        <span class="muted" id="log-info"></span>
      </div>
      <pre class="logview" id="log-view" tabindex="0" role="region" aria-label="{{tr "Log"}}">{{tr "Loading…"}}</pre>
    </div>
    {{end}}

    <footer class="statusbar" id="statusbar">{{template "status" .}}</footer>
  </main>
</div>
<div class="sbmore" id="sb-more" role="region" aria-labelledby="sb-more-title" hidden>{{template "sbmore" .}}</div>
<div class="undobar" id="undo-bar" hidden><span id="undo-text" role="status"></span><button type="button" class="sm primary" id="undo-btn" title="{{tr "Bring the removed torrents back (their files stayed on disk)"}}">{{tr "Undo"}}</button></div>

<div class="menu" id="row-menu" role="menu" aria-label="{{tr "Torrent actions"}}" hidden>
  <button type="button" role="menuitem" data-act="details" title="{{tr "Details: files, peers, trackers"}}"><svg class="i"><use href="#i-info"/></svg>{{tr "Details"}}<kbd>{{tr "Enter"}}</kbd></button>
  <hr>
  <button type="button" role="menuitem" data-act="resume" title="{{tr "Resume the selected torrents"}}"><svg class="i"><use href="#i-play"/></svg>{{tr "Resume"}}</button>
  <button type="button" role="menuitem" data-act="pause" title="{{tr "Pause the selected torrents"}}"><svg class="i"><use href="#i-pause"/></svg>{{tr "Pause"}}</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="force" title="{{tr "Force start: run now, outside the queue limits"}}"><svg class="i"><use href="#i-bolt"/></svg>{{tr "Force start"}}</button>
  <hr>
  <button type="button" role="menuitem" class="danger" data-act="remove" title="{{tr "Remove from the session (you choose whether the files stay)"}}"><svg class="i"><use href="#i-trash"/></svg>{{tr "Remove…"}}<kbd>{{tr "Del"}}</kbd></button>
  <hr>
  <button type="button" role="menuitem" data-act="location" title="{{tr "Move the downloaded data to another folder"}}"><svg class="i"><use href="#i-move"/></svg>{{tr "Set location…"}}</button>
  {{if .Standalone}}<button type="button" role="menuitem" data-act="rename" title="{{tr "Rename this torrent's name and content folder"}}"><svg class="i"><use href="#i-edit"/></svg>{{tr "Rename…"}}</button>
  <button type="button" role="menuitem" aria-haspopup="menu" aria-expanded="false" data-sub="#cat-menu" title="{{tr "Assign a category to the selected torrents"}}"><svg class="i"><use href="#i-folder"/></svg>{{tr "Category"}}</button>
  <button type="button" role="menuitem" data-act="category" title="{{tr "Category assigned to this torrent for organization and filtering"}}"><svg class="i"><use href="#i-tag"/></svg>{{tr "Category and tags…"}}</button>
  <button type="button" role="menuitemcheckbox" aria-checked="false" data-act="tmm" title="{{tr "Let the category decide the save path: assigning a category moves the torrent to its folder (qBittorrent automatic torrent management)"}}"><svg class="i"><use href="#i-folder"/></svg>{{tr "Automatic management"}}</button>{{end}}
  <hr>
  <button type="button" role="menuitem" data-act="limits" title="{{tr "Download and upload speed limits of the selected torrents"}}"><svg class="i"><use href="#i-gauge"/></svg>{{tr "Limit speed…"}}</button>
