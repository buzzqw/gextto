<script id="ui-i18n"></script>
<script src="/assets/common.js"></script>
<script>
(function(){
"use strict";
function t(s){return (window.__uiI18n&&window.__uiI18n[s])||s;}
var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
var toast=function(m,e){window.gx.toast(m,e);};
var store={get:function(k,d){try{var v=localStorage.getItem('gx-'+k);return v===null?d:JSON.parse(v);}catch(e){return d;}},set:function(k,v){try{localStorage.setItem('gx-'+k,JSON.stringify(v));}catch(e){}}};

var state={selected:new Set(),anchor:null,filter:store.get('filter',{status:'all',cat:null,tag:null,tracker:null}),sort:store.get('sort',{key:'name',asc:true}),q:'',drawer:null,rows:window.__rows||0,collapsed:store.get('collapsed',{}),sbmore:false};
if(state.filter.tracker===undefined)state.filter.tracker=null;

// ---------- server calls ----------
function post(url,params){
  var body=params instanceof URLSearchParams?params:new URLSearchParams(params||{});
  return fetch(url,{method:'POST',body:body,headers:{'Content-Type':'application/x-www-form-urlencoded','X-GX-Fetch':'1'}})
    .then(function(r){var ct=r.headers.get('Content-Type')||'';if(ct.indexOf('application/json')>=0)return r.json();return r.text().then(function(x){return {ok:r.ok,msg:x.trim()||(r.ok?t('Done'):t('Error'))};});})
    .catch(function(e){return {ok:false,msg:t('Error')+': '+e.message};});
}
function report(res){if(res&&res.msg)toast(res.msg,!res.ok);}

// ---------- rows, selection, filters ----------
function rows(){return $$('#torrents tbody tr');}
function visibleRows(){return rows().filter(function(r){return !r.hidden;});}
function rowOf(el){return el&&el.closest?el.closest('#torrents tbody tr'):null;}
function rowByHash(h){return rows().find(function(r){return r.dataset.hash===h;});}
function selHashes(){return Array.from(state.selected);}
function renderSelection(){
  rows().forEach(function(r){var on=state.selected.has(r.dataset.hash);r.setAttribute('aria-selected',on?'true':'false');var cb=$('.rowsel',r);if(cb)cb.checked=on;});
  var n=state.selected.size;
  $('#selinfo').textContent=n?n+' '+t('selected'):'';
  $$('#toolbar [data-bulk]').forEach(function(b){b.setAttribute('aria-disabled',n?'false':'true');});
  var all=$('#selall');if(all){var vis=visibleRows();all.checked=vis.length>0&&vis.every(function(r){return state.selected.has(r.dataset.hash);});all.indeterminate=n>0&&!all.checked;}
}
function select(hash,mode){
  if(mode==='toggle'){if(state.selected.has(hash))state.selected.delete(hash);else state.selected.add(hash);}
  else if(mode==='range'&&state.anchor){var v=visibleRows().map(function(r){return r.dataset.hash;});var a=v.indexOf(state.anchor),b=v.indexOf(hash);if(a>=0&&b>=0){var lo=Math.min(a,b),hi=Math.max(a,b);for(var i=lo;i<=hi;i++)state.selected.add(v[i]);}}
  else{state.selected.clear();state.selected.add(hash);}
  if(mode!=='range')state.anchor=hash;
  renderSelection();
}
// matchStatus is the page side of the sidebar counts (uiPageData).
function matchStatus(r,f){
  var st=r.dataset.state,moving=(+r.dataset.down>0)||(+r.dataset.up>0);
  switch(f){
    case 'all':return true;
    case 'downloading':return st==='downloading'||st==='downloading_metadata'||st==='checking_files';
    case 'completed':return +r.dataset.kProgress>=100;
    case 'running':return st!=='paused'&&st!=='disk_wait';
    case 'active':return moving;
    case 'inactive':return !moving;
    case 'paused':return st==='paused'||st==='disk_wait';
    case 'checking':return st==='checking_files';
    default:return st===f;
  }
}
function applyFilters(){
  var q=state.q.toLowerCase(),f=state.filter,shown=0;
  rows().forEach(function(r){
    var ok=matchStatus(r,f.status)&&(f.cat===null||r.dataset.cat===f.cat)
      &&(f.tag===null||(f.tag===''?!r.dataset.tags:(','+r.dataset.tags.replace(/,\s+/g,',')+',').indexOf(','+f.tag+',')>=0))
      &&(f.tracker===null||r.dataset.tracker===f.tracker)
      &&(!q||(r.dataset.name+' '+r.dataset.cat+' '+r.dataset.tags).toLowerCase().indexOf(q)>=0);
    r.hidden=!ok;if(ok)shown++;
  });
  function press(sel,attr,val){$$(sel).forEach(function(b){var v=b.hasAttribute('data-all')?null:b.getAttribute(attr);b.setAttribute('aria-pressed',v===val?'true':'false');});}
  press('#side [data-status]','data-status',f.status);
  press('#side [data-catbtn]','data-cat',f.cat);
  press('#side [data-tagbtn]','data-tag',f.tag);
  press('#side [data-trkbtn]','data-tracker',f.tracker);
  var empty=$('#filtered-empty');if(empty)empty.hidden=shown>0||rows().length===0;
  // Selection follows what is visible.
  state.selected.forEach(function(h){var r=rowByHash(h);if(!r||r.hidden)state.selected.delete(h);});
  renderSelection();
}
function countSide(){
  // Category and tag counts are computed here, from the rows.
  var cats={},tags={},untagged=0;
  rows().forEach(function(r){cats[r.dataset.cat]=(cats[r.dataset.cat]||0)+1;var any=false;(r.dataset.tags||'').split(',').forEach(function(tg){tg=tg.trim();if(tg){any=true;tags[tg]=(tags[tg]||0)+1;}});if(!any)untagged++;});
  $$('#side [data-catbtn]:not([data-all])').forEach(function(b){var n=$('.n',b);if(n)n.textContent=cats[b.dataset.cat]||0;});
  $$('#side [data-tagbtn]:not([data-all])').forEach(function(b){var n=$('.n',b);if(n)n.textContent=b.dataset.tag===''?untagged:(tags[b.dataset.tag]||0);});
  $$('#side .flist button .n').forEach(function(n){n.parentNode.classList.toggle('zero',n.textContent==='0');});
}
function applyCollapsed(){
  $$('#side [data-sec]').forEach(function(b){var shut=!!state.collapsed[b.dataset.sec];b.setAttribute('aria-expanded',shut?'false':'true');var list=document.getElementById(b.getAttribute('aria-controls'));if(list)list.hidden=shut;});
}
function applySort(){
  var s=state.sort,tb=$('#torrents tbody');if(!tb)return;
  var list=rows(),key='k'+s.key.charAt(0).toUpperCase()+s.key.slice(1);
  list.sort(function(a,b){var av=a.dataset[key]||'',bv=b.dataset[key]||'';var an=parseFloat(av),bn=parseFloat(bv);var r=(!isNaN(an)&&!isNaN(bn)&&av!==''&&bv!=='')?an-bn:String(av).localeCompare(String(bv),undefined,{sensitivity:'base',numeric:true});return s.asc?r:-r;});
  list.forEach(function(r){tb.appendChild(r);});
  $$('#torrents th[data-sort]').forEach(function(th){th.setAttribute('aria-sort',th.dataset.sort===s.key?(s.asc?'ascending':'descending'):'none');});
}
function setSort(key){var s=state.sort;state.sort={key:key,asc:s.key===key?!s.asc:true};store.set('sort',state.sort);applySort();}

// ---------- columns: chooser and widths ----------
function colPrefs(){return store.get('cols',{});}
function colDefault(k){var c=window.__gxCols.find(function(x){return x[0]===k;});return c||[k,1,90];}
function colOn(k){var p=colPrefs()[k]||{};return p.on===undefined?!!colDefault(k)[1]:!!p.on;}
function setCol(k,patch){var p=colPrefs();p[k]=Object.assign({},p[k]||{},patch);store.set('cols',p);window.gxColStyle();renderColsMenu();syncResizers();}
// syncResizers tells assistive technology each column's width.
function syncResizers(){$$('#torrents th .rz').forEach(function(h){h.setAttribute('aria-valuenow',Math.round(h.closest('th').getBoundingClientRect().width));});}
function renderColsMenu(){$$('#cols-menu [data-col]').forEach(function(b){b.setAttribute('aria-checked',colOn(b.dataset.col)?'true':'false');});}
var resizing=null;
function startResize(handle,x){var th=handle.closest('th');resizing={k:th.dataset.col,x:x,w:th.getBoundingClientRect().width};document.body.style.cursor='col-resize';}
document.addEventListener('pointermove',function(e){if(!resizing)return;var w=Math.max(40,Math.round(resizing.w+e.clientX-resizing.x));var p=colPrefs();p[resizing.k]=Object.assign({},p[resizing.k]||{},{w:w});store.set('cols',p);window.gxColStyle();});
document.addEventListener('pointerup',function(){if(resizing){resizing=null;document.body.style.cursor='';syncResizers();}});

// ---------- live refresh ----------
var refreshing=false,lastSide='',pointerDown=false;
document.addEventListener('mousedown',function(){pointerDown=true;});
document.addEventListener('mouseup',function(){pointerDown=false;});
window.addEventListener('blur',function(){pointerDown=false;});
// applyLive updates the table in place: only the rows change, while the static
// header (and its Select all checkbox) is kept. Replacing the whole table every
// 2s destroyed the checkbox under the user's click, so selecting all torrents
// was hard. Falls back to a full swap when the table appears or disappears.
function applyLive(frag){
  var cur=$('#torrents'),next=$('#torrents',frag);
  if(cur&&next&&cur.tBodies.length&&next.tBodies.length){
    cur.tBodies[0].innerHTML=next.tBodies[0].innerHTML;
    var curMore=$('#live .more-rows'),nextMore=$('.more-rows',frag);
    if(nextMore){if(curMore)curMore.outerHTML=nextMore.outerHTML;else $('#live').appendChild(nextMore);}
    else if(curMore)curMore.remove();
    return;
  }
  $('#live').innerHTML=frag.innerHTML;
}
function refresh(){
  if(refreshing||document.hidden||pointerDown||resizing)return;refreshing=true;
  var active=document.activeElement,activeRow=rowOf(active),activeHash=activeRow&&activeRow.dataset.hash;
  fetch('/ui/live'+(state.rows?'?rows='+state.rows:''),{cache:'no-store'}).then(function(r){return r.ok?r.text():null;}).then(function(html){
    if(!html)return;
    var box=document.createElement('div');box.innerHTML=html;
    var live=$('#frag-live',box),side=$('#frag-side',box),status=$('#frag-status',box),speeds=$('#frag-speeds',box),more=$('#frag-sbmore',box);
    // Never touch the DOM while the pointer is down: a click spans mousedown and
    // mouseup, and a replacement in between loses it.
    if(!pointerDown){
      if(live)applyLive(live);
      if(side&&side.innerHTML!==lastSide){var focusKey=document.activeElement&&document.activeElement.closest&&document.activeElement.closest('#side-live')&&focusKeyOf(document.activeElement);lastSide=side.innerHTML;$('#side-live').innerHTML=side.innerHTML;if(focusKey){var back=$(focusKey);if(back)back.focus();}}
      if(status){var sbFocus=$('#statusbar').contains(document.activeElement)?(document.activeElement.id?'#'+document.activeElement.id:document.activeElement.hasAttribute('data-global-limits')?'[data-global-limits]':document.activeElement.hasAttribute('data-alt-speed')?'[data-alt-speed]':null):null;$('#statusbar').innerHTML=status.innerHTML;if(sbFocus){var sbEl=$('#statusbar '+sbFocus);if(sbEl)sbEl.focus();}}
      if(speeds)$('#top-speeds').innerHTML=speeds.innerHTML;
      if(more)$('#sb-more').innerHTML=more.innerHTML;
    }
    afterRender();
    if(activeHash){var r=rowByHash(activeHash);if(r){r.tabIndex=0;r.focus({preventScroll:true});}}
    sampleGraph();
  }).catch(function(){}).then(function(){refreshing=false;});
}
// focusKeyOf finds the sidebar button again after the sidebar is redrawn.
function focusKeyOf(el){
  var b=el.closest('button');if(!b)return null;
  var attrs=['data-sec','data-status','data-cat','data-tag','data-tracker'];
  for(var i=0;i<attrs.length;i++){var v=b.getAttribute(attrs[i]);if(v!==null)return '#side-live ['+attrs[i]+'="'+v.replace(/"/g,'\\"')+'"]'+(b.hasAttribute('data-all')?'[data-all]':':not([data-all])');}
  return null;
}
function afterRender(){
  var known=new Set(rows().map(function(r){return r.dataset.hash;}));
  state.selected.forEach(function(h){if(!known.has(h))state.selected.delete(h);});
  countSide();applyCollapsed();applySort();applyFilters();roving();savePaths();syncResizers();
  var sb=$('#sb-more-btn');if(sb)sb.setAttribute('aria-expanded',state.sbmore?'true':'false');
}
function roving(){var rs=visibleRows(),cur=rs.find(function(r){return r.tabIndex===0;});rs.forEach(function(r){r.tabIndex=-1;});(cur||rs[0])&&((cur||rs[0]).tabIndex=0);}
function savePaths(){var dl=$('#savepaths'),seen={},html='';rows().forEach(function(r){var p=r.dataset.kPath;if(p&&!seen[p]){seen[p]=1;var o=document.createElement('option');o.value=p;html+=o.outerHTML;}});dl.innerHTML=html;}

// ---------- transfer graph and window title ----------
var samples=[];
function sampleGraph(){
  var st=$('#statusbar [data-down]');if(!st)return;
  samples.push([+st.dataset.down||0,+st.dataset.up||0]);if(samples.length>60)samples.shift();
  var max=Math.max(1024,Math.max.apply(null,samples.map(function(s){return Math.max(s[0],s[1]);})));
  var n=60,w=120,h=40;
  function path(i){return samples.map(function(s,k){var x=(w*(n-samples.length+k)/(n-1)).toFixed(1),y=(h-2-(h-4)*s[i]/max).toFixed(1);return (k?'L':'M')+x+' '+y;}).join(' ');}
  var d=path(0),u=path(1);
  $('#g-d').setAttribute('d',d);$('#g-u').setAttribute('d',u);
  if(samples.length>1){var x0=(w*(n-samples.length)/(n-1)).toFixed(1);$('#g-da').setAttribute('d',d+' L'+w+' '+h+' L'+x0+' '+h+' Z');}
  $('#g-dl').textContent='↓ '+(st.dataset.downS||'');$('#g-ul').textContent='↑ '+(st.dataset.upS||'');
  // Like qBittorrent, the speeds are in the tab title too.
  document.title='↓ '+(st.dataset.downS||'')+' ↑ '+(st.dataset.upS||'')+' · gx-torrent';
}

