// ---------- add preview ----------
// What will be added: each magnet line shows its display name (dn) and info
// hash (btih), each URL its address, so a paste is checked before sending.
function parseMagnetLine(line){
  var m=/^magnet:\?(.+)$/i.exec(line.trim());if(!m)return null;
  var q=m[1],dn='',hash='';
  q.split('&').forEach(function(p){
    var kv=p.split('='),k=(kv[0]||'').toLowerCase(),v=kv[1]||'';
    try{v=decodeURIComponent(v.replace(/\+/g,' '));}catch(e){}
    if(k==='dn'&&!dn)dn=v;
    if(k==='xt'&&!hash){var hm=/^urn:btih:(.+)$/i.exec(v);if(hm)hash=hm[1];}
  });
  return {name:dn,hash:hash};
}
// cookieHint says, per .torrent URL host, whether a saved login cookie will
// be sent (suffix match like the jar, "*" matches all). Domains load once per
// dialog opening; values never leave the server.
var cookieDomains=null;
function loadCookieDomains(then){
  if(cookieDomains!==null){if(then)then();return;}
  fetch('/ui/cookie-domains',{cache:'no-store'}).then(function(r){return r.ok?r.json():null;}).then(function(j){
    cookieDomains=(j&&j.domains)||[];
    if(then)then();
  }).catch(function(){cookieDomains=[];if(then)then();});
}
function cookieForHost(host){
  host=String(host||'').toLowerCase();
  for(var i=0;i<(cookieDomains||[]).length;i++){
    var d=String(cookieDomains[i]||'').toLowerCase();
    if(d==='*'||host===d||host.slice(-d.length-1)==='.'+d)return cookieDomains[i];
  }
  return null;
}
function updateCookieHint(){
  var box=$('#add-cookies');if(!box)return;
  var ta=$('#add-source'),hosts={},order=[];
  (ta?ta.value:'').split(/\r?\n/).forEach(function(line){
    var m=/^https?:\/\/([^\/\s]+)/i.exec(line.trim());if(!m)return;
    var h=m[1].toLowerCase();if(!hosts[h]){hosts[h]=1;order.push(h);}
  });
  if(!order.length){box.hidden=true;box.textContent='';return;}
  loadCookieDomains(function(){
    box.innerHTML='';
    order.forEach(function(h){
      var dom=cookieForHost(h);
      var p=document.createElement('div');p.className=dom?'ok':'muted';
      p.textContent=h+': '+(dom?t('uses saved cookies'):t('no saved cookies'));
      box.appendChild(p);
    });
    box.hidden=false;
  });
}
function updateAddPreview(){
  var ta=$('#add-source'),box=$('#add-preview');if(!ta||!box)return;
  var lines=ta.value.split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean);
  box.innerHTML='';
  updateCookieHint();
  if(!lines.length){box.hidden=true;return;}
  box.hidden=false;
  var ignored=0;
  lines.forEach(function(line){
    var r=document.createElement('div');r.className='r';
    var low=line.toLowerCase();
    if(low.indexOf('magnet:')===0){
      var p=parseMagnetLine(line);
      var ti=document.createElement('span');ti.className='t';ti.textContent=p&&p.name?p.name:line;ti.title=line;r.appendChild(ti);
      var hh=document.createElement('span');hh.className='seed';hh.textContent=p&&p.hash?p.hash.slice(0,16)+'…':t('no info hash');r.appendChild(hh);
    }else if(low.indexOf('http://')===0||low.indexOf('https://')===0){
      var u=document.createElement('span');u.className='t';u.textContent=line;u.title=line;r.appendChild(u);
    }else{ignored++;return;}
    box.appendChild(r);
  });
  if(ignored){var n=document.createElement('p');n.className='muted';n.style.margin='6px 0 0';n.textContent=ignored+' '+t('lines ignored');box.appendChild(n);}
}
function submitAdd(form){
  var opts=new FormData(form),sources=String(opts.get('source')||'').split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean),files=$('#add-files').files||[];
  if(!sources.length&&!files.length){toast(t('Paste a magnet link or choose a .torrent file'),true);return;}
  var base={};['destination','category','auto_tmm','paused','top','sequential','first_last','super_seeding','download_limit','upload_limit'].forEach(function(k){var v=opts.get(k);if(v)base[k]=v;});
  var tree=$('#add-file-tree');
  if(tree&&!tree.hidden&&files.length===1){
    var boxes=$$('input[data-file-index]',tree);
    if(boxes.length)base.file_priorities=boxes.map(function(b){if(!b.checked)return '0';var sel=$('select[data-file-prio="'+b.dataset.fileIndex+'"]',tree);return sel?sel.value:'4';}).join(',');
  }
  var jobs=[],ok=0,fail=[];
  sources.forEach(function(s){var p=new URLSearchParams(base);p.set('source',s);jobs.push(post('/ui/add',p));});
  Array.prototype.forEach.call(files,function(file){var fd=new FormData();Object.keys(base).forEach(function(k){fd.set(k,base[k]);});fd.set('torrent',file);jobs.push(fetch('/ui/add',{method:'POST',body:fd,headers:{'X-GX-Fetch':'1'}}).then(function(r){return r.json();}).catch(function(e){return {ok:false,msg:e.message};}));});
  Promise.all(jobs).then(function(res){res.forEach(function(r){if(r&&r.ok)ok++;else fail.push(r&&r.msg);});
    if(ok)toast(ok+' '+t('torrent(s) added'),false);fail.forEach(function(m){toast(m||t('Error'),true);});
    if(!fail.length){closeDialog($('#dlg-add'));form.reset();updateFilePick();updateAddPreview();}
    refresh();});
}
