// flagState is "true", "false" or "mixed" for a row flag over the selection.
function flagState(hashes,attr){
  var on=0;hashes.forEach(function(h){var r=rowByHash(h);if(r&&r.dataset[attr])on++;});
  return on===0?'false':on===hashes.length?'true':'mixed';
}
// toggleFlag switches a per-torrent option: every selected torrent ends in the
// same state (on, unless they all are already), and toggles reach only the
// torrents that need them.
function toggleFlag(hashes,attr,onOp,offOp,toggle){
  var target=flagState(hashes,attr)!=='true';
  var need=hashes.filter(function(h){var r=rowByHash(h);return r&&(!!r.dataset[attr])!==target;});
