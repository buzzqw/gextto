<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>gx-torrent</title>
<link rel="icon" type="image/svg+xml" href="/favicon.ico">
<link rel="manifest" href="/manifest.webmanifest">
<script>try{var m=localStorage.getItem('gx-theme');if(m==='light'||m==='dark')document.documentElement.setAttribute('data-theme',m);}catch(e){}</script>
<script>
// The torrent table's columns (the column chooser): key, shown by default,
// default width in px (0 = the name column, which takes the remaining space).
// The style is written before the table is parsed, so a hidden column never
// flashes on load.
window.__gxCols=[["name",1,0],["size",1,92],["progress",1,120],["state",1,132],["seeds",1,72],["peers",1,72],["down",1,104],["up",1,104],["eta",1,76],["ratio",1,64],["category",1,104],["tags",0,120],["added",0,132],["completed",0,132],["downloaded",0,94],["uploaded",0,94],["remaining",0,94],["queue",0,52],["tracker",0,150],["path",0,220],["availability",0,80],["active",0,90],["lastactive",0,132],["wasted",0,94]];
window.gxColStyle=function(){
  var saved={};try{saved=JSON.parse(localStorage.getItem('gx-cols')||'{}')||{};}catch(e){}
  var css='',total=34+40+200;
  window.__gxCols.forEach(function(c){
    var s=saved[c[0]]||{},on=c[0]==='name'?true:(s.on===undefined?!!c[1]:!!s.on),w=s.w||c[2];
    if(!on){css+='.tbl.t .c-'+c[0]+'{display:none}';return;}
    if(w){css+='.tbl.t th.c-'+c[0]+'{width:'+w+'px}';total+=w;}
  });
  css='@media (min-width:761px){'+css+'.tbl.t{min-width:'+total+'px}}';
  var el=document.getElementById('col-style');if(!el){el=document.createElement('style');el.id='col-style';document.head.appendChild(el);}
  el.textContent=css;
};
window.gxColStyle();
</script>
<link rel="stylesheet" href="/assets/theme.css">
<style>
html,body{height:100%}
body{display:flex;flex-direction:column;overflow:hidden}
.topbar .search{position:relative;display:flex;align-items:center;width:min(360px,34vw)}
.topbar .search svg{position:absolute;left:10px;color:var(--subtle);pointer-events:none}
.topbar .search input{width:100%;padding-left:32px;height:32px;background:var(--surface-2);border-color:transparent}
.topbar .search input:focus{background:var(--sunken);border-color:var(--accent)}
.topbar .search kbd{position:absolute;right:8px;font:11px var(--mono);color:var(--subtle);border:1px solid var(--border);border-radius:4px;padding:0 4px;background:var(--surface)}
.topbar .logout-form{display:flex;margin:0}
.speeds{display:flex;gap:12px;font-variant-numeric:tabular-nums;font-size:13px;white-space:nowrap}
.speeds span{display:inline-flex;align-items:center;gap:4px}
.speeds .d{color:var(--info)}.speeds .u{color:var(--ok)}
.shell{flex:1;display:flex;min-height:0}
/* Sidebar: qBittorrent's filter panel, every section collapsible. */
.side{width:224px;flex:none;overflow:hidden;padding:10px 8px;border-right:1px solid var(--border);background:var(--surface);display:flex;flex-direction:column}
/* The filters scroll; the language picker below them stays in sight. The fade
   at the bottom says there is more to scroll. */
.side-scroll{flex:1 1 auto;min-height:0;overflow:auto;display:flex;flex-direction:column;gap:10px;mask-image:linear-gradient(to bottom,#000 calc(100% - 14px),transparent);-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - 14px),transparent)}
.side h2{margin:0;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--subtle);font-weight:650}
.side h2 button{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:6px;width:100%;padding:4px 8px;border-radius:6px;cursor:pointer}
.side h2 button:hover{color:var(--text)}
.side h2 button:focus-visible{outline:2px solid var(--focus);outline-offset:1px}
.side h2 button svg{width:12px;height:12px;transition:transform .15s}
.side h2 button[aria-expanded="false"] svg{transform:rotate(-90deg)}
.flist{list-style:none;margin:2px 0 0;padding:0;display:flex;flex-direction:column;gap:1px}
.flist[hidden]{display:none}
.flist button{width:100%;height:28px;justify-content:flex-start;gap:9px;border:0;background:transparent;color:var(--muted);font-weight:500;padding:0 8px}
.flist button:hover{background:var(--hover);color:var(--text)}
.flist button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent-soft-fg)}
.flist button .n{margin-left:auto;font-size:12px;color:var(--subtle);font-variant-numeric:tabular-nums}
.flist button[aria-pressed="true"] .n{color:inherit}
.flist button .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.flist button.zero .lbl,.flist button.zero .n,.flist button.zero svg{color:var(--subtle)}
/* Language picker: the bottom-left corner of the first page (standalone), so
   the interface language is found where the filters are, not only in Settings.
   It sits below the scrolling filters and stays visible while they scroll. */
.langpick{flex:none;padding:8px 0 2px;border-top:1px solid var(--border);display:flex;flex-direction:column;gap:4px}
.langpick h2{display:flex;align-items:center;gap:6px;padding:0 8px}
.langpick h2 svg{width:12px;height:12px}
.langpick form{display:flex;gap:6px;align-items:center}
.langpick select{flex:1;min-width:0}
.graph{margin:0 4px;padding:10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--sunken)}
.graph svg{display:block;width:100%;height:56px}
.graph .legend{display:flex;justify-content:space-between;font-size:12px;margin-top:6px;font-variant-numeric:tabular-nums}
.graph .legend .d{color:var(--info)}.graph .legend .u{color:var(--ok)}
.graph path.d{stroke:var(--info);fill:none;stroke-width:1.6}
.graph path.u{stroke:var(--ok);fill:none;stroke-width:1.6}
.graph path.da{fill:var(--info-soft);stroke:none}
.work{flex:1;min-width:0;display:flex;flex-direction:column}
.torrentpane{flex:1;min-height:0;display:flex;flex-direction:column}
.toolbar{display:flex;align-items:center;gap:4px;padding:6px 12px;border-bottom:1px solid var(--border);background:var(--surface);flex-wrap:wrap}
.toolbar .sep{width:1px;height:20px;background:var(--border);margin:0 4px}
.toolbar .selinfo{font-size:12.5px;color:var(--muted);margin-left:4px}
.toolbar .right{margin-left:auto;display:flex;gap:4px;align-items:center}
.listwrap{flex:1;min-height:0;overflow:auto;position:relative;background:var(--surface)}
/* Torrent table: one compact line per torrent, like qBittorrent. */
.tbl.t{table-layout:fixed;font-size:13px}
.tbl.t th{height:30px;padding:0 8px;position:sticky;top:0;overflow:hidden;text-overflow:ellipsis;text-transform:none;letter-spacing:0;font-size:12px}
.tbl.t th.sel{width:34px}.tbl.t th.c-more{width:40px}
.tbl.t th button.sort{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:4px;max-width:calc(100% - 6px);overflow:hidden;text-overflow:ellipsis}
.tbl.t th button.sort:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}
.tbl.t th.num button.sort{float:right}
.tbl.t th[aria-sort="ascending"] .arrow::after{content:"▲";font-size:9px}
.tbl.t th[aria-sort="descending"] .arrow::after{content:"▼";font-size:9px}
.tbl.t th .rz{position:absolute;top:0;right:0;width:7px;height:100%;cursor:col-resize;touch-action:none}
.tbl.t th .rz::after{content:"";position:absolute;top:8px;bottom:8px;right:3px;width:1px;background:var(--border)}
.tbl.t th .rz:hover::after,.tbl.t th .rz:focus-visible::after{background:var(--accent);width:2px}
.tbl.t th .rz:focus-visible{outline:none}
.tbl.t tbody tr{cursor:default}
.tbl.t tbody tr td{height:32px;padding:0 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tbl.t tbody tr[aria-selected="true"] td{background:var(--accent-soft)}
.tbl.t tbody tr:focus-visible{outline:none}
.tbl.t tbody tr:focus-visible td{box-shadow:inset 0 2px 0 var(--focus),inset 0 -2px 0 var(--focus)}
.tbl.t tbody tr:focus-visible td:first-child{box-shadow:inset 2px 2px 0 var(--focus),inset 0 -2px 0 var(--focus)}
.tbl.t td.sel{text-align:center}
.tbl.t td.name a{color:var(--text);text-decoration:none;font-weight:550}
.tbl.t td.name a:hover{text-decoration:underline;color:var(--accent)}
.tbl.t td.name .sti{display:inline-flex;vertical-align:-3px;margin-right:6px;color:var(--subtle)}
.tbl.t td.name .sti svg{width:15px;height:15px}
.sti.st-downloading,.sti.st-downloading_metadata{color:var(--info)}
.sti.st-seeding{color:var(--ok)}
.sti.st-stalled,.sti.st-disk_wait{color:var(--warn)}
.sti.st-error{color:var(--err)}
.tbl.t td.name .fl{font-size:10.5px;font-weight:650;color:var(--accent-soft-fg);background:var(--accent-soft);border-radius:4px;padding:0 4px;margin-left:6px;vertical-align:1px}
.tbl.t .state .badge{max-width:100%;overflow:hidden;text-overflow:ellipsis}
.prog{display:flex;align-items:center;gap:6px}
.prog .pct{flex:none;min-width:42px;text-align:right;font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.pbar{position:relative;flex:1;min-width:24px;height:8px;border-radius:4px;background:var(--surface-2);overflow:hidden}
.pbar>i{position:absolute;inset:0 auto 0 0;background:var(--bar-down)}
.pbar.seeding>i{background:var(--bar-seed)}
.pbar.paused>i,.pbar.stalled>i,.pbar.disk_wait>i{background:var(--bar-paused)}
.pbar.error>i{background:var(--err)}
.tbl.t td.more{padding:0 4px}
.tbl.t td.more button{opacity:.5;width:28px;height:24px}
.tbl.t tr:hover td.more button,.tbl.t tr[aria-selected="true"] td.more button,.tbl.t td.more button:focus-visible{opacity:1}
.tbl.t .z{color:var(--subtle)}
.emptystate{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:80px 20px;text-align:center;color:var(--muted)}
.emptystate>svg{width:44px;height:44px;color:var(--subtle)}
.emptystate h3{margin:0;color:var(--text);font-size:16px}
.more-rows{padding:12px;text-align:center}
/* Status bar: what matters at a glance; the rest is one click away. */
.statusbar{display:flex;gap:6px 16px;align-items:center;flex-wrap:wrap;padding:4px 12px;border-top:1px solid var(--border);background:var(--surface);font-size:12.5px;color:var(--muted)}
.statusbar b{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}
.statusbar .spacer{flex:1}
.statusbar .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;background:var(--subtle)}
.statusbar .dot.ok{background:var(--ok)}.statusbar .dot.bad{background:var(--err)}.statusbar .dot.warn{background:var(--warn)}
.statusbar .sb-update{display:inline-flex;align-items:center;color:var(--text);font-weight:600;text-decoration:none;border:1px solid var(--warn);border-radius:999px;padding:1px 9px}.statusbar .sb-update:hover,.statusbar .sb-update:focus-visible{background:var(--warn-soft)}
.statusbar .disk{display:inline-flex;align-items:center;gap:6px}
.statusbar .disk .progress{width:70px}
.statusbar .sb-btn{display:inline-flex;align-items:center;gap:5px;height:24px;border:1px solid transparent;background:transparent;color:var(--muted);border-radius:6px;padding:0 7px;font:inherit;cursor:pointer}
.statusbar .sb-btn:hover{background:var(--hover);color:var(--text)}
.statusbar .sb-btn .d,.statusbar .sb-tot .d{color:var(--info)}.statusbar .sb-btn .u,.statusbar .sb-tot .u{color:var(--ok)}
.statusbar .sb-alt{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--border);background:var(--surface);color:var(--muted);border-radius:999px;padding:1px 9px;cursor:pointer;font:inherit}
.statusbar .sb-alt[aria-checked=true]{border-color:var(--warn);color:var(--text);background:var(--warn-soft)}
.sbmore{position:fixed;right:12px;bottom:38px;z-index:55;width:min(420px,calc(100vw - 24px));padding:12px 14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-lg);font-size:12.5px}
.sbmore[hidden]{display:none}
.sbmore h2{margin:0 0 8px;font-size:13px}
.sbmore .row{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px solid var(--border)}
.sbmore .row:last-child{border-bottom:0}
.sbmore .row span:first-child{color:var(--muted)}
.sbmore .row b{font-weight:600;text-align:right;font-variant-numeric:tabular-nums;word-break:break-word}
/* Undo bar: after a remove without deleting files, one click brings the
   torrents back from their magnets until the countdown runs out. */
.undobar{position:fixed;left:50%;transform:translateX(-50%);bottom:44px;z-index:70;display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-lg);font-size:13px}
.undobar[hidden]{display:none}
/* Detail panel under the list, resizable from its top edge. */
.drawer{flex:none;height:var(--drawer-h,clamp(220px,42vh,520px));border-top:1px solid var(--border);background:var(--surface);display:flex;flex-direction:column;min-height:0;position:relative}
.drawer[hidden]{display:none}
.dsplit{position:absolute;left:0;right:0;top:-4px;height:8px;cursor:row-resize;z-index:3;touch-action:none}
.dsplit::after{content:"";position:absolute;left:50%;top:2px;width:40px;height:4px;margin-left:-20px;border-radius:2px;background:var(--border-strong);opacity:0;transition:opacity .15s}
.dsplit:hover::after,.dsplit:focus-visible::after{opacity:1;background:var(--accent)}
.dsplit:focus-visible{outline:none}
.drawer #drawer-body{flex:1;min-height:0;display:flex;flex-direction:column}
.drawer .dhead{display:flex;align-items:flex-start;gap:10px;padding:10px 16px 4px}
.drawer .dhead h2{margin:0;font-size:14px;flex:1;word-break:break-word}
.drawer .dbody{flex:1;overflow:auto;padding:0 16px 20px}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--border);margin:0 -16px 12px;padding:0 12px;position:sticky;top:0;background:var(--surface);z-index:1}
.tabs button{height:34px;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--muted);padding:0 10px}
.tabs button:hover{background:transparent;color:var(--text)}
.tabs button[aria-selected="true"]{color:var(--accent);border-bottom-color:var(--accent)}
.tabs .cnt{font-size:11.5px;color:var(--subtle)}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0 20px;margin-bottom:14px}
.kv .row{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px solid var(--border);font-size:13px}
.kv .row span{color:var(--muted)}
.kv .row strong{font-weight:550;text-align:right;word-break:break-word;font-variant-numeric:tabular-nums}
.dsec{margin:18px 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--subtle);font-weight:650}
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;align-items:end;margin:8px 0}
.form-grid label{display:flex;flex-direction:column;gap:4px;font-size:12.5px}
.form-grid label.chk{flex-direction:row}
.form-grid textarea,.form-grid .wide{grid-column:1/-1}
.form-grid .wide textarea,.form-grid .wide input{width:100%}
.drawer .tbl{font-size:12.5px}
.drawer .tbl td{padding:5px 8px}
.drawer .tbl th{padding:0 8px;height:30px;text-transform:none;letter-spacing:0}
.filesbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:0 0 8px;font-size:12.5px}
.filesbar select{height:28px}
.tbl.files .fp{min-width:110px}
.tbl.files tr.fdir td{background:var(--surface-2);font-weight:600}
.tbl.files tr.fdir .fname{display:flex;align-items:center;gap:6px}
.tbl.files tr.fdir .exp{width:26px;height:24px}
.tbl.files .fname .dir{color:var(--subtle)}
.tbl.files td.sel{width:30px;text-align:center}
.flags{display:flex;flex-wrap:wrap;gap:3px}
.flag{font-size:11px;padding:0 6px;border-radius:5px;background:var(--surface-2);color:var(--muted);white-space:nowrap;line-height:18px}
.flag.on{background:var(--ok-soft);color:var(--ok)}
.tgraph{margin:4px 0}
.tgraph svg{height:120px}
.tgraph .tg-peak{margin:6px 0 0;font-size:12px}
.tlog td{vertical-align:top}
.tlog td.num{white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--muted)}
.tlog td.mono{font-family:var(--mono);font-size:11.5px;word-break:break-all}
.tlog tr.bad td:nth-child(2){color:var(--err)}
.addfile{display:flex;align-items:center;gap:8px;justify-content:space-between}
.addfile .chk{flex:1;min-width:0;margin:2px 0;overflow-wrap:anywhere}
.addfile select{flex:none;width:auto}
.dlg-foot .add-direct{margin-right:auto;font-size:12.5px;color:var(--muted)}
.dbars{display:grid;grid-template-columns:auto 1fr auto;gap:6px 10px;align-items:center;margin:0 0 14px;font-size:12.5px}
.dbar-l{color:var(--muted)}
.dbar-v{font-variant-numeric:tabular-nums;text-align:right;min-width:52px}
.dbar-v .err-t{color:var(--err);font-weight:600}
.dbar{display:flex;height:12px;border-radius:3px;overflow:hidden;background:var(--surface-2);border:1px solid var(--border)}
.dbar i{flex:1;min-width:0}
.dbar i.have,.dbar i.partial{background:var(--bar-down)}
.dbar i.missing{background:transparent}
.dbar i.skip{background:var(--bar-paused);opacity:.35!important}
.dbar.av i.avail{background:var(--ok)}
.dbar.av i.none{background:var(--err)}
.dbar.av i.done{background:transparent}
@media (forced-colors:active){.dbar i.have,.dbar i.partial,.dbar.av i.avail{background:CanvasText}.dbar.av i.none{background:Mark}}
.piece-map{display:flex;width:100%;height:22px;margin:8px 0;border-radius:6px;overflow:hidden;background:var(--surface-2)}
.piece-run{min-width:1px;height:100%}
.piece-run.piece-have{background:var(--bar-seed)}
.piece-run.piece-down{background:var(--warn)}
.piece-run.piece-skip{background:var(--bar-paused);opacity:.4}
.piece-run.piece-missing{background:transparent}
.dropzone{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;background:rgba(37,87,214,.14);border:3px dashed var(--accent);color:var(--accent);font-size:20px;font-weight:650;pointer-events:none}
.dropzone[hidden]{display:none}
.filepick{display:flex;flex-direction:column;align-items:center;gap:6px;padding:16px;border:1.5px dashed var(--border-strong);border-radius:var(--radius);text-align:center;color:var(--muted);font-size:13px}
.filepick.has{border-color:var(--accent);color:var(--text)}
.filetree{margin:8px 0;max-height:26vh;overflow:auto;border:1px solid var(--border);border-radius:var(--radius);padding:8px 10px;background:var(--surface)}
.filetree .chk{margin:2px 0}
.opts{display:flex;flex-wrap:wrap;gap:10px 18px}
.addmore{border:0;padding:0}
.addmore summary{cursor:pointer;color:var(--muted);font-size:13px}
.results{display:flex;flex-direction:column;gap:6px;max-height:50vh;overflow:auto}
.results .r{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius)}
.results .r .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.results .r .m{color:var(--muted);font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:42%}
.trk-edit{display:flex;gap:4px;align-items:center;margin:0}
.trk-edit input[type=text]{min-width:16em;flex:1}
.logpane{flex:1;min-height:0;display:flex;flex-direction:column}
.logbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border);background:var(--surface)}
.logview{flex:1;margin:0;overflow:auto;padding:10px 14px;background:var(--sunken);font:12.5px/1.45 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}
.logview .warn{color:var(--warn)}.logview .error{color:var(--err)}.logview .debug{color:var(--subtle)}
/* Menus: check marks for toggles, an arrow for submenus. */
.menu [role=menuitemcheckbox]::after,.menu [aria-haspopup=menu]::after{margin-left:auto;padding-left:12px;color:var(--subtle)}
.menu [role=menuitemcheckbox][aria-checked=true]::after{content:"✓";color:var(--accent);font-weight:700}
.menu [role=menuitemcheckbox][aria-checked=mixed]::after{content:"–";color:var(--accent);font-weight:700}
.menu [aria-haspopup=menu]::after{content:"›";font-size:16px}
.menu .mhead{padding:4px 10px 2px;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--subtle)}
.menu.cols{max-height:min(70vh,560px);overflow:auto}
.dlg-help{margin:0;font-size:12.5px;color:var(--muted)}
.tbl.t td.meta-m{display:none}
.menu-side{display:none!important}
@container work (max-width:880px){.toolbar .lbl{display:none}}
.work{container-type:inline-size;container-name:work}
@media (max-width:980px){
  .side{display:none}
  .side.open{display:flex;position:fixed;z-index:40;top:var(--topbar-h,52px);bottom:0;left:0;box-shadow:var(--shadow-lg)}
  .menu-side{display:inline-flex!important}
}
@media (max-width:760px){
  .topbar .search{display:none}.speeds{display:none}.brand small{display:none}
  .tbl.t{min-width:0;table-layout:auto}
  .tbl.t thead{display:none}
  .tbl.t,.tbl.t tbody{display:block}
  .tbl.t tbody tr{display:grid;grid-template-columns:28px 1fr auto;grid-template-areas:"sel name more" "sel prog prog" "sel meta meta";gap:4px 8px;padding:10px 12px;border-bottom:1px solid var(--border)}
  .tbl.t tbody tr td{display:none;height:auto;padding:0;border:0;background:transparent!important;white-space:normal}
  .tbl.t tbody tr[aria-selected="true"]{background:var(--accent-soft)}
  .tbl.t td.sel{display:block;grid-area:sel;padding-top:2px}
  .tbl.t td.name{display:block;grid-area:name}
  .tbl.t td.more{display:block;grid-area:more}
  .tbl.t td.c-progress{display:block;grid-area:prog}
  .tbl.t td.meta-m{display:flex;grid-area:meta;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
  /* The file list in the detail drawer: the path broke to one word per line
     because the other columns left it a few pixels. Give it a real width and
     let the drawer scroll sideways. */
  .tbl.files .fname{min-width:11rem}
  .toolbar .lbl{display:none}
  .toolbar{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
  .toolbar .selinfo,.toolbar .hide-m{display:none}
  .statusbar{gap:4px 12px}
  .statusbar .hide-m{display:none}
}
</style>
</head>
<body>
