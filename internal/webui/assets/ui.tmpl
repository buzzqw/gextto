        </div>
      </details>
{{end}}{{define "fragments"}}<div id="frag-side">{{template "side" .}}</div><div id="frag-live">{{template "live" .}}</div><div id="frag-status">{{template "status" .}}</div><div id="frag-speeds">{{template "speeds" .}}</div><div id="frag-sbmore">{{template "sbmore" .}}</div>{{end}}{{define "speeds"}}<span class="d" title="Download speed"><svg class="i"><use href="#i-down"/></svg>{{.DownloadRate}}</span><span class="u" title="Upload speed"><svg class="i"><use href="#i-up"/></svg>{{.UploadRate}}</span>{{end}}{{define "side"}}
    <section aria-labelledby="h-status">
      <h2 id="h-status"><button type="button" aria-expanded="true" aria-controls="sec-status" data-sec="status"><svg class="i"><use href="#i-chev"/></svg><span>Status</span></button></h2>
      <ul class="flist" id="sec-status">
        <li><button type="button" data-status="all" aria-pressed="true" title="Show all torrents in the session"><svg class="i"><use href="#i-list"/></svg><span class="lbl">All</span><span class="n">{{.CountAll}}</span></button></li>
        <li><button type="button" data-status="downloading" aria-pressed="false" title="Show only torrents currently downloading"><svg class="i"><use href="#i-dl"/></svg><span class="lbl">Downloading</span><span class="n">{{.CountDown}}</span></button></li>
        <li><button type="button" data-status="seeding" aria-pressed="false" title="Show only torrents currently seeding"><svg class="i"><use href="#i-seed"/></svg><span class="lbl">Seeding</span><span class="n">{{.CountSeeding}}</span></button></li>
        <li><button type="button" data-status="completed" aria-pressed="false" title="Show only torrents whose download is complete"><svg class="i"><use href="#i-done"/></svg><span class="lbl">Completed</span><span class="n">{{.CountCompleted}}</span></button></li>
        <li><button type="button" data-status="running" aria-pressed="false" title="Show only torrents that are not paused"><svg class="i"><use href="#i-run"/></svg><span class="lbl">Running</span><span class="n">{{.CountRunning}}</span></button></li>
        <li><button type="button" data-status="paused" aria-pressed="false" title="Show only paused torrents"><svg class="i"><use href="#i-pausec"/></svg><span class="lbl">Paused</span><span class="n">{{.CountPaused}}</span></button></li>
        <li><button type="button" data-status="active" aria-pressed="false" title="Show only torrents moving data right now"><svg class="i"><use href="#i-activity"/></svg><span class="lbl">Active</span><span class="n">{{.CountActive}}</span></button></li>
        <li><button type="button" data-status="inactive" aria-pressed="false" title="Show only torrents not moving data right now"><svg class="i"><use href="#i-sleep"/></svg><span class="lbl">Inactive</span><span class="n">{{.CountInactive}}</span></button></li>
        <li><button type="button" data-status="stalled" aria-pressed="false" title="Show only stalled torrents (no seeders or peers)"><svg class="i"><use href="#i-warn"/></svg><span class="lbl">Stalled</span><span class="n">{{.CountStalled}}</span></button></li>
        <li><button type="button" data-status="checking" aria-pressed="false" title="Show only torrents whose data is being checked"><svg class="i"><use href="#i-check"/></svg><span class="lbl">Checking</span><span class="n">{{.CountChecking}}</span></button></li>
        <li><button type="button" data-status="moving" aria-pressed="false" title="Show only torrents currently being moved across storage"><svg class="i"><use href="#i-move"/></svg><span class="lbl">Moving</span><span class="n">{{.CountMoving}}</span></button></li>
        <li><button type="button" data-status="error" aria-pressed="false" title="Show only torrents in error state"><svg class="i"><use href="#i-xc"/></svg><span class="lbl">Errored</span><span class="n">{{.CountError}}</span></button></li>
      </ul>
    </section>
    {{if .Standalone}}
    <section aria-labelledby="h-cats">
      <h2 id="h-cats"><button type="button" aria-expanded="true" aria-controls="sec-cats" data-sec="cats"><svg class="i"><use href="#i-chev"/></svg><span>Categories</span></button></h2>
      <ul class="flist" id="sec-cats">
        <li><button type="button" data-catbtn data-all data-cat="" aria-pressed="true" title="Torrents of every category"><svg class="i"><use href="#i-folder"/></svg><span class="lbl">All</span><span class="n">{{.CountAll}}</span></button></li>
        <li><button type="button" data-catbtn data-cat="" aria-pressed="false" title="Torrents without a category"><svg class="i"><use href="#i-folder"/></svg><span class="lbl">Uncategorized</span><span class="n">0</span></button></li>
        {{range .Categories}}<li><button type="button" data-catbtn data-cat="{{.}}" aria-pressed="false" title="Filter torrents by category"><svg class="i"><use href="#i-folder"/></svg><span class="lbl">{{.}}</span><span class="n">0</span></button></li>{{end}}
      </ul>
    </section>
    <section aria-labelledby="h-tags">
      <h2 id="h-tags"><button type="button" aria-expanded="true" aria-controls="sec-tags" data-sec="tags"><svg class="i"><use href="#i-chev"/></svg><span>Tags</span></button></h2>
      <ul class="flist" id="sec-tags">
        <li><button type="button" data-tagbtn data-all data-tag="" aria-pressed="true" title="Torrents with any tag or none"><svg class="i"><use href="#i-tag"/></svg><span class="lbl">All</span><span class="n">{{.CountAll}}</span></button></li>
        <li><button type="button" data-tagbtn data-tag="" aria-pressed="false" title="Torrents without tags"><svg class="i"><use href="#i-tag"/></svg><span class="lbl">Untagged</span><span class="n">0</span></button></li>
        {{range .Tags}}<li><button type="button" data-tagbtn data-tag="{{.}}" aria-pressed="false" title="Filter torrents by tag"><svg class="i"><use href="#i-tag"/></svg><span class="lbl">{{.}}</span><span class="n">0</span></button></li>{{end}}
