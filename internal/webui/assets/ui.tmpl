<dialog id="dlg-create" aria-labelledby="dlg-create-title">
  <form method="post" action="/ui/create-torrent" data-native>
    <div class="dlg-head"><h2 id="dlg-create-title">{{tr "Create .torrent"}}</h2><button type="button" class="ghost icon" data-close aria-label="{{tr "Close"}}" title="{{tr "Close"}}"><svg class="i"><use href="#i-x"/></svg></button></div>
    <div class="dlg-body">
      <label class="field">{{tr "Folder or file on the server"}}<input type="text" name="path" placeholder="/srv/share/folder" autocomplete="off" title="{{tr "Path to folder or file on the server to package into .torrent"}}"></label>
      <label class="field">{{tr "Name (optional)"}}<input type="text" name="name" autocomplete="off" title="{{tr "Display name for the torrent (optional, defaults to filename or folder name)"}}"></label>
      <div class="form-grid">
        <label>{{tr "Piece size"}}<select name="piece_size" title="{{tr "Size of each piece in the .torrent: Auto picks one from the total size, a fixed size is useful to match an existing torrent"}}"><option value="0">{{tr "Auto"}}</option><option value="32">{{tr "32 KiB"}}</option><option value="64">{{tr "64 KiB"}}</option><option value="128">{{tr "128 KiB"}}</option><option value="256">{{tr "256 KiB"}}</option><option value="512">{{tr "512 KiB"}}</option><option value="1024">{{tr "1 MiB"}}</option><option value="2048">{{tr "2 MiB"}}</option><option value="4096">{{tr "4 MiB"}}</option><option value="8192">{{tr "8 MiB"}}</option><option value="16384">{{tr "16 MiB"}}</option></select></label>
        <label>{{tr "Torrent format"}}<select name="format" title="{{tr "v1 is read by every client; v2 is the BEP 52 format; hybrid carries both and serves the two swarms. Hybrid and v2 need a power-of-two piece size."}}"><option value="v1">{{tr "v1 (widest compatibility)"}}</option><option value="v2">{{tr "v2 (BEP 52)"}}</option><option value="hybrid">{{tr "Hybrid (v1 + v2)"}}</option></select></label>
        <label class="chk" title="{{tr "Mark the torrent private (BEP 27): DHT, PEX and local discovery are disabled and only the trackers are used"}}"><input type="checkbox" name="private" value="1"> {{tr "Private"}}</label>
      </div>
      <label class="field">{{tr "Comment (optional)"}}<input type="text" name="comment" autocomplete="off" title="{{tr "Comment stored in the .torrent, for example the source or the release group"}}"></label>
      <label class="field">{{tr "Source (optional)"}}<input type="text" name="source" autocomplete="off" title="{{tr "Value stored in the source field of the .torrent, used to tell releases from different sites apart for cross-seeding"}}"></label>
      <label class="chk" title="{{tr "Add the new torrent to the session and seed the folder or file immediately; the .torrent is not downloaded. The name must match the folder or file name."}}"><input type="checkbox" name="start_seeding" value="1"> {{tr "Start seeding after creating"}}</label>
      <label class="field">{{tr "Trackers, one per line"}}<textarea name="trackers" rows="3" autocomplete="off" title="{{tr "Tracker announce URLs, one per line (optional, for swarm discovery)"}}"></textarea></label>
      <label class="field">{{tr "Web seeds, one per line"}}<textarea name="webseeds" rows="2" autocomplete="off" placeholder="https://example/file" title="{{tr "HTTP/HTTPS web seeds stored in the .torrent, one per line (optional, BEP 19)"}}"></textarea></label>
    </div>
    <div class="dlg-foot">
      <button type="button" data-close title="{{tr "Close without creating"}}">{{tr "Cancel"}}</button>
      <button type="submit" class="primary" title="{{tr "Create and download the .torrent file"}}">{{tr "Create .torrent"}}</button>
    </div>
  </form>
</dialog>

{{if .SearchEnabled}}
<dialog id="dlg-search" aria-labelledby="dlg-search-title" style="width:min(760px,calc(100vw - 32px))">
  <form method="dialog" id="form-search">
    <div class="dlg-head"><h2 id="dlg-search-title">{{tr "Search indexers"}}</h2><button type="button" class="ghost icon" data-close aria-label="{{tr "Close"}}" title="{{tr "Close"}}"><svg class="i"><use href="#i-x"/></svg></button></div>
    <div class="dlg-body">
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <input type="search" id="searchbox" style="flex:1;min-width:220px" placeholder="{{tr "Search indexers…"}}" autocomplete="off" aria-label="{{tr "Search indexers…"}}" title="{{tr "Search configured Torznab indexers for releases"}}">
        <select id="search-sort" aria-label="{{tr "Sort results"}}" title="{{tr "Order of the search results: most seeders, largest, newest or name"}}">
          <option value="seeders">{{tr "Seeds"}}</option>
          <option value="size">{{tr "Size"}}</option>
          <option value="date">{{tr "Newest"}}</option>
          <option value="name">{{tr "Name"}}</option>
        </select>
        <button type="submit" class="primary" title="{{tr "Execute search query across configured indexers"}}">{{tr "Search"}}</button>
      </div>
      <p class="muted" id="searchinfo" style="margin:0" aria-live="polite"></p>
      <div class="results" id="searchresults"></div>
    </div>
  </form>
</dialog>
{{end}}

{{if .Standalone}}
<dialog id="browse-overlay" class="picker" data-browse-endpoint="/ui/browse-dir" aria-label="{{tr "Choose an existing folder on the server"}}">
  <div class="picker-head"><code id="browse-path"></code><button type="button" data-picker-close title="{{tr "Cancel folder selection"}}">{{tr "Cancel"}}</button></div>
  <div class="picker-list" id="browse-list"></div>
  <div class="picker-foot">
    <button type="button" data-picker-up title="{{tr "Navigate to parent directory"}}">{{tr "↑ Parent"}}</button>
    <button type="button" class="primary" data-picker-choose title="{{tr "Select the current directory as destination folder"}}">{{tr "Choose this folder"}}</button>
  </div>
</dialog>
{{end}}

<datalist id="catlist-all">{{range .Categories}}<option value="{{.}}">{{end}}</datalist>
<datalist id="savepaths"></datalist>
<div class="dropzone" id="dropzone" hidden>{{tr "Drop .torrent files to add them"}}</div>

<script id="ui-i18n"></script>
<script src="/assets/common.js"></script>
<script>
(function(){
"use strict";
function t(s){return (window.__uiI18n&&window.__uiI18n[s])||s;}
var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
var toast=function(m,e){window.gx.toast(m,e);};
var store={get:function(k,d){try{var v=localStorage.getItem('gx-'+k);return v===null?d:JSON.parse(v);}catch(e){return d;}},set:function(k,v){try{localStorage.setItem('gx-'+k,JSON.stringify(v));}catch(e){}pushPrefs(k);}};
// pushPrefs mirrors columns/filters/theme to the server (standalone), so they
// follow the operator across browsers. Best effort: managed mode has no store
// and answers 404, which is silently ignored.
var prefsTimer=null;
function pushPrefs(which){
  if(which!=='cols'&&which!=='filter'&&which!=='theme')return;
  if(prefsTimer)return;prefsTimer=setTimeout(function(){prefsTimer=null;
    try{
      var body={};
      var c=localStorage.getItem('gx-cols');if(c!==null)body.cols=JSON.parse(c);
      var f=localStorage.getItem('gx-filter');if(f!==null)body.filter=JSON.parse(f);
      var t2=localStorage.getItem('gx-theme');if(t2==='light'||t2==='dark'||t2==='auto')body.theme=t2;
      if(body.cols===undefined&&body.filter===undefined&&body.theme===undefined)return;
      fetch('/ui/uiprefs',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).catch(function(){});
    }catch(e){}
  },1000);
}
// pullPrefs fills in what this browser does not have yet from the server
// copy (another device may have saved it). Local values always win.
function pullPrefs(){
  var needCols=false,needFilter=false,needTheme=false;
  try{
    needCols=localStorage.getItem('gx-cols')===null;
    needFilter=localStorage.getItem('gx-filter')===null;
    needTheme=localStorage.getItem('gx-theme')===null;
  }catch(e){return;}
  if(!needCols&&!needFilter&&!needTheme)return;
  fetch('/ui/uiprefs',{cache:'no-store'}).then(function(r){return r.ok?r.json():null;}).then(function(p){
    if(!p)return;
    try{
      if(needCols&&p.cols!==undefined)localStorage.setItem('gx-cols',JSON.stringify(p.cols));
      if(needFilter&&p.filter!==undefined)localStorage.setItem('gx-filter',JSON.stringify(p.filter));
      if(needTheme&&(p.theme==='light'||p.theme==='dark'||p.theme==='auto'))localStorage.setItem('gx-theme',p.theme);
    }catch(e){return;}
    if(needCols&&window.gxColStyle)window.gxColStyle();
    if(needFilter&&p.filter!==undefined&&typeof p.filter==='object')state.filter=Object.assign({status:'all',cat:null,tag:null,tracker:null},p.filter);
    if(needTheme&&window.gx&&window.gx.theme)window.gx.theme.apply(window.gx.theme.read());
    renderColsMenu();afterRender();
  }).catch(function(){});
}
document.addEventListener('click',function(e){
  var sw=e.target.closest&&e.target.closest('[data-theme-switch]');
  if(sw)setTimeout(function(){pushPrefs('theme');},0);
});

var state={selected:new Set(),anchor:null,filter:Object.assign({status:'all',cat:null,tag:null,tracker:null},store.get('filter',{})),sort:store.get('sort',{key:'name',asc:true}),q:'',drawer:null,rows:window.__rows||0,collapsed:store.get('collapsed',{}),sbmore:false,allRows:[],viewRows:[],virtual:false,winStart:-1,winEnd:-1,winLen:0,rowH:0};
// virtualMinRows is where the client-side window replaces the old 300-row
// server cap: below it the simple full-DOM table is cheaper. The mobile
// layout turns rows into CSS-grid cards and a spacer row would have no
// height, so the window stays desktop-only.
var virtualMinRows=500;
function virtualAllowed(){return !(window.matchMedia&&window.matchMedia('(max-width:760px)').matches);}

// ---------- server calls ----------
function post(url,params){
  var body=params instanceof URLSearchParams?params:new URLSearchParams(params||{});
  return fetch(url,{method:'POST',body:body,headers:{'Content-Type':'application/x-www-form-urlencoded','X-GX-Fetch':'1'}})
    .then(function(r){var ct=r.headers.get('Content-Type')||'';if(ct.indexOf('application/json')>=0)return r.json();return r.text().then(function(x){return {ok:r.ok,msg:x.trim()||(r.ok?t('Done'):t('Error'))};});})
    .catch(function(e){return {ok:false,msg:t('Error')+': '+e.message};});
}
function report(res){if(res&&res.msg)toast(res.msg,!res.ok);}

// ---------- rows, selection, filters ----------
function rows(){return $$('#torrents tbody tr');}
function visibleRows(){return rows().filter(function(r){return !r.hidden;});}
function rowOf(el){return el&&el.closest?el.closest('#torrents tbody tr'):null;}
function rowByHash(h){return rows().find(function(r){return r.dataset.hash===h;});}
function dataByHash(h){
  if(state.virtual){return state.allRows.find(function(r){return r.Hash===h;})||null;}
  var r=rowByHash(h);return r?{Name:r.dataset.name,Category:r.dataset.cat,Tags:r.dataset.tags,State:r.dataset.state,AutoTMM:r.dataset.tmm==='1'}:null;
}
function selHashes(){return Array.from(state.selected);}
function renderSelection(){
  rows().forEach(function(r){var on=state.selected.has(r.dataset.hash);r.setAttribute('aria-selected',on?'true':'false');var cb=$('.rowsel',r);if(cb)cb.checked=on;});
  var n=state.selected.size;
  $('#selinfo').textContent=n?n+' '+t('selected'):'';
  $$('#toolbar [data-bulk]').forEach(function(b){b.setAttribute('aria-disabled',n?'false':'true');});
  var all=$('#selall');
  if(all){
    if(state.virtual){
      var vis=state.viewRows;
      all.checked=vis.length>0&&vis.every(function(r){return state.selected.has(r.Hash);});
    }else{
      var dom=visibleRows();
      all.checked=dom.length>0&&dom.every(function(r){return state.selected.has(r.dataset.hash);});
    }
    all.indeterminate=n>0&&!all.checked;
  }
}
function select(hash,mode){
  if(mode==='toggle'){if(state.selected.has(hash))state.selected.delete(hash);else state.selected.add(hash);}
  else if(mode==='range'&&state.anchor){var v=visibleRows().map(function(r){return r.dataset.hash;});var a=v.indexOf(state.anchor),b=v.indexOf(hash);if(a>=0&&b>=0){var lo=Math.min(a,b),hi=Math.max(a,b);for(var i=lo;i<=hi;i++)state.selected.add(v[i]);}}
  else{state.selected.clear();state.selected.add(hash);}
  if(mode!=='range')state.anchor=hash;
  renderSelection();
}
// matchStatus is the page side of the sidebar counts (uiPageData).
function matchStatus(r,f){
  var st=r.dataset.state,moving=(+r.dataset.down>0)||(+r.dataset.up>0);
  switch(f){
    case 'all':return true;
    case 'downloading':return st==='downloading'||st==='downloading_metadata'||st==='checking_files';
    case 'completed':return +r.dataset.kProgress>=100;
    case 'running':return st!=='paused'&&st!=='disk_wait';
    case 'active':return moving;
    case 'inactive':return !moving;
    case 'paused':return st==='paused'||st==='disk_wait';
    case 'checking':return st==='checking_files';
    default:return st===f;
  }
}
// matchStatusData is matchStatus on a /ui/rows JSON row (virtualised table).
function matchStatusData(r,f){
  var st=r.State,moving=(+r.DLRate>0)||(+r.ULRate>0);
  switch(f){
    case 'all':return true;
    case 'downloading':return st==='downloading'||st==='downloading_metadata'||st==='checking_files';
    case 'completed':return +r.Progress>=100;
    case 'running':return st!=='paused'&&st!=='disk_wait';
    case 'active':return moving;
    case 'inactive':return !moving;
    case 'paused':return st==='paused'||st==='disk_wait';
    case 'checking':return st==='checking_files';
    default:return st===f;
  }
}
function dataMatches(r,q,f){
  if(!matchStatusData(r,f.status))return false;
  if(f.cat!==null&&r.Category!==f.cat)return false;
  if(f.tag!==null){var tags=','+(r.Tags||'').replace(/,\s+/g,',')+',';if(f.tag===''?(r.Tags||'')!=='':tags.indexOf(','+f.tag+',')<0)return false;}
  if(f.tracker!==null&&r.Tracker!==f.tracker)return false;
  if(q&&((r.Name||'')+' '+(r.Hash||'')+' '+(r.Tracker||'')+' '+(r.Category||'')+' '+(r.Tags||'')).toLowerCase().indexOf(q)<0)return false;
  return true;
}
var dataSortKeys={name:'Name',size:'TotalSize',progress:'Progress',state:'State',seeds:'Seeds',peers:'Peers',down:'DLRate',up:'ULRate',eta:'ETAVal',ratio:'RatioVal',category:'Category',tags:'Tags',added:'AddedVal',completed:'CompletedVal',downloaded:'DownloadedVal',uploaded:'UploadedVal',remaining:'RemainingVal',queue:'QueuePos',tracker:'Tracker',path:'SavePath',availability:'AvailabilityVal',active:'ActiveVal',lastactive:'LastActiveVal',wasted:'WastedVal'};
function sortData(list){
  var s=state.sort,key=dataSortKeys[s.key]||'Name';
  list.sort(function(a,b){
    var av=a[key],bv=b[key];
    if(av===undefined||av===null)av='';
    if(bv===undefined||bv===null)bv='';
    var an=parseFloat(av),bn=parseFloat(bv),r;
    r=(!isNaN(an)&&!isNaN(bn)&&av!==''&&bv!=='')?an-bn:String(av).localeCompare(String(bv),undefined,{sensitivity:'base',numeric:true});
    return s.asc?r:-r;
  });
}
function applyDataView(force){
  var q=state.q.toLowerCase(),f=state.filter;
  var view=[];
  for(var i=0;i<state.allRows.length;i++){if(dataMatches(state.allRows[i],q,f))view.push(state.allRows[i]);}
  sortData(view);
  state.viewRows=view;
  state.winStart=-1;state.winEnd=-1;
  renderVirtual(!!force);
  filterChrome(view.length);
  // A selection follows what the filter shows: off-screen rows stay selected,
  // rows hidden by the filter do not.
  var shown=new Set(view.map(function(r){return r.Hash;}));
  state.selected.forEach(function(h){if(!shown.has(h))state.selected.delete(h);});
  renderSelection();
}
// filterChrome updates the sidebar pressed states and the empty note from the
// number of matching rows (shared by the plain and the virtual table).
function filterChrome(shown){
  var f=state.filter;
  function press(sel,attr,val){$$(sel).forEach(function(b){var v=b.hasAttribute('data-all')?null:b.getAttribute(attr);b.setAttribute('aria-pressed',v===val?'true':'false');});}
  press('#side [data-status]','data-status',f.status);
  press('#side [data-catbtn]','data-cat',f.cat);
  press('#side [data-tagbtn]','data-tag',f.tag);
  press('#side [data-trkbtn]','data-tracker',f.tracker);
  var total=state.virtual?state.allRows.length:rows().length;
  var empty=$('#filtered-empty');if(empty)empty.hidden=shown>0||total===0;
}
// renderVirtual keeps only the rows around the viewport in the DOM, with a
// spacer row before and after them, so a session of thousands of torrents
// scrolls and refreshes like a short one.
function renderVirtual(force){
  var tb=$('#torrent-rows');if(!tb)return;
  var view=state.viewRows||[];
  var rowH=state.rowH||38;
  // The table scrolls inside .listwrap, not with the page. Measure that
  // viewport; fall back to the page when the shell uses a different layout.
  var scroller=tb.closest('.listwrap');
  var offset=0,viewHeight=window.innerHeight;
  if(scroller){
    var sr=scroller.getBoundingClientRect();
    offset=sr.top-tb.getBoundingClientRect().top;
    viewHeight=scroller.clientHeight;
  }else{
    offset=window.scrollY-(tb.getBoundingClientRect().top+window.scrollY);
  }
  var start=Math.max(0,Math.floor(offset/rowH)-15);
  if(start>view.length)start=view.length;
  var end=Math.min(view.length,Math.ceil((offset+viewHeight)/rowH)+15);
  if(end<start)end=start;
  if(end-start<40)end=Math.min(view.length,start+40);
  if(!force&&start===state.winStart&&end===state.winEnd&&view.length===state.winLen)return;
  var cols=$$('#torrents thead th').length||1;
  var html='';
  if(start>0)html+='<tr class="vpad" aria-hidden="true"><td colspan="'+cols+'" style="height:'+(start*rowH)+'px;padding:0;border:0"></td></tr>';
  for(var i=start;i<end;i++)html+=rowHTML(view[i]);
  if(end<view.length)html+='<tr class="vpad" aria-hidden="true"><td colspan="'+cols+'" style="height:'+((view.length-end)*rowH)+'px;padding:0;border:0"></td></tr>';
  tb.innerHTML=html;
  var table=tb.closest('table');
  if(table){table.setAttribute('aria-rowcount',String(view.length+1));}
  var rendered=tb.querySelectorAll('tr[data-hash]');
  for(var n=0;n<rendered.length;n++){rendered[n].setAttribute('aria-rowindex',String(start+n+2));}
  renderSelection();
  state.winStart=start;state.winEnd=end;state.winLen=view.length;
  // The first real row gives the exact height, so the spacers stay aligned
  // after a theme or zoom change.
  var first=tb.querySelector('tr[data-hash]');
  if(first){var h=first.getBoundingClientRect().height;if(h>10&&Math.abs(h-state.rowH)>1){state.rowH=h;state.winStart=-1;renderVirtual(false);}}
}
var virtualScrollFrame=0;
// Scroll events do not bubble: capture them so the .listwrap container is
// heard, while the window remains a fallback for a non-scrolling shell.
document.addEventListener('scroll',function(e){
  if(!state.virtual||virtualScrollFrame)return;
  if(e.target&&e.target!==document&&e.target!==window&&!(e.target.classList&&e.target.classList.contains('listwrap')))return;
  virtualScrollFrame=requestAnimationFrame(function(){virtualScrollFrame=0;renderVirtual(false);});
},true);

function resetVirtualScroll(){
  var tb=$('#torrent-rows');
  var sc=tb&&tb.closest('.listwrap');
  if(sc)sc.scrollTop=0;
}
function applyFilters(){
  if(state.virtual){resetVirtualScroll();applyDataView(true);return;}
  var q=state.q.toLowerCase(),f=state.filter,shown=0;
  rows().forEach(function(r){
    var ok=matchStatus(r,f.status)&&(f.cat===null||r.dataset.cat===f.cat)
      &&(f.tag===null||(f.tag===''?!r.dataset.tags:(','+r.dataset.tags.replace(/,\s+/g,',')+',').indexOf(','+f.tag+',')>=0))
      &&(f.tracker===null||r.dataset.tracker===f.tracker)
      &&(!q||(r.dataset.name+' '+r.dataset.hash+' '+r.dataset.tracker+' '+r.dataset.cat+' '+r.dataset.tags).toLowerCase().indexOf(q)>=0);
    r.hidden=!ok;if(ok)shown++;
  });
  filterChrome(shown);
  // Selection follows what is visible.
  state.selected.forEach(function(h){var r=rowByHash(h);if(!r||r.hidden)state.selected.delete(h);});
  renderSelection();
}
function sideRows(){
  if(state.virtual)return state.allRows;
  return rows().map(function(r){return {Category:r.dataset.cat,Tags:r.dataset.tags};});
}
function countSide(){
  // Category and tag counts are computed here, from the rows.
  var cats={},tags={},untagged=0;
  sideRows().forEach(function(r){cats[r.Category]=(cats[r.Category]||0)+1;var any=false;(r.Tags||'').split(',').forEach(function(tg){tg=tg.trim();if(tg){any=true;tags[tg]=(tags[tg]||0)+1;}});if(!any)untagged++;});
  $$('#side [data-catbtn]:not([data-all])').forEach(function(b){var n=$('.n',b);if(n)n.textContent=cats[b.dataset.cat]||0;});
  $$('#side [data-tagbtn]:not([data-all])').forEach(function(b){var n=$('.n',b);if(n)n.textContent=b.dataset.tag===''?untagged:(tags[b.dataset.tag]||0);});
  $$('#side .flist button .n').forEach(function(n){n.parentNode.classList.toggle('zero',n.textContent==='0');});
}
function applyCollapsed(){
  $$('#side [data-sec]').forEach(function(b){var shut=!!state.collapsed[b.dataset.sec];b.setAttribute('aria-expanded',shut?'false':'true');var list=document.getElementById(b.getAttribute('aria-controls'));if(list)list.hidden=shut;});
}
function applySort(){
  if(state.virtual){
    applyDataView(true);
    $$('#torrents th[data-sort]').forEach(function(th){th.setAttribute('aria-sort',th.dataset.sort===state.sort.key?(state.sort.asc?'ascending':'descending'):'none');});
    return;
  }
  var s=state.sort,tb=$('#torrents tbody');if(!tb)return;
  var list=rows(),key='k'+s.key.charAt(0).toUpperCase()+s.key.slice(1);
  list.sort(function(a,b){var av=a.dataset[key]||'',bv=b.dataset[key]||'';var an=parseFloat(av),bn=parseFloat(bv);var r=(!isNaN(an)&&!isNaN(bn)&&av!==''&&bv!=='')?an-bn:String(av).localeCompare(String(bv),undefined,{sensitivity:'base',numeric:true});return s.asc?r:-r;});
  list.forEach(function(r){tb.appendChild(r);});
  $$('#torrents th[data-sort]').forEach(function(th){th.setAttribute('aria-sort',th.dataset.sort===s.key?(s.asc?'ascending':'descending'):'none');});
}
function setSort(key){var s=state.sort;state.sort={key:key,asc:s.key===key?!s.asc:true};store.set('sort',state.sort);if(state.virtual)resetVirtualScroll();applySort();}

// ---------- columns: chooser and widths ----------
function colPrefs(){return store.get('cols',{});}
function colDefault(k){var c=window.__gxCols.find(function(x){return x[0]===k;});return c||[k,1,90];}
function colOn(k){var p=colPrefs()[k]||{};return p.on===undefined?!!colDefault(k)[1]:!!p.on;}
function setCol(k,patch){var p=colPrefs();p[k]=Object.assign({},p[k]||{},patch);store.set('cols',p);window.gxColStyle();renderColsMenu();syncResizers();}
// syncResizers tells assistive technology each column's width.
function syncResizers(){$$('#torrents th .rz').forEach(function(h){h.setAttribute('aria-valuenow',Math.round(h.closest('th').getBoundingClientRect().width));});}
