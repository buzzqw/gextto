// tableShell rebuilds an empty table keeping the server-rendered header (and
// the translated "no match" note, both captured at boot): only the rows are
// ever replaced.
function tableShell(){
  var t=$('#torrents');
  var open=t?(' class="'+t.className+'" id="torrents" role="'+t.getAttribute('role')+'" aria-multiselectable="'+t.getAttribute('aria-multiselectable')+'" aria-label="'+esc(t.getAttribute('aria-label'))+'"'):' class="tbl t" id="torrents" role="grid" aria-multiselectable="true" aria-label="Torrents"';
  return '<table'+open+'>'+(window.__thead||'')+'<tbody id="torrent-rows"></tbody></table>'+(window.__filteredEmpty||'');
}
// legacyTable swaps the server-rendered table HTML (translated empty states,
// paging, header): the fallback for an empty session, a limited window, or a
// boot without a captured header.
function legacyTable(){
  return fetch('/ui/live'+(state.rows?'?rows='+state.rows:''),{cache:'no-store'}).then(function(r){return r.ok?r.text():null;}).then(function(html){
    if(!html)return;
    var box=document.createElement('div');box.innerHTML=html;
    var live=$('#frag-live',box);
    if(live)applyLive(live);
    captureTableChrome();
  });
}
// captureTableChrome remembers the server-rendered header (and the translated
// "no match" note) so later refreshes only replace the rows.
function captureTableChrome(){
  try{
    var th=$('#torrents thead');if(th)window.__thead=th.outerHTML;
    var fe=$('#filtered-empty');if(fe)window.__filteredEmpty=fe.outerHTML;
  }catch(e){}
}
// updateTable swaps the rows from /ui/rows. An empty session or a limited
// window (paging) still uses the server HTML, which owns the translated empty
// states and the "show more" row.
function updateTable(data){
  var rows=data.Rows||[];
  if(!rows.length||data.RowsLimited||!window.__thead){
    state.virtual=false;state.allRows=[];state.viewRows=[];state.winStart=-1;state.winEnd=-1;state.winLen=0;
    var old=$('#torrents');if(old)old.removeAttribute('aria-rowcount');
    return legacyTable();
  }
  var tb=$('#torrent-rows');
  if(!tb){$('#live').innerHTML=tableShell();tb=$('#torrent-rows');}
  if(!tb)return Promise.resolve();
  // The server can return the whole session (?rows=all): above the old
  // 300-row window the table is virtualised client-side, so the DOM keeps
  // only the rows near the viewport. Small sessions keep the simple path.
  state.allRows=rows;
  state.virtual=rows.length>virtualMinRows&&virtualAllowed();
  var more=$('#live .more-rows');if(more&&!data.RowsLimited)more.remove();
  if(!state.virtual){state.viewRows=rows;state.winStart=-1;state.winEnd=-1;var table=tb.closest('table');if(table)table.removeAttribute('aria-rowcount');tb.innerHTML=rows.map(rowHTML).join('');return Promise.resolve();}
  applyDataView(true);
  return Promise.resolve();
}
var refreshing=false,lastSide='',pointerDown=false;
document.addEventListener('mousedown',function(){pointerDown=true;});
document.addEventListener('mouseup',function(){pointerDown=false;});
window.addEventListener('blur',function(){pointerDown=false;});
// applyLive updates the table in place: only the rows change, while the static
// header (and its Select all checkbox) is kept. Replacing the whole table every
// 2s destroyed the checkbox under the user's click, so selecting all torrents
// was hard. Falls back to a full swap when the table appears or disappears.
function applyLive(frag){
  var cur=$('#torrents'),next=$('#torrents',frag);
  if(cur&&next&&cur.tBodies.length&&next.tBodies.length){
    cur.tBodies[0].innerHTML=next.tBodies[0].innerHTML;
    var curMore=$('#live .more-rows'),nextMore=$('.more-rows',frag);
    if(nextMore){if(curMore)curMore.outerHTML=nextMore.outerHTML;else $('#live').appendChild(nextMore);}
    else if(curMore)curMore.remove();
    return;
  }
  $('#live').innerHTML=frag.innerHTML;
}
function refresh(){
  if(refreshing||document.hidden||pointerDown||resizing)return;refreshing=true;
  var active=document.activeElement,activeRow=rowOf(active),activeHash=activeRow&&activeRow.dataset.hash;
  // Desktop asks for the whole session and virtualises it; the mobile layout
  // keeps the old paged window (300 rows + Show more), because a CSS-grid card
  // cannot use the spacer rows the windowing relies on.
  var rowsParam=virtualAllowed()?'?rows=all':(state.rows?('?rows='+state.rows):'');
  // The rows travel as JSON (small, no chrome rebuild); the filters, speeds
  // and status travel as HTML (server-translated). Both derive from the same
  // snapshot, so they never disagree.
  var rowsP=fetch('/ui/rows'+rowsParam,{cache:'no-store'}).then(function(r){return r.ok?r.json():null;}).catch(function(){return null;});
  var chromeP=fetch('/ui/live?notable=1'+(state.rows?('&rows='+state.rows):''),{cache:'no-store'}).then(function(r){return r.ok?r.text():null;}).catch(function(){return null;});
  Promise.all([rowsP,chromeP]).then(function(pair){
    var data=pair[0],html=pair[1];
    if(!data||!html)return Promise.resolve();
    var box=document.createElement('div');box.innerHTML=html;
    var side=$('#frag-side',box),status=$('#frag-status',box),speeds=$('#frag-speeds',box),more=$('#frag-sbmore',box);
    // Never touch the DOM while the pointer is down: a click spans mousedown and
    // mouseup, and a replacement in between loses it.
    var tableP=Promise.resolve();
    if(!pointerDown){
      tableP=updateTable(data);
      if(side&&side.innerHTML!==lastSide){var focusKey=document.activeElement&&document.activeElement.closest&&document.activeElement.closest('#side-live')&&focusKeyOf(document.activeElement);lastSide=side.innerHTML;$('#side-live').innerHTML=side.innerHTML;if(focusKey){var back=$(focusKey);if(back)back.focus();}}
      if(status){var sbFocus=$('#statusbar').contains(document.activeElement)?(document.activeElement.id?'#'+document.activeElement.id:document.activeElement.hasAttribute('data-global-limits')?'[data-global-limits]':document.activeElement.hasAttribute('data-alt-speed')?'[data-alt-speed]':null):null;$('#statusbar').innerHTML=status.innerHTML;if(sbFocus){var sbEl=$('#statusbar '+sbFocus);if(sbEl)sbEl.focus();}}
      if(speeds)$('#top-speeds').innerHTML=speeds.innerHTML;
      if(more)$('#sb-more').innerHTML=more.innerHTML;
    }
    return tableP;
  }).then(function(){
    afterRender();
    if(activeHash){var r=rowByHash(activeHash);if(r){r.tabIndex=0;r.focus({preventScroll:true});}}
    sampleGraph();
  }).catch(function(){}).then(function(){refreshing=false;});
}
// focusKeyOf finds the sidebar button again after the sidebar is redrawn.
function focusKeyOf(el){
  var b=el.closest('button');if(!b)return null;
  var attrs=['data-sec','data-status','data-cat','data-tag','data-tracker'];
  for(var i=0;i<attrs.length;i++){var v=b.getAttribute(attrs[i]);if(v!==null)return '#side-live ['+attrs[i]+'="'+v.replace(/"/g,'\\"')+'"]'+(b.hasAttribute('data-all')?'[data-all]':':not([data-all])');}
  return null;
}
function afterRender(){
  if(state.virtual){
    var known=new Set(state.allRows.map(function(r){return r.Hash;}));
    state.selected.forEach(function(h){if(!known.has(h))state.selected.delete(h);});
    countSide();applyCollapsed();applySort();roving();savePaths();syncResizers();
  }else{
    var known2=new Set(rows().map(function(r){return r.dataset.hash;}));
    state.selected.forEach(function(h){if(!known2.has(h))state.selected.delete(h);});
    countSide();applyCollapsed();applySort();applyFilters();roving();savePaths();syncResizers();
  }
  var sb=$('#sb-more-btn');if(sb)sb.setAttribute('aria-expanded',state.sbmore?'true':'false');
}
function roving(){var rs=visibleRows(),cur=rs.find(function(r){return r.tabIndex===0;});rs.forEach(function(r){r.tabIndex=-1;});(cur||rs[0])&&((cur||rs[0]).tabIndex=0);}
function savePaths(){var dl=$('#savepaths'),seen={},html='';var list=state.virtual?state.allRows.map(function(r){return {p:r.SavePath};}):rows().map(function(r){return {p:r.dataset.kPath};});list.forEach(function(r){var p=r.p;if(p&&!seen[p]){seen[p]=1;var o=document.createElement('option');o.value=p;html+=o.outerHTML;}});dl.innerHTML=html;}

// ---------- transfer graph and window title ----------
var samples=[];
// tHist keeps each torrent's last 120 speed samples (four minutes at the
// two-second refresh) for the Speed tab. Only torrents that moved data are
// kept, at most tHistMax, so a session of thousands costs nothing.
var tHist=new Map(),tHistLen=120,tHistMax=300;
function sampleTorrents(){
  var list=state.virtual?state.allRows.map(function(r){return [r.Hash,+r.DLRate||0,+r.ULRate||0];}):rows().map(function(r){return [r.dataset.hash,+r.dataset.down||0,+r.dataset.up||0];});
  list.forEach(function(x){
    var h=tHist.get(x[0]);
    if(!h){if(!x[1]&&!x[2])return;h=[];tHist.set(x[0],h);}
    h.push([x[1],x[2]]);if(h.length>tHistLen)h.shift();
  });
  if(tHist.size>tHistMax){
    for(var k of tHist.keys()){if(tHist.size<=tHistMax)break;var hh=tHist.get(k);if(!hh[hh.length-1][0]&&!hh[hh.length-1][1])tHist.delete(k);}
  }
  drawTorrentGraph();
}
function drawTorrentGraph(){
  var g=$('#tgraph');if(!g)return;
  var h=tHist.get(g.dataset.hash)||[];
  var n=tHistLen,w=300,ht=80;
  var max=Math.max(1024,Math.max.apply(null,h.map(function(s){return Math.max(s[0],s[1]);}).concat([0])));
  function path(i){return h.map(function(s,k){var x=(w*(n-h.length+k)/(n-1)).toFixed(1),y=(ht-2-(ht-4)*s[i]/max).toFixed(1);return (k?'L':'M')+x+' '+y;}).join(' ');}
  var d=path(0),u=path(1);
  $('#tg-d').setAttribute('d',d);$('#tg-u').setAttribute('d',u);
  if(h.length>1){var x0=(w*(n-h.length)/(n-1)).toFixed(1);$('#tg-da').setAttribute('d',d+' L'+w+' '+ht+' L'+x0+' '+ht+' Z');}
  var row=state.virtual?state.allRows.find(function(r){return r.Hash===g.dataset.hash;}):null,dom=row?null:rowByHash(g.dataset.hash);
  var down=row?row.DLRate:(dom?+dom.dataset.down:0),up=row?row.ULRate:(dom?+dom.dataset.up:0);
  $('#tg-dl').textContent='↓ '+fmtRate(down);$('#tg-ul').textContent='↑ '+fmtRate(up);
  var pd=0,pu=0;h.forEach(function(s){pd=Math.max(pd,s[0]);pu=Math.max(pu,s[1]);});
  $('#tg-peak').textContent=h.length?t('Highest')+': ↓ '+fmtRate(pd)+' · ↑ '+fmtRate(pu):t('No transfer seen yet: the graph fills while the torrent moves data.');
}
// fmtRate writes a speed like the server's rate (1024 steps, two decimals).
function fmtRate(b){b=+b||0;if(b<=0)return '—';var u=['B','KB','MB','GB','TB'],i=0;while(b>=1024&&i<u.length-1){b/=1024;i++;}return (i?b.toFixed(2):Math.round(b))+' '+u[i]+'/s';}
function sampleGraph(){
  sampleTorrents();
  var st=$('#statusbar [data-down]');if(!st)return;
  samples.push([+st.dataset.down||0,+st.dataset.up||0]);if(samples.length>60)samples.shift();
  var max=Math.max(1024,Math.max.apply(null,samples.map(function(s){return Math.max(s[0],s[1]);})));
  var n=60,w=120,h=40;
  function path(i){return samples.map(function(s,k){var x=(w*(n-samples.length+k)/(n-1)).toFixed(1),y=(h-2-(h-4)*s[i]/max).toFixed(1);return (k?'L':'M')+x+' '+y;}).join(' ');}
  var d=path(0),u=path(1);
  $('#g-d').setAttribute('d',d);$('#g-u').setAttribute('d',u);
  if(samples.length>1){var x0=(w*(n-samples.length)/(n-1)).toFixed(1);$('#g-da').setAttribute('d',d+' L'+w+' '+h+' L'+x0+' '+h+' Z');}
  $('#g-dl').textContent='↓ '+(st.dataset.downS||'');$('#g-ul').textContent='↑ '+(st.dataset.upS||'');
  // Like qBittorrent, the speeds are in the tab title too.
  document.title='↓ '+(st.dataset.downS||'')+' ↑ '+(st.dataset.upS||'')+' · gx-torrent';
}

// ---------- undo remove ----------
// After a remove that keeps the files, the magnets are fetched first so the
// torrents can come back with one click until the countdown runs out.
var undoState=null,undoTimer=null;
function hideUndo(){undoState=null;if(undoTimer){clearInterval(undoTimer);undoTimer=null;}var b=$('#undo-bar');if(b)b.hidden=true;}
function showUndo(items){
  hideUndo();if(!items.length)return;
  undoState={items:items,left:8};
  var b=$('#undo-bar');if(!b)return;
  $('#undo-text').textContent=items.length+' '+t('torrents removed')+' ('+undoState.left+'s)';b.hidden=false;
  undoTimer=setInterval(function(){if(!undoState){return;}undoState.left--;if(undoState.left<=0){hideUndo();return;}$('#undo-text').textContent=undoState.items.length+' '+t('torrents removed')+' ('+undoState.left+'s)';},1000);
}
function snapshotForUndo(hashes){
  return hashes.map(function(h){
    if(state.virtual&&state.allRows){var d=state.allRows.find(function(r){return r.Hash===h;});return d?{hash:h,dest:d.SavePath||'',cat:d.Category||'',tags:d.Tags||''}:null;}
    var r=rowByHash(h);return r?{hash:h,dest:r.dataset.kPath||'',cat:r.dataset.cat||'',tags:r.dataset.tags||''}:null;
  }).filter(Boolean);
}
function fetchMagnets(snap){
  Promise.all(snap.map(function(s){return fetch('/ui/magnet?hash='+encodeURIComponent(s.hash),{cache:'no-store'}).then(function(r){return r.ok?r.text():null;}).then(function(m){s.magnet=(m||'').trim();return s;}).catch(function(){return s;});})).then(function(items){
    showUndo(items.filter(function(s){return !!s.magnet;}));
  });
}
function doUndo(){
  var st=undoState;hideUndo();if(!st)return;
  var jobs=st.items.map(function(s){var p=new URLSearchParams();p.set('source',s.magnet);if(s.dest)p.set('destination',s.dest);if(s.cat)p.set('category',s.cat);if(s.tags)p.set('tags',s.tags);p.set('paused','1');return post('/ui/add',p);});
  Promise.all(jobs).then(function(res){var ok=0;res.forEach(function(r){if(r&&r.ok)ok++;});toast(ok+' '+t('torrent(s) added'),false);refresh();});
}

// ---------- actions ----------
function bulk(op,hashes){
  hashes=hashes||selHashes();
  if(!hashes.length){toast(t('Select at least one torrent'),true);return Promise.resolve();}
  var f=new URLSearchParams();f.set('op',op);hashes.forEach(function(h){f.append('hashes',h);});
  return post('/ui/bulk',f).then(function(res){report(res);refresh();});
}
function whatSelected(hashes){
  if(hashes.length===1){var r=dataByHash(hashes[0]);return r?r.Name:'';}
  return hashes.length+' '+t('torrents selected');
}
function askRemove(hashes){
  hashes=hashes||selHashes();
  if(!hashes.length){toast(t('Select at least one torrent'),true);return;}
  var dlg=$('#dlg-remove');dlg._hashes=hashes;
  $('#remove-what').textContent=hashes.length===1?whatSelected(hashes):hashes.length+' '+t('torrents will be removed.');
  $('#remove-files').checked=false;openDialog(dlg);
}
function copyText(text,done){
  if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(text).then(function(){toast(done,false);}).catch(function(){window.prompt(t('Copy'),text);});
  window.prompt(t('Copy'),text);
}
function copyMagnet(hash){
  fetch('/ui/magnet?hash='+encodeURIComponent(hash),{cache:'no-store'}).then(function(r){return r.ok?r.text():Promise.reject(new Error(r.status));}).then(function(m){copyText(m,t('Magnet copied'));}).catch(function(){toast(t('Copy failed'),true);});
