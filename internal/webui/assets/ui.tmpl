    case 'magnet':copyMagnet(hashes[0]);break;
    case 'copy-name':copyText(hashes.map(function(h){var r=rowByHash(h);return r?r.dataset.name:h;}).join('\n'),t('Copied'));break;
    case 'copy-hash':copyText(hashes.join('\n'),t('Copied'));break;
    case 'export':window.location.href='/ui/torrent-file?hash='+encodeURIComponent(hashes[0]);break;
    case 'category':editCategory(hashes);break;
    case 'rename':renameTorrentDialog(hashes);break;
    case 'location':locationDialog(hashes);break;
    case 'limits':limitsDialog(hashes);break;
    case 'force':toggleFlag(hashes,'pin','force-start','unforce');break;
    case 'tmm':toggleFlag(hashes,'tmm','tmm-on','tmm-off');break;
    case 'superseed':toggleFlag(hashes,'ss','super-seed-on','super-seed-off');break;
    case 'sequential':toggleFlag(hashes,'seq','sequential','sequential',true);break;
    case 'firstlast':toggleFlag(hashes,'fl','first-last','first-last',true);break;
