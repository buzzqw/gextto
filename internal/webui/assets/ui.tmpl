<script id="ui-i18n"></script>
<script src="/assets/common.js"></script>
<script>
(function(){
"use strict";
function t(s){return (window.__uiI18n&&window.__uiI18n[s])||s;}
var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
var toast=function(m,e){window.gx.toast(m,e);};
var store={get:function(k,d){try{var v=localStorage.getItem('gx-'+k);return v===null?d:JSON.parse(v);}catch(e){return d;}},set:function(k,v){try{localStorage.setItem('gx-'+k,JSON.stringify(v));}catch(e){}}};

var state={selected:new Set(),anchor:null,filter:store.get('filter',{status:'all',cat:null,tag:null}),sort:store.get('sort',{key:'name',asc:true}),q:'',drawer:null,rows:window.__rows||0};

// ---------- server calls ----------
function post(url,params){
  var body=params instanceof URLSearchParams?params:new URLSearchParams(params||{});
  return fetch(url,{method:'POST',body:body,headers:{'Content-Type':'application/x-www-form-urlencoded','X-GX-Fetch':'1'}})
    .then(function(r){var ct=r.headers.get('Content-Type')||'';if(ct.indexOf('application/json')>=0)return r.json();return r.text().then(function(x){return {ok:r.ok,msg:x.trim()||(r.ok?t('Done'):t('Error'))};});})
    .catch(function(e){return {ok:false,msg:t('Error')+': '+e.message};});
}
function report(res){if(res&&res.msg)toast(res.msg,!res.ok);}

// ---------- rows, selection, filters ----------
function rows(){return $$('#torrents tbody tr');}
function visibleRows(){return rows().filter(function(r){return !r.hidden;});}
function rowOf(el){return el&&el.closest?el.closest('#torrents tbody tr'):null;}
function selHashes(){return Array.from(state.selected);}
function renderSelection(){
  rows().forEach(function(r){var on=state.selected.has(r.dataset.hash);r.setAttribute('aria-selected',on?'true':'false');var cb=$('.rowsel',r);if(cb)cb.checked=on;});
  var n=state.selected.size;
  $('#selinfo').textContent=n?n+' '+t('selected'):'';
  $$('#toolbar [data-bulk]').forEach(function(b){b.setAttribute('aria-disabled',n?'false':'true');});
  var all=$('#selall');if(all){var vis=visibleRows();all.checked=vis.length>0&&vis.every(function(r){return state.selected.has(r.dataset.hash);});all.indeterminate=n>0&&!all.checked;}
}
function select(hash,mode){
  if(mode==='toggle'){if(state.selected.has(hash))state.selected.delete(hash);else state.selected.add(hash);}
  else if(mode==='range'&&state.anchor){var v=visibleRows().map(function(r){return r.dataset.hash;});var a=v.indexOf(state.anchor),b=v.indexOf(hash);if(a>=0&&b>=0){var lo=Math.min(a,b),hi=Math.max(a,b);for(var i=lo;i<=hi;i++)state.selected.add(v[i]);}}
  else{state.selected.clear();state.selected.add(hash);}
  if(mode!=='range')state.anchor=hash;
  renderSelection();
}
function matchStatus(r,f){
  var st=r.dataset.state;
  switch(f){
    case 'all':return true;
    case 'downloading':return st==='downloading'||st==='downloading_metadata'||st==='checking_files';
    case 'active':return (+r.dataset.down>0)||(+r.dataset.up>0);
    case 'paused':return st==='paused'||st==='disk_wait';
    default:return st===f;
  }
}
function applyFilters(){
  var q=state.q.toLowerCase(),f=state.filter,shown=0;
  rows().forEach(function(r){
    var ok=matchStatus(r,f.status)&&(f.cat===null||r.dataset.cat===f.cat)&&(f.tag===null||(','+r.dataset.tags+',').indexOf(','+f.tag+',')>=0)&&(!q||(r.dataset.name+' '+r.dataset.cat+' '+r.dataset.tags).toLowerCase().indexOf(q)>=0);
    r.hidden=!ok;if(ok)shown++;
  });
  $$('#side [data-status]').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.status===f.status?'true':'false');});
  $$('#side [data-cat]').forEach(function(b){var v=b.dataset.cat==='\u0000'?null:b.dataset.cat;b.setAttribute('aria-pressed',v===f.cat&&b.hasAttribute('data-catbtn')?'true':'false');});
  $$('#side [data-tag]').forEach(function(b){b.setAttribute('aria-pressed',b.dataset.tag===f.tag?'true':'false');});
  var empty=$('#filtered-empty');if(empty)empty.hidden=shown>0||rows().length===0;
  // Selection follows what is visible.
  state.selected.forEach(function(h){var r=rows().find(function(x){return x.dataset.hash===h;});if(!r||r.hidden)state.selected.delete(h);});
  renderSelection();
}
function countSide(){
  // Active and category/tag counts are computed here, from the rows.
  var active=0,cats={},tags={};
  rows().forEach(function(r){if((+r.dataset.down>0)||(+r.dataset.up>0))active++;cats[r.dataset.cat]=(cats[r.dataset.cat]||0)+1;(r.dataset.tags||'').split(',').forEach(function(tg){tg=tg.trim();if(tg)tags[tg]=(tags[tg]||0)+1;});});
  var a=$('#side [data-status="active"] .n');if(a)a.textContent=active;
  $$('#side [data-catbtn]').forEach(function(b){var n=$('.n',b);if(n)n.textContent=cats[b.dataset.cat]||0;});
  $$('#side [data-tag]').forEach(function(b){var n=$('.n',b);if(n)n.textContent=tags[b.dataset.tag]||0;});
  var none=$('#side [data-cat=""] .n');if(none)none.textContent=cats['']||0;
}
function applySort(){
  var s=state.sort,tb=$('#torrents tbody');if(!tb)return;
  var list=rows(),key='k'+s.key.charAt(0).toUpperCase()+s.key.slice(1);
  list.sort(function(a,b){var av=a.dataset[key]||'',bv=b.dataset[key]||'';var an=parseFloat(av),bn=parseFloat(bv);var r=(!isNaN(an)&&!isNaN(bn)&&av!==''&&bv!=='')?an-bn:String(av).localeCompare(String(bv),undefined,{sensitivity:'base',numeric:true});return s.asc?r:-r;});
  list.forEach(function(r){tb.appendChild(r);});
  $$('#torrents th[data-sort]').forEach(function(th){th.setAttribute('aria-sort',th.dataset.sort===s.key?(s.asc?'ascending':'descending'):'none');});
}
function setSort(key){var s=state.sort;state.sort={key:key,asc:s.key===key?!s.asc:true};store.set('sort',state.sort);applySort();}

// ---------- live refresh ----------
var refreshing=false,lastSide='',pointerDown=false;
document.addEventListener('mousedown',function(){pointerDown=true;});
document.addEventListener('mouseup',function(){pointerDown=false;});
window.addEventListener('blur',function(){pointerDown=false;});
// applyLive updates the table in place: only the rows change, while the static
// header (and its Select all checkbox) is kept. Replacing the whole table every
// 2s destroyed the checkbox under the user's click, so selecting all torrents
// was hard. Falls back to a full swap when the table appears or disappears.
function applyLive(frag){
  var cur=$('#torrents'),next=$('#torrents',frag);
  if(cur&&next&&cur.tBodies.length&&next.tBodies.length){
    cur.tBodies[0].innerHTML=next.tBodies[0].innerHTML;
    var curMore=$('#live .more-rows'),nextMore=$('.more-rows',frag);
    if(nextMore){if(curMore)curMore.outerHTML=nextMore.outerHTML;else $('#live').appendChild(nextMore);}
    else if(curMore)curMore.remove();
    return;
  }
  $('#live').innerHTML=frag.innerHTML;
}
function refresh(){
  if(refreshing||document.hidden||pointerDown)return;refreshing=true;
  var active=document.activeElement,activeRow=rowOf(active),activeHash=activeRow&&activeRow.dataset.hash;
  fetch('/ui/live'+(state.rows?'?rows='+state.rows:''),{cache:'no-store'}).then(function(r){return r.ok?r.text():null;}).then(function(html){
    if(!html)return;
    var box=document.createElement('div');box.innerHTML=html;
    var live=$('#frag-live',box),side=$('#frag-side',box),status=$('#frag-status',box),speeds=$('#frag-speeds',box);
    // Never touch the DOM while the pointer is down: a click spans mousedown and
    // mouseup, and a replacement in between loses it.
    if(!pointerDown){
      if(live)applyLive(live);
      if(side&&side.innerHTML!==lastSide){lastSide=side.innerHTML;$('#side-live').innerHTML=side.innerHTML;}
      if(status)$('#statusbar').innerHTML=status.innerHTML;
      if(speeds)$('#top-speeds').innerHTML=speeds.innerHTML;
    }
    afterRender();
    if(activeHash){var r=rows().find(function(x){return x.dataset.hash===activeHash;});if(r){r.tabIndex=0;r.focus({preventScroll:true});}}
    sampleGraph();
  }).catch(function(){}).then(function(){refreshing=false;});
}
function afterRender(){
  var known=new Set(rows().map(function(r){return r.dataset.hash;}));
  state.selected.forEach(function(h){if(!known.has(h))state.selected.delete(h);});
  countSide();applySort();applyFilters();roving();savePaths();
}
function roving(){var rs=visibleRows(),cur=rs.find(function(r){return r.tabIndex===0;});rs.forEach(function(r){r.tabIndex=-1;});(cur||rs[0])&&((cur||rs[0]).tabIndex=0);}
function savePaths(){var dl=$('#savepaths'),seen={},html='';rows().forEach(function(r){var p=r.dataset.path;if(p&&!seen[p]){seen[p]=1;var o=document.createElement('option');o.value=p;html+=o.outerHTML;}});dl.innerHTML=html;}

// ---------- transfer graph ----------
var samples=[];
function sampleGraph(){
  var st=$('#statusbar [data-down]');if(!st)return;
  samples.push([+st.dataset.down||0,+st.dataset.up||0]);if(samples.length>60)samples.shift();
  var max=Math.max(1024,Math.max.apply(null,samples.map(function(s){return Math.max(s[0],s[1]);})));
  var n=60,w=120,h=40;
  function path(i){return samples.map(function(s,k){var x=(w*(n-samples.length+k)/(n-1)).toFixed(1),y=(h-2-(h-4)*s[i]/max).toFixed(1);return (k?'L':'M')+x+' '+y;}).join(' ');}
  var d=path(0),u=path(1);
  $('#g-d').setAttribute('d',d);$('#g-u').setAttribute('d',u);
  if(samples.length>1){var x0=(w*(n-samples.length)/(n-1)).toFixed(1);$('#g-da').setAttribute('d',d+' L'+w+' '+h+' L'+x0+' '+h+' Z');}
  $('#g-dl').textContent='↓ '+(st.dataset.downS||'');$('#g-ul').textContent='↑ '+(st.dataset.upS||'');
}

// ---------- actions ----------
function bulk(op,hashes){
  hashes=hashes||selHashes();
  if(!hashes.length){toast(t('Select at least one torrent'),true);return Promise.resolve();}
  var f=new URLSearchParams();f.set('op',op);hashes.forEach(function(h){f.append('hashes',h);});
  return post('/ui/bulk',f).then(function(res){report(res);refresh();});
}
function askRemove(hashes){
  hashes=hashes||selHashes();
  if(!hashes.length){toast(t('Select at least one torrent'),true);return;}
  var dlg=$('#dlg-remove');dlg._hashes=hashes;
  var name=hashes.length===1?(rows().find(function(r){return r.dataset.hash===hashes[0];})||{dataset:{name:''}}).dataset.name:'';
  $('#remove-what').textContent=hashes.length===1?name:hashes.length+' '+t('torrents will be removed.');
  $('#remove-files').checked=false;openDialog(dlg);
}
function copyMagnet(hash){
  fetch('/ui/magnet?hash='+encodeURIComponent(hash),{cache:'no-store'}).then(function(r){return r.ok?r.text():Promise.reject(new Error(r.status));}).then(function(m){
    if(navigator.clipboard&&navigator.clipboard.writeText)return navigator.clipboard.writeText(m).then(function(){toast(t('Magnet copied'),false);});
    window.prompt(t('Magnet link'),m);
  }).catch(function(){toast(t('Copy failed'),true);});
}
function editCategory(hashes){
  var dlg=$('#dlg-cat'),r=rows().find(function(x){return x.dataset.hash===hashes[0];});
  dlg._hashes=hashes;$('input[name=category]',dlg).value=r?r.dataset.cat:'';$('input[name=tags]',dlg).value=r?r.dataset.tags.split(',').join(', '):'';openDialog(dlg);
}
function act(op,hashes){
  switch(op){
    case 'details':openDetail(hashes[0]);break;
    case 'remove':askRemove(hashes);break;
    case 'magnet':copyMagnet(hashes[0]);break;
    case 'export':window.location.href='/ui/torrent-file?hash='+encodeURIComponent(hashes[0]);break;
    case 'category':editCategory(hashes);break;
    default:bulk(op,hashes);
  }
}

// ---------- dialogs and menus ----------
function openDialog(d){if(typeof d.showModal==='function'){d.showModal();}else{d.setAttribute('open','');}var f=$('textarea,input:not([type=hidden]):not([type=checkbox]),select',d);if(f)f.focus();}
function closeDialog(d){if(d.close)d.close();else d.removeAttribute('open');}
var openMenuEl=null,menuReturn=null;
function openMenu(menu,x,y,returnTo){
  closeMenu();menu.hidden=false;openMenuEl=menu;menuReturn=returnTo||null;
  var w=menu.offsetWidth,h=menu.offsetHeight;
  menu.style.left=Math.max(8,Math.min(x,window.innerWidth-w-8))+'px';menu.style.top=Math.max(8,Math.min(y,window.innerHeight-h-8))+'px';
  var first=$('[role=menuitem]',menu);if(first)first.focus();
  if(returnTo&&returnTo.setAttribute)returnTo.setAttribute('aria-expanded','true');
}
function closeMenu(focusBack){
  if(!openMenuEl)return;openMenuEl.hidden=true;
  if(menuReturn&&menuReturn.setAttribute)menuReturn.setAttribute('aria-expanded','false');
  if(focusBack&&menuReturn&&menuReturn.focus)menuReturn.focus();
  openMenuEl=null;
}
function rowMenu(row,x,y,from){
  if(!state.selected.has(row.dataset.hash))select(row.dataset.hash,'only');
  var menu=$('#row-menu');menu._hashes=selHashes();
  var one=menu._hashes.length===1;
  $$('[data-act=details],[data-act=magnet],[data-act=export]',menu).forEach(function(b){b.hidden=!one;});
  openMenu(menu,x,y,from||row);
}

// ---------- detail drawer ----------
function openDetail(hash,tab){
  tab=tab||(state.drawer&&state.drawer.hash===hash?state.drawer.tab:'general');
  state.drawer={hash:hash,tab:tab};
  var d=$('#drawer');
  return fetch('/ui/detail?hash='+encodeURIComponent(hash)+'&tab='+encodeURIComponent(tab),{cache:'no-store'}).then(function(r){return r.text();}).then(function(h){
    var wasOpen=!d.hidden;$('#drawer-body').innerHTML=h;d.hidden=false;
    if(!wasOpen){var c=$('#drawer [data-close-drawer]');if(c)c.focus();}
  });
}
function closeDetail(){var d=$('#drawer');if(d.hidden)return;d.hidden=true;var h=state.drawer&&state.drawer.hash;state.drawer=null;var r=h&&rows().find(function(x){return x.dataset.hash===h;});if(r)r.focus();}
function refreshDetail(){
  var s=state.drawer;if(!s||document.hidden)return;
  if(['peers','trackers','pieces','general'].indexOf(s.tab)<0)return;
  if($('#drawer').contains(document.activeElement)&&document.activeElement.matches('input,textarea,select'))return;
  if(s.tab==='general'&&$('#drawer form.dirty'))return;
  openDetail(s.hash,s.tab);
}

// ---------- log view ----------
function showLog(on){
  var btn=$('#btn-log');if(!btn)return;btn.setAttribute('aria-pressed',on?'true':'false');
  $('#pane-torrents').hidden=on;$('#pane-log').hidden=!on;if(on)loadLog();
}
function loadLog(){var n=$('#log-lines').value,url=($('#btn-log')&&$('#btn-log').getAttribute('data-log-url'))||'/ui/gextto-log';$('#log-info').textContent=t('loading…');fetch(url+'?lines='+encodeURIComponent(n),{cache:'no-store'}).then(function(r){return r.ok?r.json():r.text().then(function(x){throw new Error(x);});}).then(function(d){window.__log=d.lines||[];$('#log-info').textContent=(d.path?d.path+' · ':'')+(d.lines||[]).length+' '+t('lines')+' · '+new Date().toLocaleTimeString();renderLog(true);}).catch(function(e){$('#log-view').textContent=t('Cannot read the log:')+' '+e.message;$('#log-info').textContent='';});}
function renderLog(scroll){var view=$('#log-view'),q=($('#log-filter').value||'').toLowerCase(),nodebug=$('#log-nodebug').checked,frag=document.createDocumentFragment();(window.__log||[]).forEach(function(line){if(nodebug&&/\sDEBUG\s/.test(line))return;if(q&&line.toLowerCase().indexOf(q)<0)return;var row=document.createElement('div');if(/\s(ERROR|FATAL)\s/.test(line))row.className='error';else if(/\sWARN(ING)?\s/.test(line))row.className='warn';else if(/\sDEBUG\s/.test(line))row.className='debug';row.textContent=line;frag.appendChild(row);});view.textContent='';view.appendChild(frag);if(scroll!==false)view.scrollTop=view.scrollHeight;}

// ---------- add ----------
function setFiles(files){var input=$('#add-files');try{input.files=files;}catch(e){}updateFilePick();}
function updateFilePick(){var input=$('#add-files'),n=input.files?input.files.length:0;$('#filepick').classList.toggle('has',n>0);$('#filepick-text').textContent=n?n+' '+t('file(s) selected'):t('Drop .torrent files anywhere on the page, or');}
function submitAdd(form){
  var opts=new FormData(form),sources=String(opts.get('source')||'').split(/\r?\n/).map(function(s){return s.trim();}).filter(Boolean),files=$('#add-files').files||[];
  if(!sources.length&&!files.length){toast(t('Paste a magnet link or choose a .torrent file'),true);return;}
  var base={};['destination','category','paused','top','sequential','first_last','super_seeding'].forEach(function(k){var v=opts.get(k);if(v)base[k]=v;});
  var jobs=[],ok=0,fail=[];
  sources.forEach(function(s){var p=new URLSearchParams(base);p.set('source',s);jobs.push(post('/ui/add',p));});
  Array.prototype.forEach.call(files,function(file){var fd=new FormData();Object.keys(base).forEach(function(k){fd.set(k,base[k]);});fd.set('torrent',file);jobs.push(fetch('/ui/add',{method:'POST',body:fd,headers:{'X-GX-Fetch':'1'}}).then(function(r){return r.json();}).catch(function(e){return {ok:false,msg:e.message};}));});
  Promise.all(jobs).then(function(res){res.forEach(function(r){if(r&&r.ok)ok++;else fail.push(r&&r.msg);});
    if(ok)toast(ok+' '+t('torrent(s) added'),false);fail.forEach(function(m){toast(m||t('Error'),true);});
    if(!fail.length){closeDialog($('#dlg-add'));form.reset();updateFilePick();}
    refresh();});
}

// ---------- wiring ----------
document.addEventListener('click',function(e){
  var el=e.target;
  if(openMenuEl&&!openMenuEl.contains(el)&&!el.closest('[aria-haspopup=menu]'))closeMenu();
  var c=el.closest('[data-close]');if(c){closeDialog(c.closest('dialog'));return;}
  if(el.closest('[data-close-drawer]')){closeDetail();return;}
  var b=el.closest('[data-bulk]');if(b){if(b.getAttribute('aria-disabled')==='true'){toast(t('Select at least one torrent'),true);return;}if(b.dataset.bulk==='remove-ask')askRemove();else bulk(b.dataset.bulk);return;}
  var mi=el.closest('#row-menu [data-act]');if(mi){var hs=$('#row-menu')._hashes||[];closeMenu();act(mi.dataset.act,hs);return;}
  var ti=el.closest('#tools-menu [data-tool]');if(ti){closeMenu();tool(ti.dataset.tool);return;}
  var st=el.closest('#side [data-status]');if(st){state.filter.status=st.dataset.status;store.set('filter',state.filter);applyFilters();return;}
  var cb=el.closest('#side [data-catbtn]');if(cb){var v=cb.dataset.cat;state.filter.cat=state.filter.cat===v?null:v;store.set('filter',state.filter);applyFilters();return;}
  var tg=el.closest('#side [data-tag]');if(tg){state.filter.tag=state.filter.tag===tg.dataset.tag?null:tg.dataset.tag;store.set('filter',state.filter);applyFilters();return;}
  var sb=el.closest('#torrents th[data-sort] button');if(sb){setSort(sb.closest('th').dataset.sort);return;}
  var more=el.closest('#torrents td.more button');if(more){var r=rowOf(more),rc=more.getBoundingClientRect();rowMenu(r,rc.right-210,rc.bottom+4,more);return;}
  var tab=el.closest('#drawer [data-tab]');if(tab&&state.drawer){openDetail(state.drawer.hash,tab.dataset.tab);return;}
  var da=el.closest('#drawer [data-dact]');if(da&&state.drawer){var h=state.drawer.hash;if(da.dataset.dact==='magnet')copyMagnet(h);else if(da.dataset.dact==='dht'){toast(t('DHT swarm')+'…',false);fetch('/ui/dhtscrape?hash='+encodeURIComponent(h),{cache:'no-store'}).then(function(r){return r.ok?r.json():Promise.reject();}).then(function(d){toast(t('DHT swarm (seeders / peers):')+' ~'+d.seeders+' / ~'+d.peers,false);}).catch(function(){toast(t('DHT swarm')+': '+t('Copy failed'),true);});}else act(da.dataset.dact,[h]);return;}
  var res=el.closest('#searchresults [data-add]');if(res){var p=new URLSearchParams();p.set('source',res.dataset.add);res.disabled=true;post('/ui/add',p).then(function(x){report(x);refresh();});return;}
  if(el.closest('#btn-add')){openDialog($('#dlg-add'));return;}
  if(el.closest('#btn-search')){openDialog($('#dlg-search'));return;}
  if(el.closest('#btn-log')){showLog($('#btn-log').getAttribute('aria-pressed')!=='true');return;}
  if(el.closest('#log-reload')){loadLog();return;}
  var tb=el.closest('#btn-tools');if(tb){var rc2=tb.getBoundingClientRect();if(openMenuEl===$('#tools-menu'))closeMenu();else openMenu($('#tools-menu'),rc2.right-220,rc2.bottom+4,tb);return;}
  if(el.closest('#side-toggle')){var s=$('#side'),open=!s.classList.contains('open');s.classList.toggle('open',open);$('#side-toggle').setAttribute('aria-expanded',open?'true':'false');return;}
  var row=rowOf(el);
  if(row&&!el.closest('a,button,input,label')){row.tabIndex=0;select(row.dataset.hash,e.shiftKey?'range':(e.ctrlKey||e.metaKey)?'toggle':'only');if(state.drawer)openDetail(row.dataset.hash);}
  if(row&&el.closest('a.open')){e.preventDefault();select(row.dataset.hash,'only');openDetail(row.dataset.hash);}
});
document.addEventListener('change',function(e){
  if(e.target.classList.contains('rowsel')){var r=rowOf(e.target);select(r.dataset.hash,'toggle');return;}
  if(e.target.id==='selall'){var on=e.target.checked;visibleRows().forEach(function(r){if(on)state.selected.add(r.dataset.hash);else state.selected.delete(r.dataset.hash);});renderSelection();return;}
  if(e.target.id==='add-files'){updateFilePick();return;}
  if(e.target.id==='log-nodebug'||e.target.id==='log-lines'){if(e.target.id==='log-lines')loadLog();else renderLog();return;}
  var f=e.target.closest('#drawer form');if(f)f.classList.add('dirty');
});
document.addEventListener('input',function(e){
  if(e.target.id==='filter'){state.q=e.target.value;applyFilters();}
  if(e.target.id==='log-filter')renderLog();
  var f=e.target.closest&&e.target.closest('#drawer form');if(f)f.classList.add('dirty');
});
document.addEventListener('dblclick',function(e){var r=rowOf(e.target);if(r&&!e.target.closest('button,input,a')){select(r.dataset.hash,'only');openDetail(r.dataset.hash);}});
document.addEventListener('contextmenu',function(e){var r=rowOf(e.target);if(r&&!e.target.closest('input,a')){e.preventDefault();rowMenu(r,e.clientX,e.clientY,r);}});
document.addEventListener('submit',function(e){
  var form=e.target;
  if(form.id==='form-add'){e.preventDefault();submitAdd(form);return;}
  if(form.id==='form-remove'){e.preventDefault();var d=$('#dlg-remove'),hs=d._hashes||[];closeDialog(d);bulk($('#remove-files').checked?'remove-files':'remove',hs).then(function(){hs.forEach(function(h){state.selected.delete(h);});if(state.drawer&&hs.indexOf(state.drawer.hash)>=0)closeDetail();});return;}
  if(form.id==='form-cat'){e.preventDefault();var dc=$('#dlg-cat'),cat=$('input[name=category]',dc).value,tags=$('input[name=tags]',dc).value;closeDialog(dc);Promise.all((dc._hashes||[]).map(function(h){return post('/ui/category',{hash:h,category:cat,tags:tags});})).then(function(r){report(r[r.length-1]);refresh();});return;}
  if(form.id==='form-search'){e.preventDefault();runSearch();return;}
  if(form.hasAttribute('data-native'))return;
  // Every other form (detail drawer, IP filter): post in place, report, refresh.
  if(form.method.toLowerCase()==='post'&&(form.closest('#drawer')||form.closest('dialog'))){
    e.preventDefault();
    var p=new URLSearchParams(new FormData(form));if(e.submitter&&e.submitter.name)p.set(e.submitter.name,e.submitter.value);
    var dlg=form.closest('dialog');
    post(form.action,p).then(function(res){report(res);if(dlg&&res.ok)closeDialog(dlg);form.classList.remove('dirty');if(state.drawer)openDetail(state.drawer.hash,state.drawer.tab);refresh();});
  }
});
document.addEventListener('keydown',function(e){
  var tag=(document.activeElement&&document.activeElement.tagName)||'',typing=/INPUT|TEXTAREA|SELECT/.test(tag)||(document.activeElement&&document.activeElement.isContentEditable);
  if(openMenuEl){
    var items=$$('[role=menuitem]',openMenuEl).filter(function(b){return !b.hidden;}),i=items.indexOf(document.activeElement);
    if(e.key==='Escape'){e.preventDefault();closeMenu(true);return;}
    if(e.key==='ArrowDown'){e.preventDefault();items[(i+1)%items.length].focus();return;}
    if(e.key==='ArrowUp'){e.preventDefault();items[(i-1+items.length)%items.length].focus();return;}
    if(e.key==='Home'){e.preventDefault();items[0].focus();return;}
    if(e.key==='End'){e.preventDefault();items[items.length-1].focus();return;}
    if(e.key==='Tab'){closeMenu();return;}
    return;
  }
  if($('dialog[open]'))return;
  if(e.key==='Escape'){if(!$('#drawer').hidden){closeDetail();return;}if(state.selected.size){state.selected.clear();renderSelection();}return;}
  if(typing)return;
  if(e.key==='/'){e.preventDefault();$('#filter').focus();return;}
  if(e.key==='n'||e.key==='N'){e.preventDefault();openDialog($('#dlg-add'));return;}
  var row=rowOf(document.activeElement);
  if(row){
    var vis=visibleRows(),k=vis.indexOf(row);
    if(e.key==='ArrowDown'||e.key==='ArrowUp'){e.preventDefault();var nx=vis[e.key==='ArrowDown'?Math.min(k+1,vis.length-1):Math.max(k-1,0)];if(nx){row.tabIndex=-1;nx.tabIndex=0;nx.focus();if(e.shiftKey)select(nx.dataset.hash,'range');else if(!e.ctrlKey&&!e.metaKey)select(nx.dataset.hash,'only');if(state.drawer)openDetail(nx.dataset.hash);}return;}
    if(e.key==='Home'||e.key==='End'){e.preventDefault();var t2=e.key==='Home'?vis[0]:vis[vis.length-1];row.tabIndex=-1;t2.tabIndex=0;t2.focus();select(t2.dataset.hash,'only');return;}
    if(e.key===' '){e.preventDefault();select(row.dataset.hash,'toggle');return;}
    if(e.key==='Enter'){e.preventDefault();select(row.dataset.hash,'only');openDetail(row.dataset.hash);return;}
    if(e.key==='ContextMenu'||(e.shiftKey&&e.key==='F10')){e.preventDefault();var rc=row.getBoundingClientRect();rowMenu(row,rc.left+40,rc.bottom,row);return;}
  }
  if((e.ctrlKey||e.metaKey)&&(e.key==='a'||e.key==='A')){e.preventDefault();visibleRows().forEach(function(r){state.selected.add(r.dataset.hash);});renderSelection();return;}
  if(e.key==='Delete'&&state.selected.size){e.preventDefault();askRemove();return;}
  if((e.key==='p'||e.key==='P')&&state.selected.size){e.preventDefault();var anyRun=selHashes().some(function(h){var r=rows().find(function(x){return x.dataset.hash===h;});return r&&r.dataset.state!=='paused';});bulk(anyRun?'pause':'resume');return;}
});

// Drag and drop / paste anywhere: .torrent files and magnet links open Add.
var dragDepth=0;
window.addEventListener('dragenter',function(e){if(e.dataTransfer&&Array.prototype.indexOf.call(e.dataTransfer.types,'Files')>=0){dragDepth++;$('#dropzone').hidden=false;}});
window.addEventListener('dragleave',function(){dragDepth=Math.max(0,dragDepth-1);if(!dragDepth)$('#dropzone').hidden=true;});
window.addEventListener('dragover',function(e){if(e.dataTransfer&&Array.prototype.indexOf.call(e.dataTransfer.types,'Files')>=0)e.preventDefault();});
window.addEventListener('drop',function(e){dragDepth=0;$('#dropzone').hidden=true;if(!e.dataTransfer||!e.dataTransfer.files.length)return;e.preventDefault();var d=$('#dlg-add');if(!d.open)openDialog(d);setFiles(e.dataTransfer.files);});
document.addEventListener('paste',function(e){var tag=(document.activeElement&&document.activeElement.tagName)||'';if(/INPUT|TEXTAREA/.test(tag)||$('dialog[open]'))return;var text=(e.clipboardData&&e.clipboardData.getData('text'))||'';if(/^\s*(magnet:\?|https?:\/\/\S+\.torrent)/i.test(text)){e.preventDefault();var d=$('#dlg-add');openDialog(d);$('textarea[name=source]',d).value=text.trim();}});

function tool(name){
  if(name==='ipfilter')openDialog($('#dlg-ipfilter'));
  else if(name==='create')openDialog($('#dlg-create'));
  else if(name==='feeds'){toast(t('Checking…'),false);fetch('/ui/feeds/poll',{method:'POST',headers:{'X-GX-Fetch':'1'}}).then(function(r){if(!r.ok)throw new Error(r.status);return r.json();}).then(function(res){if(res.errors&&res.errors.length)toast(res.errors.join(' · '),true);else toast(res.feeds+' '+t('feeds checked')+': '+res.new+' '+t('new')+' · '+res.added+' '+t('added'),false);refresh();}).catch(function(e){toast(t('Error')+': '+(e.message||''),true);});}
  else if(name==='ports'){toast(t('checking…'),false);fetch('/ui/portcheck',{cache:'no-store'}).then(function(r){return r.text();}).then(function(h){var d=document.createElement('div');d.innerHTML=h;toast(d.textContent.trim()||t('Done'),/not|non|nicht|pas|nie|no /i.test(d.textContent)&&false);}).catch(function(e){toast(t('test failed:')+' '+e.message,true);});}
}
function runSearch(){
  var q=($('#searchbox').value||'').trim(),box=$('#searchresults'),info=$('#searchinfo');box.textContent='';if(!q){info.textContent='';return;}
  info.textContent=t('Searching…');
  fetch('/ui/search?q='+encodeURIComponent(q),{cache:'no-store'}).then(function(r){return r.ok?r.json():[];}).then(function(list){
    info.textContent=list.length?list.length+' '+t('results'):t('No results');
    list.forEach(function(it){var row=document.createElement('div');row.className='r';var name=document.createElement('span');name.className='t';name.textContent=it.title;name.title=it.title;var meta=document.createElement('span');meta.className='muted';meta.textContent=fmtBytes(it.size)+' · '+t('Seeds')+' '+it.seeders;var b=document.createElement('button');b.type='button';b.className='primary sm';b.textContent=t('Add');b.dataset.add=it.magnet||it.link;row.appendChild(name);row.appendChild(meta);row.appendChild(b);box.appendChild(row);});
  }).catch(function(){info.textContent=t('No results');});
}
function fmtBytes(n){if(!n||n<0)return '';var u=['B','KiB','MiB','GiB','TiB'],i=0;while(n>=1024&&i<u.length-1){n/=1024;i++;}return (i?n.toFixed(1):n)+' '+u[i];}

// Restore and start.
state.q='';afterRender();sampleGraph();
var params=new URLSearchParams(location.search);
if(params.get('open'))openDetail(params.get('open'),params.get('tab')||'general');
if(params.has('msg')){history.replaceState(null,'',location.pathname);}
setInterval(refresh,2000);
setInterval(refreshDetail,4000);
document.addEventListener('visibilitychange',function(){if(!document.hidden)refresh();});
// The engine pushes state changes on /ui/events: refresh at once instead of
// waiting for the next poll. Piece events are too frequent to refresh on.
try{var es=new EventSource('/ui/events');es.onmessage=function(m){try{var ev=JSON.parse(m.data);if(ev.type!=='torrent_piece')refresh();}catch(_){}};}catch(_){}
window.gxShowMore=function(){state.rows=(state.rows||300)*2;refresh();};
})();
</script>
