window.gxShowMore=function(){if(virtualAllowed()){state.rows=0;state.virtual=false;}else{state.rows=(state.rows||300)*2;}refresh();};
window.gxClearFilters=function(){state.filter={status:'all',cat:null,tag:null,tracker:null};state.q='';var f=$('#filter');if(f)f.value='';store.set('filter',state.filter);applyFilters();};
})();
