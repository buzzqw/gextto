  <div class="emptystate" id="filtered-empty" hidden><svg class="i"><use href="#i-search"/></svg><h3>{{tr "No torrent matches the filters"}}</h3><button type="button" class="sm" onclick="gxClearFilters()" title="{{tr "Show all torrents again"}}">{{tr "Clear filters"}}</button></div>
  {{if .RowsLimited}}
