  <button type="button" role="tab" data-tab="files" aria-selected="{{if eq .Tab "files"}}true{{else}}false{{end}}" title="{{tr "List of files in the torrent, individual progress and download priority"}}"><span>{{tr "Files"}}</span> <span class="cnt">{{.FileCount}}</span></button>
  <button type="button" role="tab" data-tab="peers" aria-selected="{{if eq .Tab "peers"}}true{{else}}false{{end}}" title="{{tr "Connected peers, client software, flags and transfer rates"}}"><span>{{tr "Peers"}}</span> <span class="cnt">{{.PeerCount}}</span></button>
  <button type="button" role="tab" data-tab="trackers" aria-selected="{{if eq .Tab "trackers"}}true{{else}}false{{end}}" title="{{tr "Trackers list, announce URLs, tiers and response status"}}"><span>{{tr "Trackers"}}</span> <span class="cnt">{{.TrackerCount}}</span></button>
  <button type="button" role="tab" data-tab="pieces" aria-selected="{{if eq .Tab "pieces"}}true{{else}}false{{end}}" title="{{tr "Piece availability map and verified chunks"}}">{{tr "Pieces"}}</button>
  <button type="button" role="tab" data-tab="speed" aria-selected="{{if eq .Tab "speed"}}true{{else}}false{{end}}" title="{{tr "Download and upload speed of this torrent over the last minutes"}}">{{tr "Speed"}}</button>
  <button type="button" role="tab" data-tab="log" aria-selected="{{if eq .Tab "log"}}true{{else}}false{{end}}" title="{{tr "What happened to this torrent: tracker errors, pieces that failed their check, moves, rechecks"}}">{{tr "Log"}}</button>
</div>
<div role="tabpanel">
{{if .Error}}<p class="notice err">{{.Error}}</p>{{end}}

{{if eq .Tab "general"}}
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
    <button type="button" class="sm" data-dact="resume" title="{{tr "Resume this torrent"}}"><svg class="i"><use href="#i-play"/></svg>{{tr "Resume"}}</button>
    <button type="button" class="sm" data-dact="pause" title="{{tr "Pause this torrent"}}"><svg class="i"><use href="#i-pause"/></svg>{{tr "Pause"}}</button>
    <button type="button" class="sm" data-dact="verify" title="{{tr "Recheck data on disk"}}"><svg class="i"><use href="#i-check"/></svg>{{tr "Recheck"}}</button>
    <button type="button" class="sm" data-dact="magnet" title="{{tr "Copy magnet URI with info hash and trackers to clipboard"}}"><svg class="i"><use href="#i-copy"/></svg>{{tr "Copy magnet"}}</button>
    <button type="button" class="sm" data-dact="dht" title="{{tr "Query the DHT network for active seeders and peers"}}">{{tr "DHT swarm"}}</button>
    <a class="btn sm" href="/ui/torrent-file?hash={{.Hash}}" download title="{{tr "Export and download the .torrent metainfo file"}}"><svg class="i"><use href="#i-file"/></svg>{{tr "Export .torrent"}}</a>
  </div>
  {{if .PieceBar}}<div class="dbars">
    <span class="dbar-l" id="dbar-down-l">{{tr "Downloaded"}}</span>
    <div class="dbar" role="img" aria-labelledby="dbar-down-l dbar-down-v" title="{{tr "Where the downloaded pieces are: full colour is complete, lighter is partly downloaded, grey is missing, dimmed is a skipped file"}}">{{range .PieceBar}}<i class="{{.Class}}" style="opacity:{{.Op}}"></i>{{end}}</div>
    <span class="dbar-v" id="dbar-down-v">{{percent .Progress}}%</span>
    {{if .AvailBar}}<span class="dbar-l" id="dbar-av-l">{{tr "Availability"}}</span>
    <div class="dbar av" role="img" aria-labelledby="dbar-av-l dbar-av-v" title="{{tr "How many connected peers have the pieces still missing: darker is more peers, red is a piece nobody connected has"}}">{{range .AvailBar}}<i class="{{.Class}}" style="opacity:{{.Op}}"></i>{{end}}</div>
    <span class="dbar-v" id="dbar-av-v">{{if .AvailMissing}}<span class="err-t">{{.AvailMissing}} <span>{{tr "pieces unavailable"}}</span></span>{{else if lt .AvailabilityPct 0.0}}—{{else}}{{printf "%.2f" .AvailabilityPct}}{{end}}</span>{{end}}
  </div>{{else}}  <div class="progress {{.State}}" role="progressbar" aria-valuenow="{{percent .Progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{tr "Progress"}}" style="height:8px;margin-bottom:14px"><i style="width:{{percent .Progress}}%"></i></div>{{end}}
  <div class="kv">
    <div class="row"><span>{{tr "State"}}</span><strong><span>{{tr (stateLabel .State)}}</span></strong></div>
    <div class="row"><span>{{tr "Progress"}}</span><strong>{{percent .Progress}}%</strong></div>
    <div class="row"><span>{{tr "Size"}}</span><strong>{{bytes .TotalSize}}</strong></div>
    <div class="row"><span>{{tr "Done"}}</span><strong>{{bytes .TotalDone}}</strong></div>
    <div class="row"><span>{{tr "Downloaded"}}</span><strong>{{bytes .Downloaded}}</strong></div>
    <div class="row"><span>{{tr "Uploaded"}}</span><strong>{{bytes .Uploaded}}</strong></div>
    <div class="row"><span>{{tr "Ratio"}}</span><strong>{{printf "%.2f" .Ratio}}</strong></div>
    <div class="row"><span>↓ / ↑</span><strong>{{rate .DownRate}} / {{rate .UpRate}}</strong></div>
    <div class="row"><span>{{tr "Peer / Seed"}}</span><strong>{{.NumPeers}} / {{.NumSeeds}}</strong></div>
    <div class="row"><span>{{tr "Swarm (seeds / peers)"}}</span><strong>{{if lt .NumComplete 0}}—{{else}}{{.NumComplete}}{{end}} / {{if lt .NumIncomplete 0}}—{{else}}{{.NumIncomplete}}{{end}}</strong></div>
    <div class="row"><span>{{tr "Availability"}}</span><strong>{{if lt .AvailabilityPct 0.0}}—{{else}}{{printf "%.2f" .AvailabilityPct}}{{end}}</strong></div>
    <div class="row"><span>{{tr "ETA"}}</span><strong>{{if lt .ETA 0}}—{{else}}{{dur .ETA}}{{end}}</strong></div>
    <div class="row"><span>{{tr "Time active"}}</span><strong>{{if .ActiveStr}}{{.ActiveStr}}{{else}}—{{end}}</strong></div>
    <div class="row"><span>{{tr "Last activity"}}</span><strong>{{if .LastActiveStr}}{{.LastActiveStr}}{{else}}—{{end}}</strong></div>
    <div class="row"><span>{{tr "Seeding time"}}</span><strong>{{if .SeedingStr}}{{.SeedingStr}}{{else}}—{{end}}</strong></div>
    <div class="row"><span>{{tr "Next announce"}}</span><strong>{{if lt .NextAnnounce 0}}—{{else}}{{dur .NextAnnounce}}{{end}}</strong></div>
    <div class="row"><span>{{tr "Folder"}}</span><strong>{{.SavePath}}</strong></div>
    <div class="row"><span>{{tr "Seed ratio set"}}</span><strong>{{if lt .SeedRatio 0.0}}<span>{{tr "Global"}}</span>{{else if eq .SeedRatio 0.0}}<span>{{tr "Unlimited"}}</span>{{else}}{{printf "%.2f" .SeedRatio}}{{end}}</strong></div>
    <div class="row"><span>{{tr "Seed days"}}</span><strong>{{if lt .SeedDays 0}}<span>{{tr "Global"}}</span>{{else if eq .SeedDays 0}}<span>{{tr "Unlimited"}}</span>{{else}}{{.SeedDays}}{{end}}</strong></div>
    <div class="row"><span>{{tr "Pin"}}</span><strong>{{if .Pinned}}yes{{else}}no{{end}}</strong></div>
    <div class="row"><span>{{tr "Private"}}</span><strong>{{if .Private}}yes{{else}}no{{end}}</strong></div>
    <div class="row"><span>{{tr "File"}}</span><strong>{{.FileCount}}</strong></div>
    <div class="row"><span>{{tr "Available / total pieces"}}</span><strong>{{.PiecesAvailable}} / {{.PiecesTotal}} ({{percent .PiecesPercent}}%)</strong></div>
    <div class="row"><span>{{tr "Completed pieces"}}</span><strong>{{.PiecesHave}}</strong></div>
    <div class="row"><span>{{tr "Piece size"}}</span><strong>{{bytes .PieceLength}}</strong></div>
    <div class="row"><span>{{tr "Wasted"}}</span><strong>{{bytes .Wasted}}</strong></div>
    <div class="row"><span>{{tr "Allocated on disk"}}</span><strong>{{bytes .Allocated}}</strong></div>
    <div class="row"><span>{{tr "Added"}}</span><strong>{{if .AddedStr}}{{.AddedStr}}{{else}}—{{end}}</strong></div>
    <div class="row"><span>{{tr "Completed"}}</span><strong>{{if .CompletedStr}}{{.CompletedStr}}{{else}}—{{end}}</strong></div>
  </div>
  {{if .HasBEP38}}
  <h3 class="dsec">{{tr "BEP 38 local data hints"}}</h3>
  <div class="kv">
    <div class="row"><span>{{tr "Collections"}}</span><strong>{{.CollectionsStr}}</strong></div>
    <div class="row"><span>{{tr "Similar torrents"}}</span><strong>{{.SimilarCount}}</strong></div>
    {{if .LocalDataStr}}<div class="row"><span>{{tr "Local data to reuse"}}</span><strong>{{.LocalDataStr}}</strong></div>{{end}}
  </div>
  {{end}}
  <form method="post" action="/ui/pin" style="margin:8px 0"><input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general"><input type="hidden" name="pinned" value="{{if .Pinned}}0{{else}}1{{end}}">{{if .Pinned}}<button type="submit" class="sm" title="{{tr "Unpin torrent to restore normal queue management"}}">{{tr "Unpin"}}</button>{{else}}<button type="submit" class="sm" title="{{tr "Pin torrent to keep it active outside queue limits"}}">{{tr "Pin (outside the queue)"}}</button>{{end}}</form>
  <h3 class="dsec">{{tr "Limits & seeding (-1 global, 0 unlimited)."}}</h3>
  <form class="form-grid" method="post" action="/ui/seed-limits">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label>{{tr "Download limit KiB/s"}}<input type="number" name="download_limit" value="{{.DownloadLimitKib}}" title="{{tr "Maximum download speed limit for this torrent in KiB/s (0 = unlimited)"}}"></label>
    <label>{{tr "Upload limit KiB/s"}}<input type="number" name="upload_limit" value="{{.UploadLimitKib}}" title="{{tr "Maximum upload speed limit for this torrent in KiB/s (0 = unlimited)"}}"></label>
    <label>{{tr "Max connections"}}<input type="number" name="max_connections" value="{{.MaxConnections}}" title="{{tr "Maximum number of simultaneous peer connections for this torrent (0 = default)"}}"></label>
    <label>{{tr "Max uploads"}}<input type="number" name="max_uploads" value="{{.MaxUploads}}" title="{{tr "Maximum number of simultaneous active upload slots for this torrent (0 = default)"}}"></label>
    <label>{{tr "Seed ratio"}}<input type="number" step="any" name="seed_ratio" value="{{.SeedRatio}}" title="{{tr "Target upload/download ratio to reach before stopping seed (0 = unlimited)"}}"></label>
    <label>{{tr "Seed days"}}<input type="number" name="seed_days" value="{{.SeedDays}}" title="{{tr "Maximum seeding time in days before stopping seed (0 = unlimited)"}}"></label>
    <div><button type="submit" class="primary" title="{{tr "Apply speed limits and seeding targets to this torrent"}}">{{tr "Save limits"}}</button></div>
  </form>
  <form class="form-grid" method="post" action="/ui/super-seeding">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="chk" title="{{tr "BEP 16 super-seeding: advertise one piece at a time so the swarm spreads the data. For initial seeding only; it reduces the seed's upload throughput"}}"><input type="checkbox" name="enabled" value="1"{{if .SuperSeeding}} checked{{end}}> {{tr "Super-seeding (BEP 16)"}}</label>
    <div><button type="submit" class="sm" title="{{tr "Save super-seeding setting"}}">{{tr "Save"}}</button></div>
  </form>
  <h3 class="dsec">{{tr "Peers and bandwidth share"}}</h3>
  <form class="form-grid" method="post" action="/ui/peer-options">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label>{{tr "Bandwidth share %"}}<input type="number" name="bandwidth_weight" min="10" max="1000" step="10" value="{{.BandwidthWeight}}" title="{{tr "Share of a limited line for this torrent, in percent: 100 is normal, 200 takes twice as much as a normal torrent, 50 half (10 to 1000). It only matters while a speed limit is in place"}}"></label>
    {{if .Private}}<input type="hidden" name="dht" value="{{if .DHTOn}}1{{end}}"><input type="hidden" name="pex" value="{{if .PEXOn}}1{{end}}"><input type="hidden" name="lsd" value="{{if .LSDOn}}1{{end}}"><p class="muted wide">{{tr "Private torrent: DHT, PEX and local discovery stay off, as the tracker requires."}}</p>{{else}}
    <label class="chk" title="{{tr "Find peers for this torrent through the DHT"}}"><input type="checkbox" name="dht" value="1"{{if .DHTOn}} checked{{end}}> {{tr "DHT"}}</label>
    <label class="chk" title="{{tr "Exchange peer lists with the peers of this torrent (PEX)"}}"><input type="checkbox" name="pex" value="1"{{if .PEXOn}} checked{{end}}> {{tr "PEX"}}</label>
    <label class="chk" title="{{tr "Find peers for this torrent on the local network (LSD)"}}"><input type="checkbox" name="lsd" value="1"{{if .LSDOn}} checked{{end}}> {{tr "Local discovery"}}</label>
    {{end}}
    <div><button type="submit" class="sm" title="{{tr "Save the bandwidth share and the peer sources of this torrent"}}">{{tr "Save"}}</button></div>
  </form>
  <h3 class="dsec">{{tr "Storage"}}</h3>
  <form class="form-grid" method="post" action="/ui/move">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="wide">{{tr "Move data to"}}<input type="text" name="destination" value="{{.SavePath}}" list="savepaths" title="{{tr "Destination directory on the server to move torrent data to"}}"></label>
    <div><button type="submit" class="sm" title="{{tr "Relocate torrent files to the specified directory"}}">{{tr "Move"}}</button></div>
  </form>
  {{if .Standalone}}
  <form class="form-grid" method="post" action="/ui/category">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label>{{tr "Category"}}<input type="text" name="category" value="{{.Category}}" list="catlist" title="{{tr "Category assigned to this torrent for organization and filtering"}}"></label>
    <label>{{tr "Tags"}}<input type="text" name="tags" value="{{.Tags}}" placeholder="{{tr "tag, tag"}}" title="{{tr "Tags assigned to this torrent, separated by commas"}}"></label>
    <div><button type="submit" class="sm" title="{{tr "Save category and tags for this torrent"}}">{{tr "Save"}}</button></div>
  </form>
  <datalist id="catlist">{{range .Categories}}<option value="{{.}}">{{end}}</datalist>
  {{end}}
  <h3 class="dsec">{{tr "Web seeds"}}</h3>
  <form class="form-grid" method="post" action="/ui/webseeds">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="wide">{{tr "Web seed (one URL per line)"}}<textarea name="urls" rows="3" placeholder="http://example/file" title="{{tr "HTTP/HTTPS web seed URLs for this torrent, one per line (BEP 19)"}}">{{range .WebSeeds}}{{.}}
{{end}}</textarea></label>
    <div style="display:flex;gap:6px"><button type="submit" class="sm" title="{{tr "Add web seeds to torrent"}}">{{tr "Add"}}</button><button type="submit" class="sm" name="remove" value="1" title="{{tr "Remove selected web seed"}}">{{tr "Remove"}}</button></div>
  </form>
{{else if eq .Tab "files"}}
  {{if .Files}}
  <form class="filesbar" method="post" action="/ui/file-priority" id="files-bulk">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="files">
    <label class="chk" for="files-prio">{{tr "With the selected files:"}}</label>
    <select name="priority" id="files-prio" title="{{tr "Download priority to give to the ticked files"}}"><option value="0">{{tr "Skip"}}</option><option value="4" selected>{{tr "Normal"}}</option><option value="6">{{tr "High"}}</option><option value="7">{{tr "Maximum"}}</option></select>
    <button type="submit" class="sm" title="{{tr "Apply this priority to the ticked files"}}">{{tr "Apply"}}</button>
    <label class="chk" title="{{tr "Group the files by their folder, with one priority control per folder"}}"><input type="checkbox" id="files-tree"> {{tr "Group by folder"}}</label>
  </form>
  <table class="tbl files">
    <thead><tr><th scope="col" class="sel"><input type="checkbox" id="files-all" aria-label="{{tr "Select all files"}}" title="{{tr "Select all files"}}"></th><th scope="col">{{tr "File"}}</th><th scope="col" class="num">{{tr "Size"}}</th><th scope="col">{{tr "Progress"}}</th><th scope="col">{{tr "Priority"}}</th><th scope="col"><span class="sr-only">{{tr "Actions"}}</span></th></tr></thead>
    <tbody id="files-body">
    {{range .Files}}
      <tr data-path="{{.Path}}">
        <td class="sel"><input type="checkbox" class="filesel" name="index" value="{{.Index}}" form="files-bulk" aria-label="{{tr "Select file"}}" title="{{tr "Select this file to change its priority with the others"}}"></td>
        <td class="fname" style="word-break:break-word">{{.Path}}</td>
        <td class="num">{{bytes .Size}}</td>
        <td class="fp"><div class="prog"><div class="pbar{{if not .Wanted}} paused{{end}}" role="progressbar" aria-valuenow="{{pct .Done .Size}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{tr "Progress"}}"><i style="width:{{pct .Done .Size}}%"></i></div><span class="pct" aria-hidden="true">{{pct .Done .Size}}%</span></div></td>
        <td><form method="post" action="/ui/file-priority" class="autosubmit">
          <input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="files"><input type="hidden" name="index" value="{{.Index}}">
          <select name="priority" aria-label="{{tr "Priority"}}" title="{{tr "Download priority for this file (Skip, Normal, High, Maximum)"}}" onchange="this.form.requestSubmit()"><option value="0"{{if eq .Priority 0}} selected{{end}}>{{tr "Skip"}}</option><option value="4"{{if eq .Priority 4}} selected{{end}}>{{tr "Normal"}}</option><option value="6"{{if eq .Priority 6}} selected{{end}}>{{tr "High"}}</option><option value="7"{{if eq .Priority 7}} selected{{end}}>{{tr "Maximum"}}</option></select>
        </form></td>
        <td><span style="display:inline-flex;gap:4px"><a class="btn sm" href="/ui/stream?hash={{$.Hash}}&file={{.Index}}" target="_blank" rel="noopener" aria-label="{{tr "Stream"}}" title="{{tr "Stream this file with HTTP Range; the pieces of the window are downloaded first"}}"><svg class="i"><use href="#i-play"/></svg>{{tr "Stream"}}</a>{{if $.Standalone}}<button type="button" class="btn ghost icon sm" data-rename-file="{{.Path}}" data-hash="{{$.Hash}}" aria-label="{{tr "Rename file"}}" title="{{tr "Rename this file"}}"><svg class="i"><use href="#i-edit"/></svg></button>{{end}}</span></td>
      </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">{{tr "Metadata not available yet."}}</p>{{end}}
{{else if eq .Tab "peers"}}
  {{if .Peers}}
  <table class="tbl">
    <thead><tr><th scope="col">{{tr "Peer"}}</th><th scope="col">{{tr "Client"}}</th><th scope="col" class="num">↓</th><th scope="col" class="num">↑</th><th scope="col" class="num">{{tr "Prog."}}</th><th scope="col">{{tr "Flag"}}</th><th scope="col" class="num">{{tr "For"}}</th><th scope="col"><span class="sr-only">{{tr "Actions"}}</span></th></tr></thead>
    <tbody>
    {{range .Peers}}
      <tr><td class="mono" title="{{.Source}}">{{.Address}}{{if .Country}} <span class="chip sm" title="{{tr "Country of the peer, from the offline country database"}}">{{.Country}}</span>{{end}}</td><td>{{if .Client}}{{.Client}}{{else}}—{{end}}</td>
      <td class="num">{{rate .Down}}</td><td class="num">{{rate .Up}}</td>
      <td class="num">{{printf "%.1f" .Progress}}%</td>
      <td><div class="flags">{{if .Seed}}<span class="flag on">{{tr "seed"}}</span>{{end}}{{if .Incoming}}<span class="flag">{{tr "incoming"}}</span>{{else}}<span class="flag">{{tr "outgoing"}}</span>{{end}}{{if .UTP}}<span class="flag">{{tr "uTP"}}</span>{{else}}<span class="flag">{{tr "TCP"}}</span>{{end}}{{if .Encrypted}}<span class="flag on">{{tr "encrypted"}}</span>{{end}}{{if .Handshake}}<span class="flag on">{{tr "encrypted HS"}}</span>{{end}}{{if .Snubbed}}<span class="flag">{{tr "snubbed"}}</span>{{end}}{{if .Optimistic}}<span class="flag on">{{tr "optimistic"}}</span>{{end}}{{if .ClientChoke}}<span class="flag">{{tr "choking us"}}</span>{{end}}{{if .PeerChoke}}<span class="flag">{{tr "we choke"}}</span>{{end}}{{if .ClientInt}}<span class="flag">{{tr "interested"}}</span>{{end}}{{if .PeerInt}}<span class="flag">{{tr "interested in us"}}</span>{{end}}{{if .Downloading}}<span class="flag">{{tr "downloading"}}</span>{{end}}</div></td>
      <td class="num">{{dur .Connected}}</td>
      <td><form method="post" action="/ui/peers" data-confirm-ban><input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="peers"><input type="hidden" name="op" value="ban"><input type="hidden" name="peers" value="{{.Address}}"><button type="submit" class="ghost icon sm danger" aria-label="{{tr "Ban this peer"}}" title="{{tr "Ban this peer's IP address for 30 minutes"}}"><svg class="i"><use href="#i-ban"/></svg></button></form></td></tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">{{tr "No peers connected."}}</p>{{end}}
  <form class="form-grid" method="post" action="/ui/peers">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="peers"><input type="hidden" name="op" value="add">
    <label class="wide">{{tr "Add peers (ip:port, one per line)"}}<textarea name="peers" rows="2" placeholder="203.0.113.5:51413" title="{{tr "Peers to connect to now, as ip:port, one per line"}}"></textarea></label>
    <div><button type="submit" class="sm" title="{{tr "Connect to these peers now"}}">{{tr "Add peers"}}</button></div>
  </form>
{{else if eq .Tab "trackers"}}
  {{if .Trackers}}
  <table class="tbl">
    <thead><tr><th scope="col">{{tr "URL"}}</th><th scope="col">{{tr "State"}}</th><th scope="col" class="num">{{tr "Seeds"}}</th><th scope="col" class="num">{{tr "Peers"}}</th><th scope="col" class="num">{{tr "Next"}}</th><th scope="col"><span class="sr-only">{{tr "Actions"}}</span></th></tr></thead>
    <tbody>
    {{range .Trackers}}
      <tr><td style="word-break:break-all" title="{{.Message}}"><form method="post" action="/ui/trackers" class="trk-edit">
        <input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="trackers"><input type="hidden" name="op" value="edit"><input type="hidden" name="old" value="{{.URL}}">
        <input type="text" name="new" value="{{.URL}}" aria-label="{{tr "Tracker URL"}}" title="{{tr "Change this tracker URL; the torrent keeps its data"}}">
        <button type="submit" class="sm" title="{{tr "Save the tracker URL"}}">{{tr "Save"}}</button>
      </form></td><td>{{.Status}}</td>
      <td class="num">{{.Seeders}}</td><td class="num">{{.Leechers}}</td>
      <td class="num">{{if gt .Next 0}}{{dur .Next}}{{else}}—{{end}}</td>
      <td><form method="post" action="/ui/trackers"><input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="trackers"><input type="hidden" name="op" value="remove"><input type="hidden" name="url" value="{{.URL}}"><button type="submit" class="ghost icon sm" aria-label="{{tr "Remove this tracker"}}" title="{{tr "Remove this tracker"}}"><svg class="i"><use href="#i-trash"/></svg></button></form></td></tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">{{tr "No trackers."}}</p>{{end}}
  <form class="form-grid" method="post" action="/ui/trackers">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="trackers">
    <label class="wide">{{tr "Add trackers (one per line)"}}<textarea name="urls" rows="3" placeholder="https://tracker.example/announce" title="{{tr "Tracker announce URLs to add, one per line"}}"></textarea></label>
    <div><button type="submit" class="sm" title="{{tr "Add trackers to this torrent"}}">{{tr "Add trackers"}}</button></div>
  </form>
{{else if eq .Tab "speed"}}
  <div class="graph tgraph" id="tgraph" data-hash="{{.Hash}}">
    <svg viewBox="0 0 300 80" preserveAspectRatio="none" role="img" aria-labelledby="tg-cap"><path class="da" id="tg-da"/><path class="d" id="tg-d"/><path class="u" id="tg-u"/></svg>
    <div class="legend"><span class="d" id="tg-dl">↓ {{rate .DownRate}}</span><span class="muted" id="tg-cap">{{tr "Speed of this torrent, sampled every two seconds since the page was opened"}}</span><span class="u" id="tg-ul">↑ {{rate .UpRate}}</span></div>
    <p class="muted tg-peak" id="tg-peak" aria-live="polite"></p>
  </div>
{{else if eq .Tab "log"}}
  {{if .Log}}
  <div class="table-wrap"><table class="tbl tlog">
    <thead><tr><th scope="col">{{tr "Time"}}</th><th scope="col">{{tr "Event"}}</th><th scope="col">{{tr "Detail"}}</th></tr></thead>
    <tbody>{{range .Log}}<tr{{if .Bad}} class="bad"{{end}}><td class="num">{{.When}}</td><td>{{tr .Msg}}{{if gt .Count 1}} <span class="badge">×{{.Count}}</span>{{end}}</td><td class="mono">{{.Detail}}</td></tr>{{end}}</tbody>
  </table></div>
  {{else}}<p class="muted">{{tr "Nothing has happened to this torrent since gx-torrent started."}}</p>{{end}}
{{else if eq .Tab "pieces"}}
  {{if .Pieces}}
  <p class="muted"><b>{{.PiecesHave}}/{{.PiecesTotal}}</b> <span>{{tr "pieces downloaded. Green: have, yellow: downloading, grey: missing, dimmed: skipped."}}</span></p>
  <div class="piece-map" role="img" aria-label="{{tr "Piece map"}}">
    {{range .Pieces}}<span class="piece-run piece-{{if eq .State "have"}}have{{else if eq .State "downloading"}}down{{else if eq .State "skipped"}}skip{{else}}missing{{end}}" style="width:{{.Pct}}%" title="{{if eq .State "have"}}have{{else if eq .State "downloading"}}downloading{{else if eq .State "skipped"}}skipped{{else}}missing{{end}}"></span>{{end}}
  </div>
  {{else}}<p class="muted">{{tr "Piece map is not available yet (metadata missing)."}}</p>{{end}}
{{end}}
</div>
</div>
{{end}}
