<dialog id="dlg-add" aria-labelledby="dlg-add-title">
  <form method="post" action="/ui/add" enctype="multipart/form-data" id="form-add">
    <div class="dlg-head"><h2 id="dlg-add-title">{{tr "Add torrents"}}</h2><button type="button" class="ghost icon" data-close aria-label="{{tr "Close"}}" title="{{tr "Close"}}"><svg class="i"><use href="#i-x"/></svg></button></div>
    <div class="dlg-body">
      <label class="field">{{tr "Magnet links or .torrent URLs, one per line"}}
        <textarea name="source" id="add-source" rows="3" placeholder="{{tr "magnet:?xt=…"}}" autocomplete="off" title="{{tr "Magnet link (magnet:?) or HTTP URL of a .torrent file to download"}}"></textarea>
      </label>
      <div class="results" id="add-preview" aria-live="polite" hidden style="max-height:22vh"></div>
      <p class="dlg-help" id="add-cookies" aria-live="polite" hidden></p>
      <p class="dlg-help">{{tr "A .torrent URL from a private tracker needs its login cookies:"}} <a href="/ui/settings#cookies" title="{{tr "Cookies sent when fetching .torrent files and metadata"}}">{{tr "manage cookies"}}</a>.</p>
      <div class="filepick" id="filepick">
        <span id="filepick-text">{{tr "Drop .torrent files anywhere on the page, or"}}</span>
        <input type="file" name="torrent" id="add-files" multiple accept=".torrent,application/x-bittorrent" aria-label="{{tr "Choose .torrent files"}}" title="{{tr "Select a local .torrent file to upload and start downloading"}}">
      </div>
      <div id="add-file-tree" class="filetree" aria-live="polite" hidden></div>
      <label class="field">{{tr "Save to"}}
        <span class="field-row"><input type="text" id="add-destination" name="destination" list="savepaths" placeholder="{{tr "destination (empty = default)"}}" autocomplete="off" title="{{tr "Destination directory for download files (empty uses default download folder)"}}">{{if .Standalone}}<button type="button" class="browse" data-target="add-destination" title="{{tr "Choose an existing folder on the server"}}">{{tr "Browse…"}}</button>{{end}}</span>
      </label>
      {{if .Standalone}}
      <label class="field">{{tr "Category"}}
        <input type="text" name="category" list="catlist-all" autocomplete="off" title="{{tr "Category assigned to the added torrents for organization and filtering"}}">
      </label>
      <label class="field">{{tr "Tags"}}
        <input type="text" name="tags" placeholder="{{tr "tag, tag"}}" autocomplete="off" title="{{tr "Tags assigned to the added torrents, separated by commas"}}">
      </label>
      <label class="chk" title="{{tr "Let the category decide the save path: assigning a category moves the torrent to its folder (qBittorrent automatic torrent management)"}}"><input type="checkbox" name="auto_tmm" value="1"> {{tr "Save path managed by the category"}}</label>
      {{end}}
      {{template "addopts"}}
    </div>
    <div class="dlg-foot">
      <label class="chk add-direct" title="{{tr "Next time, .torrent files dropped on the page are added at once with the default options, without this window; the Add button still opens it"}}"><input type="checkbox" id="add-direct"> {{tr "Add dropped files straight away"}}</label>
      <button type="button" data-close title="{{tr "Close without adding"}}">{{tr "Cancel"}}</button>
      <button type="submit" class="primary" title="{{tr "Add this torrent to the download queue"}}">{{tr "Add"}}</button>
    </div>
  </form>
</dialog>

