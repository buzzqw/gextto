<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>gx-torrent</title>
<link rel="icon" type="image/svg+xml" href="/favicon.ico">
<script>try{var m=localStorage.getItem('gx-theme');if(m==='light'||m==='dark')document.documentElement.setAttribute('data-theme',m);}catch(e){}</script>
<link rel="stylesheet" href="/assets/theme.css">
<style>
html,body{height:100%}
body{display:flex;flex-direction:column;overflow:hidden}
.topbar .search{position:relative;display:flex;align-items:center;width:min(360px,34vw)}
.topbar .search svg{position:absolute;left:10px;color:var(--subtle);pointer-events:none}
.topbar .search input{width:100%;padding-left:32px;height:32px;background:var(--surface-2);border-color:transparent}
.topbar .search input:focus{background:var(--sunken);border-color:var(--accent)}
.topbar .search kbd{position:absolute;right:8px;font:11px var(--mono);color:var(--subtle);border:1px solid var(--border);border-radius:4px;padding:0 4px;background:var(--surface)}
.speeds{display:flex;gap:12px;font-variant-numeric:tabular-nums;font-size:13px;white-space:nowrap}
.speeds span{display:inline-flex;align-items:center;gap:4px}
.speeds .d{color:var(--info)}.speeds .u{color:var(--ok)}
.shell{flex:1;display:flex;min-height:0}
.side{width:224px;flex:none;overflow:auto;padding:14px 10px;border-right:1px solid var(--border);background:var(--surface);display:flex;flex-direction:column;gap:18px}
.side h2{margin:0 8px 6px;font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--subtle);font-weight:650}
.flist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:1px}
.flist button{width:100%;height:32px;justify-content:flex-start;gap:9px;border:0;background:transparent;color:var(--muted);font-weight:500;padding:0 8px}
.flist button:hover{background:var(--hover);color:var(--text)}
.flist button[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent-soft-fg)}
.flist button .n{margin-left:auto;font-size:12px;color:var(--subtle);font-variant-numeric:tabular-nums}
.flist button[aria-pressed="true"] .n{color:inherit}
.flist button .lbl{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.flist .empty{padding:4px 8px;font-size:12.5px;color:var(--subtle)}
.graph{margin:0 4px;padding:10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--sunken)}
.graph svg{display:block;width:100%;height:56px}
.graph .legend{display:flex;justify-content:space-between;font-size:12px;margin-top:6px;font-variant-numeric:tabular-nums}
.graph .legend .d{color:var(--info)}.graph .legend .u{color:var(--ok)}
.graph path.d{stroke:var(--info);fill:none;stroke-width:1.6}
.graph path.u{stroke:var(--ok);fill:none;stroke-width:1.6}
.graph path.da{fill:var(--info-soft);stroke:none}
.work{flex:1;min-width:0;display:flex;flex-direction:column}
.torrentpane{flex:1;min-height:0;display:flex;flex-direction:column}
.toolbar{display:flex;align-items:center;gap:6px;padding:8px 14px;border-bottom:1px solid var(--border);background:var(--surface);flex-wrap:wrap}
.toolbar .sep{width:1px;height:20px;background:var(--border);margin:0 4px}
.toolbar .selinfo{font-size:12.5px;color:var(--muted);margin-left:4px}
.toolbar .right{margin-left:auto;display:flex;gap:6px;align-items:center}
.listwrap{flex:1;min-height:0;overflow:auto;position:relative;background:var(--surface)}
.tbl.t{table-layout:fixed;min-width:860px}
.tbl.t col.c-sel{width:40px}.tbl.t col.c-size{width:108px}.tbl.t col.c-prog{width:150px}.tbl.t col.c-state{width:150px}
.tbl.t col.c-rate{width:96px}.tbl.t col.c-eta{width:84px}.tbl.t col.c-peers{width:84px}.tbl.t col.c-ratio{width:92px}.tbl.t col.c-more{width:44px}
.tbl.t th{overflow:hidden;text-overflow:ellipsis}
.tbl.t th button.sort{all:unset;cursor:pointer;display:inline-flex;align-items:center;gap:4px;max-width:100%}
.tbl.t th button.sort:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:4px}
.tbl.t th[aria-sort="ascending"] .arrow::after{content:"▲";font-size:9px}
.tbl.t th[aria-sort="descending"] .arrow::after{content:"▼";font-size:9px}
.tbl.t tbody tr{cursor:default}
.tbl.t tbody tr td{height:52px;padding:6px 10px}
.tbl.t tbody tr[aria-selected="true"] td{background:var(--accent-soft)}
.tbl.t tbody tr:focus-visible{outline:none}
.tbl.t tbody tr:focus-visible td{box-shadow:inset 0 2px 0 var(--focus),inset 0 -2px 0 var(--focus)}
.tbl.t tbody tr:focus-visible td:first-child{box-shadow:inset 2px 2px 0 var(--focus),inset 0 -2px 0 var(--focus)}
.tbl.t td.sel{text-align:center}
.tbl.t .name{min-width:0}
.tbl.t .name .t1{font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tbl.t .name .t1 a{color:var(--text);text-decoration:none}
.tbl.t .name .t1 a:hover{text-decoration:underline;color:var(--accent)}
.tbl.t .name .t2{display:flex;gap:6px;align-items:center;font-size:12px;color:var(--subtle);white-space:nowrap;overflow:hidden;margin-top:2px}
.tbl.t .name .t2 .path{overflow:hidden;text-overflow:ellipsis}
.tbl.t .prog .pl{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:4px;font-variant-numeric:tabular-nums}
.tbl.t td.more button{opacity:.5}
.tbl.t tr:hover td.more button,.tbl.t tr[aria-selected="true"] td.more button,.tbl.t td.more button:focus-visible{opacity:1}
.tbl.t .z{color:var(--subtle)}
.emptystate{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:80px 20px;text-align:center;color:var(--muted)}
.emptystate svg{width:44px;height:44px;color:var(--subtle)}
.emptystate h3{margin:0;color:var(--text);font-size:16px}
.more-rows{padding:12px;text-align:center}
.statusbar{display:flex;gap:18px;align-items:center;flex-wrap:wrap;padding:6px 14px;border-top:1px solid var(--border);background:var(--surface);font-size:12.5px;color:var(--muted)}
.statusbar b{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}
.statusbar .dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;background:var(--subtle)}
.statusbar .dot.ok{background:var(--ok)}.statusbar .dot.bad{background:var(--err)}
.statusbar .disk{display:inline-flex;align-items:center;gap:6px}
.statusbar .disk .progress{width:70px}
.drawer{flex:none;height:clamp(220px,46vh,520px);border-top:1px solid var(--border);background:var(--surface);display:flex;flex-direction:column;min-height:0}
.drawer[hidden]{display:none}
.drawer .dhead{display:flex;align-items:flex-start;gap:10px;padding:14px 16px 8px}
.drawer .dhead h2{margin:0;font-size:15px;flex:1;word-break:break-word}
.drawer .dbody{flex:1;overflow:auto;padding:0 16px 20px}
.tabs{display:flex;gap:2px;border-bottom:1px solid var(--border);margin:0 -16px 14px;padding:0 12px;position:sticky;top:0;background:var(--surface);z-index:1}
.tabs button{height:36px;border:0;border-bottom:2px solid transparent;border-radius:0;background:transparent;color:var(--muted);padding:0 10px}
.tabs button:hover{background:transparent;color:var(--text)}
.tabs button[aria-selected="true"]{color:var(--accent);border-bottom-color:var(--accent)}
.tabs .cnt{font-size:11.5px;color:var(--subtle)}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0 20px;margin-bottom:14px}
.kv .row{display:flex;justify-content:space-between;gap:12px;padding:6px 0;border-bottom:1px solid var(--border);font-size:13px}
.kv .row span{color:var(--muted)}
.kv .row strong{font-weight:550;text-align:right;word-break:break-word;font-variant-numeric:tabular-nums}
.dsec{margin:18px 0 8px;font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--subtle);font-weight:650}
.form-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;align-items:end;margin:8px 0}
.form-grid label{display:flex;flex-direction:column;gap:4px;font-size:12.5px}
.form-grid label.chk{flex-direction:row}
.form-grid textarea,.form-grid .wide{grid-column:1/-1}
.form-grid .wide textarea,.form-grid .wide input{width:100%}
.drawer .tbl{font-size:12.5px}
.drawer .tbl td{padding:6px 8px}
.drawer .tbl th{padding:0 8px}
.flags{display:flex;flex-wrap:wrap;gap:3px}
.flag{font-size:11px;padding:0 6px;border-radius:5px;background:var(--surface-2);color:var(--muted);white-space:nowrap;line-height:18px}
.flag.on{background:var(--ok-soft);color:var(--ok)}
.piece-map{display:flex;width:100%;height:22px;margin:8px 0;border-radius:6px;overflow:hidden;background:var(--surface-2)}
.piece-run{min-width:1px;height:100%}
.piece-run.piece-have{background:var(--bar-seed)}
.piece-run.piece-down{background:var(--warn)}
.piece-run.piece-skip{background:var(--bar-paused);opacity:.4}
.piece-run.piece-missing{background:transparent}
.dropzone{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;background:rgba(37,87,214,.14);border:3px dashed var(--accent);color:var(--accent);font-size:20px;font-weight:650;pointer-events:none}
.dropzone[hidden]{display:none}
.filepick{display:flex;flex-direction:column;align-items:center;gap:6px;padding:16px;border:1.5px dashed var(--border-strong);border-radius:var(--radius);text-align:center;color:var(--muted);font-size:13px}
.filepick.has{border-color:var(--accent);color:var(--text)}
.opts{display:flex;flex-wrap:wrap;gap:10px 18px}
.addmore{border:0;padding:0}
.addmore summary{cursor:pointer;color:var(--muted);font-size:13px}
.results{display:flex;flex-direction:column;gap:6px;max-height:50vh;overflow:auto}
.results .r{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--border);border-radius:var(--radius)}
.results .r .t{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.logpane{flex:1;min-height:0;display:flex;flex-direction:column}
.logbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:8px 14px;border-bottom:1px solid var(--border);background:var(--surface)}
.logview{flex:1;margin:0;overflow:auto;padding:10px 14px;background:var(--sunken);font:12.5px/1.45 var(--mono);white-space:pre-wrap;overflow-wrap:anywhere}
.logview .warn{color:var(--warn)}.logview .error{color:var(--err)}.logview .debug{color:var(--subtle)}
.tbl.t td.meta-m{display:none}
.menu-side{display:none!important}
/* The list adapts to its own width (side panel open or not), not the window. */
.listwrap{container-type:inline-size}
.work{container-type:inline-size;container-name:work}
@container (max-width:1000px){.tbl.t col.c-ratio,.tbl.t th.c-ratio,.tbl.t td.c-ratio{display:none}.tbl.t{min-width:0}}
@container (max-width:860px){.tbl.t col.c-peers,.tbl.t th.c-peers,.tbl.t td.c-peers,.tbl.t col.c-eta,.tbl.t th.c-eta,.tbl.t td.c-eta,.tbl.t col.c-upc,.tbl.t th.c-upc,.tbl.t td.c-upc{display:none}}
@container (max-width:700px){.tbl.t col.c-size,.tbl.t th.c-size,.tbl.t td.c-size{display:none}.tbl.t col.c-prog{width:110px}}
@container work (max-width:880px){.toolbar .lbl{display:none}}
@media (max-width:1180px){.tbl.t col.c-ratio,.tbl.t th.c-ratio,.tbl.t td.c-ratio{display:none}}
@media (max-width:980px){
  .side{display:none}
  .side.open{display:flex;position:fixed;z-index:40;top:52px;bottom:0;left:0;box-shadow:var(--shadow-lg)}
  .menu-side{display:inline-flex!important}
}
@media (max-width:760px){
  .topbar .search{display:none}.speeds{display:none}.brand small{display:none}
  .tbl.t{min-width:0}
  .tbl.t thead{display:none}
  .tbl.t colgroup{display:none}
  .tbl.t,.tbl.t tbody{display:block}
  .tbl.t tbody tr{display:grid;grid-template-columns:28px 1fr auto;grid-template-areas:"sel name more" "sel prog prog" "sel meta meta";gap:4px 8px;padding:10px 12px;border-bottom:1px solid var(--border)}
  .tbl.t tbody tr td{display:none;height:auto;padding:0;border:0;background:transparent!important}
  .tbl.t tbody tr[aria-selected="true"]{background:var(--accent-soft)}
  .tbl.t td.sel{display:block;grid-area:sel;padding-top:2px}
  .tbl.t td.name{display:block;grid-area:name}
  .tbl.t td.more{display:block;grid-area:more}
  .tbl.t td.prog{display:block;grid-area:prog}
  .tbl.t td.meta-m{display:flex;grid-area:meta;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--muted)}
  .toolbar .lbl{display:none}
  .toolbar{flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
  .toolbar .selinfo{display:none}
  .statusbar{gap:4px 14px}
  .statusbar .hide-m{display:none}
}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><path d="M7 4.5v15l12-7.5z"/></symbol>
  <symbol id="i-pause" viewBox="0 0 24 24"><path d="M8 5v14M16 5v14"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/><path d="m8.5 12 2.5 2.5 4.5-5"/></symbol>
  <symbol id="i-signal" viewBox="0 0 24 24"><circle cx="12" cy="12" r="2"/><path d="M16.2 7.8a6 6 0 0 1 0 8.4M7.8 16.2a6 6 0 0 1 0-8.4M19.1 4.9a10 10 0 0 1 0 14.2M4.9 19.1a10 10 0 0 1 0-14.2"/></symbol>
  <symbol id="i-top" viewBox="0 0 24 24"><path d="M5 3h14M12 21V8M6 14l6-6 6 6"/></symbol>
  <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6"/></symbol>
  <symbol id="i-dots" viewBox="0 0 24 24"><circle cx="12" cy="5" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="12" cy="19" r="1.4"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></symbol>
  <symbol id="i-auto" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 3v18" /><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></symbol>
  <symbol id="i-down" viewBox="0 0 24 24"><path d="M12 4v16M6 14l6 6 6-6"/></symbol>
  <symbol id="i-up" viewBox="0 0 24 24"><path d="M12 20V4M6 10l6-6 6 6"/></symbol>
  <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></symbol>
  <symbol id="i-activity" viewBox="0 0 24 24"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></symbol>
  <symbol id="i-seed" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 4-4 4 4M12 16V8"/></symbol>
  <symbol id="i-dl" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 4 4 4-4M12 8v8"/></symbol>
  <symbol id="i-pausec" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></symbol>
  <symbol id="i-warn" viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></symbol>
  <symbol id="i-x" viewBox="0 0 24 24"><path d="M18 6 6 18M6 6l12 12"/></symbol>
  <symbol id="i-xc" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6M9 9l6 6"/></symbol>
  <symbol id="i-move" viewBox="0 0 24 24"><path d="M3 7h12l4 5-4 5H3zM7 12h8"/></symbol>
  <symbol id="i-disk" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 14h18M7 17h.01"/></symbol>
  <symbol id="i-tools" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/></symbol>
  <symbol id="i-file" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M12 12v6M9 15l3 3 3-3"/></symbol>
  <symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5h.01"/></symbol>
  <symbol id="i-tag" viewBox="0 0 24 24"><path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><path d="M7.5 7.5h.01"/></symbol>
  <symbol id="i-folder" viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
  <symbol id="i-rss" viewBox="0 0 24 24"><path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></symbol>
  <symbol id="i-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></symbol>
  <symbol id="i-inbox" viewBox="0 0 24 24"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5.1 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.5-6.9A2 2 0 0 0 16.8 4H7.2a2 2 0 0 0-1.7 1.1z"/></symbol>
  <symbol id="i-log" viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></symbol>
</svg>
<a class="sr-only" href="#torrent-list">Skip to the torrent list</a>
<header class="topbar">
  <button type="button" class="ghost icon menu-side" id="side-toggle" aria-controls="side" aria-expanded="false" aria-label="Show filters" title="Show filters"><svg class="i"><use href="#i-menu"/></svg></button>
  <a class="brand" href="/" title="gx-torrent"><img src="/favicon.ico" alt=""><span>gx-torrent</span> <small>{{.Version}}</small></a>
  {{if .Standalone}}
  <nav class="nav" aria-label="Sections">
    <a class="on" href="/" aria-current="page" title="Torrents list and transfer status">Torrents</a>
    <a href="/ui/wanted" title="TV shows and movies wanted list">Wanted</a>
    <a href="/ui/rss" title="RSS feeds, indexers and rules">RSS &amp; indexers</a>
    <a href="/ui/archive" title="Everything the feeds found, searchable">Archive</a>
    <a href="/ui/settings" title="Daemon configuration and options">Settings</a>
  </nav>
  {{end}}
  <span class="spacer"></span>
  <div class="search" role="search">
    <svg class="i"><use href="#i-search"/></svg>
    <input type="search" id="filter" placeholder="Filter torrents…" autocomplete="off" aria-label="Filter torrents by name" title="Filter displayed torrents by name, category or tag">
    <kbd aria-hidden="true">/</kbd>
  </div>
  <div class="speeds" id="top-speeds" aria-live="off">{{template "speeds" .}}</div>
  <div class="tools">
    <button type="button" class="ghost icon" data-theme-switch data-label-auto="Theme: automatic (follows the system)" data-label-light="Theme: light" data-label-dark="Theme: dark" aria-label="Theme: automatic (follows the system)" title="Switch theme (automatic, light, dark)">
      <svg class="i" data-theme-icon="auto"><use href="#i-auto"/></svg><svg class="i" data-theme-icon="light" hidden><use href="#i-sun"/></svg><svg class="i" data-theme-icon="dark" hidden><use href="#i-moon"/></svg>
    </button>
  </div>
</header>

{{if .Notice}}<div class="notice{{if .Error}} err{{end}}" data-toast>{{.Notice}}</div>{{end}}

<div class="shell">
  <aside class="side" id="side" aria-label="Filters">
    <div id="side-live">{{template "side" .}}</div>
    <section aria-labelledby="h-transfer">
      <h2 id="h-transfer">Transfer</h2>
      <div class="graph">
        <svg viewBox="0 0 120 40" preserveAspectRatio="none" role="img" aria-label="Download and upload speed over the last two minutes"><path class="da" id="g-da"/><path class="d" id="g-d"/><path class="u" id="g-u"/></svg>
        <div class="legend"><span class="d" id="g-dl">↓ {{.DownloadRate}}</span><span class="u" id="g-ul">↑ {{.UploadRate}}</span></div>
      </div>
    </section>
  </aside>

  <main class="work" id="main">
    <div class="toolbar" role="toolbar" aria-label="Torrent actions" id="toolbar">
      <button type="button" class="primary" id="btn-add" title="Add torrents: magnet links, .torrent URLs or files (shortcut N)"><svg class="i"><use href="#i-plus"/></svg><span class="lbl">Add</span></button>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" class="ghost" data-bulk="resume" title="Resume the selected torrents"><svg class="i"><use href="#i-play"/></svg><span class="lbl">Resume</span></button>
      <button type="button" class="ghost" data-bulk="pause" title="Pause the selected torrents"><svg class="i"><use href="#i-pause"/></svg><span class="lbl">Pause</span></button>
      <button type="button" class="ghost" data-bulk="verify" title="Recheck piece integrity on disk for all selected torrents"><svg class="i"><use href="#i-check"/></svg><span class="lbl">Recheck</span></button>
      <button type="button" class="ghost" data-bulk="reannounce" title="Force immediate tracker reannounce for all selected torrents"><svg class="i"><use href="#i-signal"/></svg><span class="lbl">Reannounce</span></button>
      <button type="button" class="ghost" data-bulk="top" title="Move all selected torrents to the top of the queue"><svg class="i"><use href="#i-top"/></svg><span class="lbl">Top</span></button>
      <button type="button" class="ghost danger" data-bulk="remove-ask" title="Remove the selected torrents (Delete)"><svg class="i"><use href="#i-trash"/></svg><span class="lbl">Remove</span></button>
      <span class="selinfo" id="selinfo" aria-live="polite"></span>
      <div class="right">
        {{if .SearchEnabled}}<button type="button" class="ghost" id="btn-search" title="Search configured Torznab indexers for releases"><svg class="i"><use href="#i-search"/></svg><span class="lbl">Search indexers</span></button>{{end}}
        {{if or .Standalone .GexttoLog}}<button type="button" class="ghost" id="btn-log" aria-pressed="false" data-log-url="{{if .Standalone}}/ui/log{{else}}/ui/gextto-log{{end}}" title="Switch to live server log view"><svg class="i"><use href="#i-log"/></svg><span class="lbl">{{if .Standalone}}Log{{else if .GexttoLog}}Gextto log{{end}}</span></button>{{end}}
        <button type="button" class="ghost" id="btn-tools" aria-haspopup="menu" aria-expanded="false" aria-controls="tools-menu" title="IP filter, create a .torrent, feeds"><svg class="i"><use href="#i-tools"/></svg><span class="lbl">Tools</span></button>
      </div>
    </div>

    <div class="torrentpane" id="pane-torrents">
      <div class="listwrap">
        <div id="live">{{template "live" .}}</div>
      </div>
      <aside class="drawer" id="drawer" hidden aria-labelledby="drawer-title">
        <div id="drawer-body"></div>
      </aside>
    </div>
    {{if or .Standalone .GexttoLog}}
    <div id="pane-log" class="logpane" hidden>
      <div class="logbar">
        <label class="chk">Lines <select id="log-lines" title="Number of recent log lines to display"><option>200</option><option selected>500</option><option>1000</option><option>2000</option></select></label>
        <input type="search" id="log-filter" placeholder="Filter lines…" autocomplete="off" title="Filter log lines by keyword or severity level">
        <label class="chk"><input type="checkbox" id="log-nodebug" checked title="Hide low-level debug messages and show only informational and warning logs"> hide DEBUG</label>
        <button type="button" class="sm" id="log-reload" title="Reload latest logs from server">Reload</button>
        <span class="muted" id="log-info"></span>
      </div>
      <pre class="logview" id="log-view">Loading…</pre>
    </div>
    {{end}}

    <footer class="statusbar" id="statusbar">{{template "status" .}}</footer>
  </main>
</div>

<div class="menu" id="row-menu" role="menu" aria-label="Torrent actions" hidden>
  <button type="button" role="menuitem" data-act="details" title="Details: files, peers, trackers"><svg class="i"><use href="#i-info"/></svg>Details<kbd>Enter</kbd></button>
  <hr>
  <button type="button" role="menuitem" data-act="resume" title="Resume this torrent"><svg class="i"><use href="#i-play"/></svg>Resume</button>
  <button type="button" role="menuitem" data-act="pause" title="Pause this torrent"><svg class="i"><use href="#i-pause"/></svg>Pause</button>
  <button type="button" role="menuitem" data-act="verify" title="Recheck data on disk"><svg class="i"><use href="#i-check"/></svg>Recheck</button>
  <button type="button" role="menuitem" data-act="reannounce" title="Reannounce to trackers"><svg class="i"><use href="#i-signal"/></svg>Reannounce</button>
  <button type="button" role="menuitem" data-act="top" title="Move to the top of the queue"><svg class="i"><use href="#i-top"/></svg>Move to top</button>
  <hr>
  {{if .Standalone}}<button type="button" role="menuitem" data-act="category" title="Category assigned to this torrent for organization and filtering"><svg class="i"><use href="#i-tag"/></svg>Category and tags…</button>{{end}}
  <button type="button" role="menuitem" data-act="magnet" title="Copy magnet URI with info hash and trackers to clipboard"><svg class="i"><use href="#i-copy"/></svg>Copy magnet</button>
  <button type="button" role="menuitem" data-act="export" title="Export and download the .torrent metainfo file"><svg class="i"><use href="#i-file"/></svg>Export .torrent</button>
  <hr>
  <button type="button" role="menuitem" class="danger" data-act="remove" title="Remove from the session (files stay)"><svg class="i"><use href="#i-trash"/></svg>Remove…<kbd>Del</kbd></button>
</div>

<div class="menu" id="tools-menu" role="menu" aria-label="Tools" hidden>
  <button type="button" role="menuitem" data-tool="ipfilter" title="IP filter blocklist file path or URL (eMule, DAT, P2P or CIDR format)"><svg class="i"><use href="#i-xc"/></svg>IP filter…</button>
  <button type="button" role="menuitem" data-tool="create" title="Create .torrent file from the specified path and start seeding"><svg class="i"><use href="#i-file"/></svg>Create .torrent…</button>
  {{if .FeedsEnabled}}<button type="button" role="menuitem" data-tool="feeds" title="Fetch new items from configured RSS feeds now"><svg class="i"><use href="#i-rss"/></svg>Check feeds</button>{{end}}
  <button type="button" role="menuitem" data-tool="ports" title="Check that the peer port is listening and forwarded by the router"><svg class="i"><use href="#i-signal"/></svg>Test ports</button>
</div>

<dialog id="dlg-add" aria-labelledby="dlg-add-title">
  <form method="post" action="/ui/add" enctype="multipart/form-data" id="form-add">
    <div class="dlg-head"><h2 id="dlg-add-title">Add torrents</h2><button type="button" class="ghost icon" data-close aria-label="Close" title="Close"><svg class="i"><use href="#i-x"/></svg></button></div>
