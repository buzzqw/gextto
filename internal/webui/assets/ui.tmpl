      {{if .Standalone}}<a class="btn" href="/ui/rss" title="{{tr "RSS feeds, indexers and rules"}}">{{tr "RSS & indexers"}}</a>{{end}}
    </div>
  </div>
  {{end}}
{{end}}{{define "th"}}<th scope="col" class="c-{{.}}" data-col="{{.}}" data-sort="{{.}}" aria-sort="none" style="position:sticky">{{end}}{{define "thnum"}}<th scope="col" class="num c-{{.}}" data-col="{{.}}" data-sort="{{.}}" aria-sort="none" style="position:sticky">{{end}}{{define "rz"}}<span class="rz" role="separator" aria-orientation="vertical" aria-valuemin="40" aria-valuemax="800" aria-valuenow="100" tabindex="0" aria-label="{{tr "Resize column"}}" title="{{tr "Drag, or use the left and right arrows, to resize the column; double click for the default width"}}"></span>{{end}}{{define "detail"}}
<div class="dhead">
  <h2 id="drawer-title">{{.Name}}</h2>
