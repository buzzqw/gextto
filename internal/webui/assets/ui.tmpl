        <li><button type="button" data-status="seeding" aria-pressed="false" title="Show only torrents currently seeding"><svg class="i"><use href="#i-seed"/></svg><span class="lbl">Seeding</span><span class="n">{{.CountSeeding}}</span></button></li>
        <li><button type="button" data-status="active" aria-pressed="false" title="Show only torrents moving data right now"><svg class="i"><use href="#i-activity"/></svg><span class="lbl">Active</span><span class="n">0</span></button></li>
        <li><button type="button" data-status="paused" aria-pressed="false" title="Show only paused torrents"><svg class="i"><use href="#i-pausec"/></svg><span class="lbl">Paused</span><span class="n">{{.CountPaused}}</span></button></li>
        <li><button type="button" data-status="stalled" aria-pressed="false" title="Show only stalled torrents (no seeders or peers)"><svg class="i"><use href="#i-warn"/></svg><span class="lbl">Stalled</span><span class="n">{{.CountStalled}}</span></button></li>
        {{if .CountMoving}}<li><button type="button" data-status="moving" aria-pressed="false" title="Show only torrents currently being moved across storage"><svg class="i"><use href="#i-move"/></svg><span class="lbl">Moving</span><span class="n">{{.CountMoving}}</span></button></li>{{end}}
        {{if .CountError}}<li><button type="button" data-status="error" aria-pressed="false" title="Show only torrents in error state"><svg class="i"><use href="#i-xc"/></svg><span class="lbl">Error</span><span class="n">{{.CountError}}</span></button></li>{{end}}
      </ul>
    </section>
    {{if .Categories}}
    <section aria-labelledby="h-cats">
      <h2 id="h-cats">Categories</h2>
      <ul class="flist">
        {{range .Categories}}<li><button type="button" data-catbtn data-cat="{{.}}" aria-pressed="false" title="Filter torrents by category"><svg class="i"><use href="#i-folder"/></svg><span class="lbl">{{.}}</span><span class="n">0</span></button></li>{{end}}
        <li><button type="button" data-catbtn data-cat="" aria-pressed="false" title="Torrents without a category"><svg class="i"><use href="#i-folder"/></svg><span class="lbl">Uncategorized</span><span class="n">0</span></button></li>
      </ul>
    </section>
    {{end}}
    {{if .Tags}}
    <section aria-labelledby="h-tags">
      <h2 id="h-tags">Tags</h2>
      <ul class="flist">
        {{range .Tags}}<li><button type="button" data-tag="{{.}}" aria-pressed="false" title="Filter torrents by tag"><svg class="i"><use href="#i-tag"/></svg><span class="lbl">{{.}}</span><span class="n">0</span></button></li>{{end}}
      </ul>
    </section>
    {{end}}
{{end}}{{define "status"}}
    <span class="hide-m" data-down="{{.DownRateRaw}}" data-up="{{.UpRateRaw}}" data-down-s="{{.DownloadRate}}" data-up-s="{{.UploadRate}}" title="Downloaded / uploaded since start"><span>Totals</span> <b>{{bytes .TotalDown}}</b> / <b>{{bytes .TotalUp}}</b></span>
    <span class="disk" title="Free space on the download folder"><svg class="i"><use href="#i-disk"/></svg><span>Free space</span> <b>{{bytes .DiskFree}}</b><span class="subtle">/ {{bytes .DiskTotal}}</span></span>
    <span class="hide-m" title="CPU load and resident memory of the gx-torrent process itself"><span>Process</span> <b>{{percent .CPUPercent}}%</b> · <b>{{bytes .ProcRSS}}</b></span>
    <span title="Nodes in the DHT routing table">DHT <b>{{if .DHT}}{{.DHTNodes}}{{else}}<span>off</span>{{end}}</b></span>
    <span {{if .PortReachable}}title="The peer port is reachable from the internet (router mapping or incoming peers)"{{else}}title="No router mapping and no incoming peer yet: the peer port may be closed"{{end}}><span class="dot {{if .PortReachable}}ok{{else}}bad{{end}}" aria-hidden="true"></span><span>Port</span> <b>{{.PeerPort}}</b> {{if .PortOpen}}<span class="subtle">{{.Router}}{{if .ExternalIP}} · {{.ExternalIP}}{{end}}</span>{{else}}<span class="subtle">not open</span>{{end}}</span>
    <span class="hide-m" title="Incoming peer connections since start"><span>Incoming</span> <b>{{.IncomingConns}}</b></span>
    <span {{if .IPFilterPath}}title="{{.IPFilterPath}}"{{else}}title="IP filter rules"{{end}}><span>IP filter</span> <b>{{if .IPFilter}}{{.IPFilter}}{{else}}<span>none</span>{{end}}</b></span>
    <span class="hide-m" title="Encryption policy for peer connections"><span>Encryption</span> <b>{{.Encryption}}</b></span>
    {{if not .Standalone}}<span title="Read / write cache"><span>Cache</span> <b>{{.CacheReadMB}}/{{.CacheWB}} MB</b></span>{{end}}
    {{if .PeerErrors}}<span title="Peer/tracker errors filtered from the log, by category (since start)"><span>Peer errors</span> <b>{{.PeerErrors}}</b></span>{{end}}
{{end}}{{define "live"}}
  {{if .Rows}}
  <table class="tbl t" id="torrents" aria-label="Torrents">
    <colgroup><col class="c-sel"><col><col class="c-size"><col class="c-prog"><col class="c-state"><col class="c-rate"><col class="c-rate c-upc"><col class="c-eta"><col class="c-peers"><col class="c-ratio"><col class="c-more"></colgroup>
    <thead><tr>
      <th class="sel" scope="col"><input type="checkbox" id="selall" aria-label="Select all" title="Select all"></th>
      <th scope="col" data-sort="name" aria-sort="none"><button type="button" class="sort" title="Sort by name">Name<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num c-size" data-sort="size" aria-sort="none"><button type="button" class="sort" title="Sort by size">Size<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" data-sort="progress" aria-sort="none"><button type="button" class="sort" title="Sort by progress">Progress<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" data-sort="state" aria-sort="none"><button type="button" class="sort" title="Sort by state">Status<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num" data-sort="down" aria-sort="none"><button type="button" class="sort" title="Sort by download speed">Down<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num c-upc" data-sort="up" aria-sort="none"><button type="button" class="sort" title="Sort by upload speed">Up<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num c-eta" data-sort="eta" aria-sort="none"><button type="button" class="sort" title="Sort by time left">ETA<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num c-peers" data-sort="peers" aria-sort="none"><button type="button" class="sort" title="Sort by connected peers">Peers<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col" class="num c-ratio" data-sort="ratio" aria-sort="none"><button type="button" class="sort" title="Sort by share ratio">Ratio<span class="arrow" aria-hidden="true"></span></button></th>
      <th scope="col"><span class="sr-only">Actions</span></th>
    </tr></thead>
    <tbody>
    {{range .Rows}}
    <tr tabindex="-1" aria-selected="false" data-hash="{{.Hash}}" data-name="{{.Name}}" data-state="{{.State}}" data-cat="{{.Category}}" data-tags="{{.Tags}}" data-path="{{.SavePath}}" data-down="{{.DLRate}}" data-up="{{.ULRate}}" data-k-name="{{.Name}}" data-k-size="{{.TotalSize}}" data-k-progress="{{.Progress}}" data-k-state="{{.State}}" data-k-down="{{.DLRate}}" data-k-up="{{.ULRate}}" data-k-eta="{{.ETAVal}}" data-k-peers="{{.Peers}}" data-k-ratio="{{.RatioVal}}">
      <td class="sel"><input class="rowsel" type="checkbox" value="{{.Hash}}" aria-label="Select torrent" title="Select this torrent for batch actions"></td>
      <td class="name"><div class="t1"><a class="open" href="/?open={{.Hash}}" title="{{.Name}}">{{.Name}}</a></div><div class="t2">{{if .Category}}<span class="chip cat">{{.Category}}</span>{{end}}<span class="path" title="{{.SavePath}}">{{.SavePath}}</span></div></td>
      <td class="num c-size" title="{{.DoneSize}}">{{.Size}}</td>
      <td class="prog"><div class="pl"><span>{{.ProgressS}}</span></div><div class="progress {{.State}}" role="progressbar" aria-valuenow="{{percent .Progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="Progress"><i style="width:{{percent .Progress}}%"></i></div></td>
      <td><span class="badge b-{{.State}}">{{.StateLabel}}</span></td>
      <td class="num{{if not .DLRate}} z{{end}}">{{.Down}}</td>
      <td class="num c-upc{{if not .ULRate}} z{{end}}">{{.Up}}</td>
      <td class="num c-eta">{{.ETA}}</td>
      <td class="num c-peers" title="Seeds / peers"><span>{{.Seeds}}</span><span class="subtle"> / {{.Peers}}</span></td>
      <td class="num c-ratio" title="{{.RatioGoal}}">{{.Ratio}}</td>
      <td class="meta-m"><span class="badge b-{{.State}}">{{.StateLabel}}</span><span>{{.Size}}</span><span>↓ {{.Down}}</span><span>↑ {{.Up}}</span><span>{{.ETA}}</span></td>
      <td class="more"><button type="button" class="ghost icon sm" aria-haspopup="menu" aria-label="More actions" title="More actions"><svg class="i"><use href="#i-dots"/></svg></button></td>
    </tr>
    {{end}}
    </tbody>
  </table>
  <div class="emptystate" id="filtered-empty" hidden><svg class="i"><use href="#i-search"/></svg><h3>No torrent matches the filters</h3></div>
  {{if .RowsLimited}}
  <p class="more-rows muted"><span>Showing</span> {{.RowsShown}} <span>of</span> {{.RowsTotal}} · <button type="button" class="sm" onclick="gxShowMore()" title="Load more torrent rows in the table">Show more</button></p>
  {{end}}
  {{else}}
  <div class="emptystate">
    <svg class="i"><use href="#i-inbox"/></svg>
    <h3>No torrents in the session.</h3>
    <p>Add a magnet link or a .torrent file, or drop one on the page.</p>
    <button type="button" class="primary" onclick="document.getElementById('btn-add').click()" title="Add torrents: magnet links, .torrent URLs or files (shortcut N)"><svg class="i"><use href="#i-plus"/></svg>Add</button>
  </div>
  {{end}}
{{end}}{{define "detail"}}
<div class="dhead">
  <h2 id="drawer-title">{{.Name}}</h2>
  <button type="button" class="ghost icon" data-close-drawer aria-label="Close details" title="Close details"><svg class="i"><use href="#i-x"/></svg></button>
</div>
<div class="dbody">
<div class="tabs" role="tablist" aria-label="Torrent details">
  <button type="button" role="tab" data-tab="general" aria-selected="{{if eq .Tab "general"}}true{{else}}false{{end}}" title="General torrent information, transfer stats and limits">General</button>
  <button type="button" role="tab" data-tab="files" aria-selected="{{if eq .Tab "files"}}true{{else}}false{{end}}" title="List of files in the torrent, individual progress and download priority"><span>Files</span> <span class="cnt">{{len .Files}}</span></button>
  <button type="button" role="tab" data-tab="peers" aria-selected="{{if eq .Tab "peers"}}true{{else}}false{{end}}" title="Connected peers, client software, flags and transfer rates"><span>Peers</span> <span class="cnt">{{len .Peers}}</span></button>
  <button type="button" role="tab" data-tab="trackers" aria-selected="{{if eq .Tab "trackers"}}true{{else}}false{{end}}" title="Trackers list, announce URLs, tiers and response status"><span>Trackers</span> <span class="cnt">{{len .Trackers}}</span></button>
  <button type="button" role="tab" data-tab="pieces" aria-selected="{{if eq .Tab "pieces"}}true{{else}}false{{end}}" title="Piece availability map and verified chunks">Pieces</button>
</div>
<div role="tabpanel">
{{if .Error}}<p class="notice err">{{.Error}}</p>{{end}}

{{if eq .Tab "general"}}
  <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
    <button type="button" class="sm" data-dact="resume" title="Resume this torrent"><svg class="i"><use href="#i-play"/></svg>Resume</button>
    <button type="button" class="sm" data-dact="pause" title="Pause this torrent"><svg class="i"><use href="#i-pause"/></svg>Pause</button>
    <button type="button" class="sm" data-dact="verify" title="Recheck data on disk"><svg class="i"><use href="#i-check"/></svg>Recheck</button>
    <button type="button" class="sm" data-dact="magnet" title="Copy magnet URI with info hash and trackers to clipboard"><svg class="i"><use href="#i-copy"/></svg>Copy magnet</button>
    <button type="button" class="sm" data-dact="dht" title="Query the DHT network for active seeders and peers">DHT swarm</button>
    <a class="btn sm" href="/ui/torrent-file?hash={{.Hash}}" download title="Export and download the .torrent metainfo file"><svg class="i"><use href="#i-file"/></svg>Export .torrent</a>
  </div>
  <div class="progress {{.State}}" role="progressbar" aria-valuenow="{{percent .Progress}}" aria-valuemin="0" aria-valuemax="100" aria-label="Progress" style="height:8px;margin-bottom:14px"><i style="width:{{percent .Progress}}%"></i></div>
  <div class="kv">
    <div class="row"><span>State</span><strong><span>{{stateLabel .State}}</span></strong></div>
    <div class="row"><span>Progress</span><strong>{{percent .Progress}}%</strong></div>
    <div class="row"><span>Size</span><strong>{{bytes .TotalSize}}</strong></div>
    <div class="row"><span>Done</span><strong>{{bytes .TotalDone}}</strong></div>
    <div class="row"><span>Downloaded</span><strong>{{bytes .Downloaded}}</strong></div>
    <div class="row"><span>Uploaded</span><strong>{{bytes .Uploaded}}</strong></div>
    <div class="row"><span>Ratio</span><strong>{{printf "%.2f" .Ratio}}</strong></div>
    <div class="row"><span>↓ / ↑</span><strong>{{rate .DownRate}} / {{rate .UpRate}}</strong></div>
    <div class="row"><span>Peer / Seed</span><strong>{{.NumPeers}} / {{.NumSeeds}}</strong></div>
    <div class="row"><span>Swarm (seeds / peers)</span><strong>{{if lt .NumComplete 0}}—{{else}}{{.NumComplete}}{{end}} / {{if lt .NumIncomplete 0}}—{{else}}{{.NumIncomplete}}{{end}}</strong></div>
    <div class="row"><span>ETA</span><strong>{{if lt .ETA 0}}—{{else}}{{dur .ETA}}{{end}}</strong></div>
    <div class="row"><span>Folder</span><strong>{{.SavePath}}</strong></div>
    <div class="row"><span>Seed ratio set</span><strong>{{if lt .SeedRatio 0.0}}<span>Global</span>{{else if eq .SeedRatio 0.0}}<span>Unlimited</span>{{else}}{{printf "%.2f" .SeedRatio}}{{end}}</strong></div>
    <div class="row"><span>Seed days</span><strong>{{if lt .SeedDays 0}}<span>Global</span>{{else if eq .SeedDays 0}}<span>Unlimited</span>{{else}}{{.SeedDays}}{{end}}</strong></div>
    <div class="row"><span>Pin</span><strong>{{if .Pinned}}yes{{else}}no{{end}}</strong></div>
    <div class="row"><span>Private</span><strong>{{if .Private}}yes{{else}}no{{end}}</strong></div>
    <div class="row"><span>File</span><strong>{{.FileCount}}</strong></div>
    <div class="row"><span>Available / total pieces</span><strong>{{.PiecesAvailable}} / {{.PiecesTotal}} ({{percent .PiecesPercent}}%)</strong></div>
    <div class="row"><span>Completed pieces</span><strong>{{.PiecesHave}}</strong></div>
    <div class="row"><span>Piece size</span><strong>{{bytes .PieceLength}}</strong></div>
    <div class="row"><span>Wasted</span><strong>{{bytes .Wasted}}</strong></div>
    <div class="row"><span>Allocated on disk</span><strong>{{bytes .Allocated}}</strong></div>
    <div class="row"><span>Added</span><strong>{{if .AddedStr}}{{.AddedStr}}{{else}}—{{end}}</strong></div>
    <div class="row"><span>Completed</span><strong>{{if .CompletedStr}}{{.CompletedStr}}{{else}}—{{end}}</strong></div>
  </div>
  {{if .HasBEP38}}
  <h3 class="dsec">BEP 38 local data hints</h3>
  <div class="kv">
    <div class="row"><span>Collections</span><strong>{{.CollectionsStr}}</strong></div>
    <div class="row"><span>Similar torrents</span><strong>{{.SimilarCount}}</strong></div>
    {{if .LocalDataStr}}<div class="row"><span>Local data to reuse</span><strong>{{.LocalDataStr}}</strong></div>{{end}}
  </div>
  {{end}}
  <form method="post" action="/ui/pin" style="margin:8px 0"><input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general"><input type="hidden" name="pinned" value="{{if .Pinned}}0{{else}}1{{end}}">{{if .Pinned}}<button type="submit" class="sm" title="Unpin torrent to restore normal queue management">Unpin</button>{{else}}<button type="submit" class="sm" title="Pin torrent to keep it active outside queue limits">Pin (outside the queue)</button>{{end}}</form>
  <h3 class="dsec">Limits &amp; seeding (-1 global, 0 unlimited).</h3>
  <form class="form-grid" method="post" action="/ui/seed-limits">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label>Download limit KiB/s<input type="number" name="download_limit" value="{{.DownloadLimitKib}}" title="Maximum download speed limit for this torrent in KiB/s (0 = unlimited)"></label>
    <label>Upload limit KiB/s<input type="number" name="upload_limit" value="{{.UploadLimitKib}}" title="Maximum upload speed limit for this torrent in KiB/s (0 = unlimited)"></label>
    <label>Max connections<input type="number" name="max_connections" value="{{.MaxConnections}}" title="Maximum number of simultaneous peer connections for this torrent (0 = default)"></label>
    <label>Max uploads<input type="number" name="max_uploads" value="{{.MaxUploads}}" title="Maximum number of simultaneous active upload slots for this torrent (0 = default)"></label>
    <label>Seed ratio<input type="number" step="0.01" name="seed_ratio" value="{{.SeedRatio}}" title="Target upload/download ratio to reach before stopping seed (0 = unlimited)"></label>
    <label>Seed days<input type="number" name="seed_days" value="{{.SeedDays}}" title="Maximum seeding time in days before stopping seed (0 = unlimited)"></label>
    <div><button type="submit" class="primary" title="Apply speed limits and seeding targets to this torrent">Save limits</button></div>
  </form>
  <form class="form-grid" method="post" action="/ui/super-seeding">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="chk" title="BEP 16 super-seeding: advertise one piece at a time so the swarm spreads the data. For initial seeding only; it reduces the seed's upload throughput"><input type="checkbox" name="enabled" value="1"{{if .SuperSeeding}} checked{{end}}> Super-seeding (BEP 16)</label>
    <div><button type="submit" class="sm" title="Save super-seeding setting">Save</button></div>
  </form>
  <h3 class="dsec">Storage</h3>
  <form class="form-grid" method="post" action="/ui/move">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="wide">Move data to<input type="text" name="destination" value="{{.SavePath}}" list="savepaths" title="Destination directory on the server to move torrent data to"></label>
    <div><button type="submit" class="sm" title="Relocate torrent files to the specified directory">Move</button></div>
  </form>
  {{if .Standalone}}
  <form class="form-grid" method="post" action="/ui/category">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label>Category<input type="text" name="category" value="{{.Category}}" list="catlist" title="Category assigned to this torrent for organization and filtering"></label>
    <label>Tags<input type="text" name="tags" value="{{.Tags}}" placeholder="tag, tag" title="Tags assigned to this torrent, separated by commas"></label>
    <div><button type="submit" class="sm" title="Save category and tags for this torrent">Save</button></div>
  </form>
  <datalist id="catlist">{{range .Categories}}<option value="{{.}}">{{end}}</datalist>
  {{end}}
  <h3 class="dsec">Web seeds</h3>
  <form class="form-grid" method="post" action="/ui/webseeds">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="general">
    <label class="wide">Web seed (one URL per line)<textarea name="urls" rows="3" placeholder="http://example/file" title="HTTP/HTTPS web seed URLs for this torrent, one per line (BEP 19)">{{range .WebSeeds}}{{.}}
{{end}}</textarea></label>
    <div style="display:flex;gap:6px"><button type="submit" class="sm" title="Add web seeds to torrent">Add</button><button type="submit" class="sm" name="remove" value="1" title="Remove selected web seed">Remove</button></div>
  </form>
{{else if eq .Tab "files"}}
  {{if .Files}}
  <table class="tbl">
    <thead><tr><th scope="col">File</th><th scope="col" class="num">Size</th><th scope="col" class="num">Done</th><th scope="col">Priority</th><th scope="col"><span class="sr-only">Play</span></th></tr></thead>
    <tbody>
    {{range .Files}}
      <tr>
        <td style="word-break:break-word">{{.Path}}</td>
        <td class="num">{{bytes .Size}}</td>
        <td class="num">{{bytes .Done}}</td>
        <td><form method="post" action="/ui/file-priority" class="autosubmit">
          <input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="files"><input type="hidden" name="index" value="{{.Index}}">
          <select name="priority" aria-label="Priority" title="Download priority for this file (Skip, Normal, High, Maximum)" onchange="this.form.requestSubmit()"><option value="0"{{if eq .Priority 0}} selected{{end}}>Skip</option><option value="4"{{if eq .Priority 4}} selected{{end}}>Normal</option><option value="6"{{if eq .Priority 6}} selected{{end}}>High</option><option value="7"{{if eq .Priority 7}} selected{{end}}>Maximum</option></select>
        </form></td>
        <td><a class="btn ghost icon sm" href="/ui/stream?hash={{$.Hash}}&file={{.Index}}" target="_blank" rel="noopener" aria-label="Stream" title="Stream this file with HTTP Range; the pieces of the window are downloaded first"><svg class="i"><use href="#i-play"/></svg></a></td>
      </tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">Metadata not available yet.</p>{{end}}
{{else if eq .Tab "peers"}}
  {{if .Peers}}
  <table class="tbl">
    <thead><tr><th scope="col">Peer</th><th scope="col">Client</th><th scope="col" class="num">↓</th><th scope="col" class="num">↑</th><th scope="col" class="num">Prog.</th><th scope="col">Flag</th><th scope="col" class="num">For</th></tr></thead>
    <tbody>
    {{range .Peers}}
      <tr><td class="mono" title="{{.Source}}">{{.Address}}</td><td>{{if .Client}}{{.Client}}{{else}}—{{end}}</td>
      <td class="num">{{rate .Down}}</td><td class="num">{{rate .Up}}</td>
      <td class="num">{{printf "%.1f" .Progress}}%</td>
      <td><div class="flags">{{if .Seed}}<span class="flag on">seed</span>{{end}}{{if .Incoming}}<span class="flag">incoming</span>{{else}}<span class="flag">outgoing</span>{{end}}{{if .UTP}}<span class="flag">uTP</span>{{else}}<span class="flag">TCP</span>{{end}}{{if .Encrypted}}<span class="flag on">encrypted</span>{{end}}{{if .Handshake}}<span class="flag on">encrypted HS</span>{{end}}{{if .Snubbed}}<span class="flag">snubbed</span>{{end}}{{if .Optimistic}}<span class="flag on">optimistic</span>{{end}}{{if .ClientChoke}}<span class="flag">choking us</span>{{end}}{{if .PeerChoke}}<span class="flag">we choke</span>{{end}}{{if .ClientInt}}<span class="flag">interested</span>{{end}}{{if .PeerInt}}<span class="flag">interested in us</span>{{end}}{{if .Downloading}}<span class="flag">downloading</span>{{end}}</div></td>
      <td class="num">{{dur .Connected}}</td></tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">No peers connected.</p>{{end}}
{{else if eq .Tab "trackers"}}
  {{if .Trackers}}
  <table class="tbl">
    <thead><tr><th scope="col">URL</th><th scope="col">State</th><th scope="col" class="num">Seeds</th><th scope="col" class="num">Peers</th><th scope="col" class="num">Next</th><th scope="col"><span class="sr-only">Actions</span></th></tr></thead>
    <tbody>
    {{range .Trackers}}
      <tr><td style="word-break:break-all" title="{{.Message}}">{{.URL}}</td><td>{{.Status}}</td>
      <td class="num">{{.Seeders}}</td><td class="num">{{.Leechers}}</td>
      <td class="num">{{if gt .Next 0}}{{dur .Next}}{{else}}—{{end}}</td>
      <td><form method="post" action="/ui/trackers"><input type="hidden" name="hash" value="{{$.Hash}}"><input type="hidden" name="tab" value="trackers"><input type="hidden" name="op" value="remove"><input type="hidden" name="url" value="{{.URL}}"><button type="submit" class="ghost icon sm" aria-label="Remove this tracker" title="Remove this tracker"><svg class="i"><use href="#i-trash"/></svg></button></form></td></tr>
    {{end}}
    </tbody>
  </table>
  {{else}}<p class="muted">No trackers.</p>{{end}}
  <form class="form-grid" method="post" action="/ui/trackers">
    <input type="hidden" name="hash" value="{{.Hash}}"><input type="hidden" name="tab" value="trackers">
    <label class="wide">Add trackers (one per line)<textarea name="urls" rows="3" placeholder="https://tracker.example/announce" title="Tracker announce URLs to add, one per line"></textarea></label>
    <div><button type="submit" class="sm" title="Add trackers to this torrent">Add trackers</button></div>
  </form>
{{else if eq .Tab "pieces"}}
  {{if .Pieces}}
  <p class="muted"><b>{{.PiecesHave}}/{{.PiecesTotal}}</b> <span>pieces downloaded. Green: have, yellow: downloading, grey: missing, dimmed: skipped.</span></p>
  <div class="piece-map" role="img" aria-label="Piece map">
    {{range .Pieces}}<span class="piece-run piece-{{if eq .State "have"}}have{{else if eq .State "downloading"}}down{{else if eq .State "skipped"}}skip{{else}}missing{{end}}" style="width:{{.Pct}}%" title="{{if eq .State "have"}}have{{else if eq .State "downloading"}}downloading{{else if eq .State "skipped"}}skipped{{else}}missing{{end}}"></span>{{end}}
  </div>
  {{else}}<p class="muted">Piece map is not available yet (metadata missing).</p>{{end}}
{{end}}
</div>
</div>
{{end}}
