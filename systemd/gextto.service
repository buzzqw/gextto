[Unit]
Description=Gextto (gextto) media acquisition and archiving daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gextto
Group=gextto
# Optional secrets (GEXTTO_API_TOKEN, ...) kept out of the world-readable unit.
EnvironmentFile=-/etc/gextto/gextto.env
Environment=GEXTTO_DATA_DIR=/var/lib/gextto
Environment=GEXTTO_LISTEN=0.0.0.0:5000
Environment=GEXTTO_ENGINE_LISTEN=127.0.0.1:8889
Environment=GEXTTO_LOG=info
WorkingDirectory=/var/lib/gextto
ExecStart=/opt/gextto/gexttod
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# The embedded libtorrent and the archive paths may live on NFS/NAS mounts.
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
